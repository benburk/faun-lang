# What the world hands a program, and the one thing it hands every machine.
#
# A program works out what it can before it runs, so everything in the other
# examples is known and what a target sees is the answer. Nothing here is:
# the count came from outside, so the arithmetic below is left to run, and
# what a target is handed is the program rather than its answer.
#
# Every machine answers it differently. Linux leaves it on the stack it
# starts a program on, WASI has a call that reports it, and the simulator
# has a hook. None of that is written here, and none of it is barb's.

type Nat Zero Succ(Nat)
type Bool False True

less_than(Zero Zero) -> False
less_than(Zero Succ(b)) -> True
less_than(Succ(a) Zero) -> False
less_than(Succ(a) Succ(b)) -> less_than(a b)

bounded!(h True n) -> n
bounded!(h False n) -> exit!(h Zero)

add(a Zero) -> a
add(a Succ(k)) -> Succ(add(a k))

main!(h) ->
  count = argc!(h)
  # Keep only counts below two, before arithmetic can widen them.
  n = bounded!(h less_than(count Succ(Succ(Zero))) count)
  exit!(h add(add(n n) add(n n)))
