# A type whose constructors carry nothing is a tag.
#
# `False` and `True` say which one they are and nothing else, so a value of
# one is which: a word holding the tag, and matching it asks which rather
# than taking anything apart. None of that is written here. `Bool` is a type
# a program declares like any other, and the tier below reads the shape off
# the declaration, as it reads a number off `Zero` and `Succ`.

type Nat Zero Succ(Nat)
type Bool False True

not(False) -> True
not(True) -> False

and(True b) -> b
and(False b) -> False

or(False b) -> b
or(True b) -> True

is_zero(Zero) -> True
is_zero(Succ(k)) -> False

# Both answers are worked out before the choice is made, which is what you
# want where both are cheap and already in hand. It is not a spelling of a
# match: an arm a match never takes is never entered, and an argument here
# always is.
select(True t f) -> t
select(False t f) -> f

main!(h) ->
  four = Succ(Succ(Succ(Succ(Zero))))
  held = and(not(False) or(False is_zero(opaque(Zero))))
  exit!(h select(held four Zero))
