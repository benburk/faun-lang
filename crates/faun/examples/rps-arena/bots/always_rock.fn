# The stateless bot: whatever happened, Rock.

export {AlwaysRock}

import throw {Throw.*}

AlwaysRock : [AlwaysRock].(
  start : AlwaysRock
  start = AlwaysRock

  name : AlwaysRock -> Str
  name(_) -> "always_rock"

  open : AlwaysRock -> (Throw, AlwaysRock)
  open(bot) -> (Rock, bot)

  answer : (AlwaysRock, Throw) -> (Throw, AlwaysRock)
  answer(bot, _) -> (Rock, bot)
)
