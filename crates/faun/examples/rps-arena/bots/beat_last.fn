# Throws whatever would have beaten the opponent's last throw, and opens
# with Rock. The only bot whose opener differs from its answer.

export {BeatLast}

import throw {Throw.*}

BeatLast : [BeatLast].(
  start : BeatLast
  start = BeatLast

  name : BeatLast -> Str
  name(_) -> "beat_last"

  open : BeatLast -> (Throw, BeatLast)
  open(bot) -> (Rock, bot)

  answer : (BeatLast, Throw) -> (Throw, BeatLast)
  answer(bot, last) -> (last.counter(), bot)
)
