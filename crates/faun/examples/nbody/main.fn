# The orbits of the Jovian planets under a symplectic integrator, after the
# benchmarks-game program of the same name, as Ori's `benchmarks/nbody.ori`
# writes it.
#
# This is the floating-point benchmark: a small fixed set of records of `F64`
# stepped many times, with nothing allocated per step but the records
# themselves. It measures `F64` arithmetic and `sqrt`, record rebuilding, and
# the small folds over a five-element list.
#
# The first argument is the number of steps. The two lines printed are the
# system's energy before and after stepping, to nine decimal places; the game
# accepts an answer within 1.0e-8 of its reference.

import std.host {Host}

Vec3 : {x: F64, y: F64, z: F64}.(
  of : (F64, F64, F64) -> Vec3
  of(x, y, z) -> Vec3({x, y, z})

  zero : Vec3
  zero() -> of(0.0, 0.0, 0.0)

  add : (Vec3, Vec3) -> Vec3
  add(Vec3({x, y, z}), Vec3({x: u, y: v, z: w})) -> of(x + u, y + v, z + w)

  sub : (Vec3, Vec3) -> Vec3
  sub(Vec3({x, y, z}), Vec3({x: u, y: v, z: w})) -> of(x - u, y - v, z - w)

  # `v` scaled by `k`. A named method rather than `*`, which is spelled only
  # between two operands of one type.
  scale : (Vec3, F64) -> Vec3
  scale(Vec3({x, y, z}), k) -> of(x * k, y * k, z * k)

  dot : (Vec3, Vec3) -> F64
  dot(Vec3({x, y, z}), Vec3({x: u, y: v, z: w})) -> x * u + y * v + z * w

  norm : Vec3 -> F64
  norm(v) -> dot(v, v).sqrt()
)

Body = {pos: Vec3, vel: Vec3, mass: F64}

solar_mass : F64
solar_mass() -> 4.0 * F64.pi() * F64.pi()

days_per_year : F64
days_per_year() -> 365.24

bodies : List(Body)
bodies() ->
  [
    {pos: Vec3.zero(), vel: Vec3.zero(), mass: solar_mass()}, # Sun
    { # Jupiter
      pos: Vec3.of(4.84143144246472090e+00, -1.16032004402742839e+00, -1.03622044471123109e-01),
      vel: Vec3.of(1.66007664274403694e-03, 7.69901118419740425e-03, -6.90460016972063023e-05).scale(days_per_year()),
      mass: 9.54791938424326609e-04 * solar_mass(),
    },
    { # Saturn
      pos: Vec3.of(8.34336671824457987e+00, 4.12479856412430479e+00, -4.03523417114321381e-01),
      vel: Vec3.of(-2.76742510726862411e-03, 4.99852801234917238e-03, 2.30417297573763929e-05).scale(days_per_year()),
      mass: 2.85885980666130812e-04 * solar_mass(),
    },
    { # Uranus
      pos: Vec3.of(1.28943695621391310e+01, -1.51111514016986312e+01, -2.23307578892655734e-01),
      vel: Vec3.of(2.96460137564761618e-03, 2.37847173959480950e-03, -2.96589568540237556e-05).scale(days_per_year()),
      mass: 4.36624404335156298e-05 * solar_mass(),
    },
    { # Neptune
      pos: Vec3.of(1.53796971148509165e+01, -2.59193146099879641e+01, 1.79258772950371181e-01),
      vel: Vec3.of(2.68067772490389322e-03, 1.62824170038242295e-03, -9.51592254519715870e-05).scale(days_per_year()),
      mass: 5.15138902046611451e-05 * solar_mass(),
    },
  ]

# The sun, first in the list, set moving so the system's total momentum is
# zero: it takes the opposite of each planet's momentum, in its own mass.
offset_momentum : List(Body) -> List(Body)
offset_momentum([]) -> []
offset_momentum([sun, *planets]) ->
  velocity = planets.fold(Vec3.zero(), |v, body| v - body.vel.scale(body.mass / sun.mass))
  [{vel: velocity, *sun}, *planets]

system : List(Body)
system() -> offset_momentum(bodies())

# The head and one other body after their mutual pull, the pair's factor
# computed once and shared between them, as the game's programs do.
pair : (Body, Body, F64) -> (Body, Body)
pair(b, other, dt) ->
  d = b.pos - other.pos
  d2 = d.dot(d)
  mag = dt / (d2 * d2.sqrt())
  (
    {vel: b.vel - d.scale(other.mass * mag), *b},
    {vel: other.vel + d.scale(b.mass * mag), *other},
  )

# The head after pulling on each of `others` and being pulled by it, and
# each of them after: Ori's `map_accum` over the pair.
pull : (Body, List(Body), F64) -> (Body, List(Body))
pull(body, [], _) -> (body, [])
pull(body, [other, *rest], dt) ->
  (pulled, moved) = pair(body, other, dt)
  (last, others) = pull(pulled, rest, dt)
  (last, [moved, *others])

# Every velocity after every pair has pulled on each other for `dt`: the head
# is paired with each body after it, carrying its own updates along, and the
# rest then kick each other.
kick : (List(Body), F64) -> List(Body)
kick(bodies, dt) -> kicked(bodies, bodies.len(), dt)

# `pull` hands back as many bodies as it took, which nothing here shows, so
# the walk counts them down as it goes: the `fuel` Faun's totality gate asks
# of a recursion on something other than a part of what it was handed.
kicked : (List(Body), Nat, F64) -> List(Body)
kicked([body, *rest], Succ(fuel), dt) ->
  (pulled, others) = pull(body, rest, dt)
  [pulled, *kicked(others, fuel, dt)]
kicked(bodies, _, _) -> bodies

advance : (List(Body), F64) -> List(Body)
advance(bodies, dt) -> kick(bodies, dt).map(|body| {pos: body.pos + body.vel.scale(dt), *body})

steps : (List(Body), Nat) -> List(Body)
steps(bodies, n) -> n.times(bodies, |system| advance(system, 0.01))

# Kinetic energy of each body, less the potential energy of each pair.
energy : List(Body) -> F64
energy([]) -> 0.0
energy([body, *rest]) ->
  kinetic = 0.5 * body.mass * body.vel.dot(body.vel)
  potential = rest.fold(0.0, |e, other| e - body.mass * other.mass / (body.pos - other.pos).norm())
  kinetic + potential + energy(rest)

app : {args: List(Str)} -> Result(Str, [OutOfBounds, Malformed])
app(input) ->
  n = Nat.from_str(input.args.get(1)?)?
  Ok("${energy(system()).to_fixed(9)}\n${energy(steps(system(), n)).to_fixed(9)}")

expect energy(system()).to_fixed(9) == "-0.169075164"
expect energy(steps(system(), 1)).to_fixed(9) == "-0.169074954"
expect energy(steps(system(), 10)).to_fixed(9) == "-0.169073022"

main! : Host -> []
main!(host) -> host.run!(app)
