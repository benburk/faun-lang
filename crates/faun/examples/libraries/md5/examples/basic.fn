# Native smoke entry for MD5's block loop and U64 length encoding.

package {
  md5: "../src/md5"
}

import md5 {md5_hash}

app : {stdin: List(U8), *} -> Str
app(input) -> Str.hex(md5_hash(input.stdin))

expect Str.hex(md5_hash("abc".to_utf8())) == "900150983cd24fb0d6963f7d28e17f72"

main!(host) -> host.run_stdin!(app)
