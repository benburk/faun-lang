# MD5 (RFC 1321), implemented over the standard modular `U32`. Hexadecimal
# constants preserve the spelling used by the specification; callers see only
# byte lists and hex text.

package {}

exports {md5_hash, to_hex}

round_table : List((U32, Nat))
round_table() -> [
  # Round 1: shifts 7, 12, 17, 22.
  (0xd76aa478, 7), (0xe8c7b756, 12), (0x242070db, 17), (0xc1bdceee, 22),
  (0xf57c0faf, 7), (0x4787c62a, 12), (0xa8304613, 17), (0xfd469501, 22),
  (0x698098d8, 7), (0x8b44f7af, 12), (0xffff5bb1, 17), (0x895cd7be, 22),
  (0x6b901122, 7), (0xfd987193, 12), (0xa679438e, 17), (0x49b40821, 22),

  # Round 2: shifts 5, 9, 14, 20.
  (0xf61e2562, 5), (0xc040b340, 9), (0x265e5a51, 14), (0xe9b6c7aa, 20),
  (0xd62f105d, 5), (0x02441453, 9), (0xd8a1e681, 14), (0xe7d3fbc8, 20),
  (0x21e1cde6, 5), (0xc33707d6, 9), (0xf4d50d87, 14), (0x455a14ed, 20),
  (0xa9e3e905, 5), (0xfcefa3f8, 9), (0x676f02d9, 14), (0x8d2a4c8a, 20),

  # Round 3: shifts 4, 11, 16, 23.
  (0xfffa3942, 4), (0x8771f681, 11), (0x6d9d6122, 16), (0xfde5380c, 23),
  (0xa4beea44, 4), (0x4bdecfa9, 11), (0xf6bb4b60, 16), (0xbebfbc70, 23),
  (0x289b7ec6, 4), (0xeaa127fa, 11), (0xd4ef3085, 16), (0x04881d05, 23),
  (0xd9d4d039, 4), (0xe6db99e5, 11), (0x1fa27cf8, 16), (0xc4ac5665, 23),

  # Round 4: shifts 6, 10, 15, 21.
  (0xf4292244, 6), (0x432aff97, 10), (0xab9423a7, 15), (0xfc93a039, 21),
  (0x655b59c3, 6), (0x8f0ccc92, 10), (0xffeff47d, 15), (0x85845dd1, 21),
  (0x6fa87e4f, 6), (0xfe2ce6e0, 10), (0xa3014314, 15), (0x4e0811a1, 21),
  (0xf7537e82, 6), (0xbd3af235, 10), (0x2ad7d2bb, 15), (0xeb86d391, 21)
]

pad : List(U8) -> List(U8)
pad(message) ->
  length = message.len()
  body = message.append(0x80)
    .extend(List.repeat(0, padding_zeroes(length.add(1).mod(64))))
  body.extend(length_le_bytes(U64.of_nat(length.mul(8))))

# Zeroes to the next 56-mod-64 boundary, wrapping past it when the length
# byte already crossed.
padding_zeroes : Nat -> Nat
padding_zeroes(remainder) if remainder < 56 -> 56.sub(remainder)
padding_zeroes(remainder) -> 120.sub(remainder)

# The stream forms of the byte quartets: MD5 serialises words into a byte
# list, so the flattening choice lives here, beside the encoding it serves.
word_le_bytes : U32 -> List(U8)
word_le_bytes(word) ->
  (a, b, c, d) = word.le_bytes()
  [a, b, c, d]

length_le_bytes : U64 -> List(U8)
length_le_bytes(word) ->
  (a, b, c, d, e, f, g, h) = word.le_bytes()
  [a, b, c, d, e, f, g, h]

words_le : List(U8) -> List(U32)
words_le([a, b, c, d, *rest]) -> words_le(rest).prepend(U32.of_le_bytes(a, b, c, d))
words_le(_) -> []

round_fg : (U32, U32, U32, Nat) -> (U32, Nat)
round_fg(b, c, d, index) if index < 16 ->
  (b.and(c).or(b.bit_not().and(d)), index)
round_fg(b, c, d, index) if index < 32 ->
  (d.and(b).or(d.bit_not().and(c)), index.mul(5).add(1).mod(16))
round_fg(b, c, d, index) if index < 48 ->
  (b.xor(c).xor(d), index.mul(3).add(5).mod(16))
round_fg(b, c, d, index) ->
  (c.xor(b.or(d.bit_not())), index.mul(7).mod(16))

rounds : (List((U32, Nat)), List(U32), Nat, (U32, U32, U32, U32)) -> (U32, U32, U32, U32)
rounds([], _, _, state) -> state
rounds([(constant, shift), *rest], message, index, state) ->
  (a, b, c, d) = state
  (f, message_index) = round_fg(b, c, d, index)
  temp = a.add(f).add(constant).add(message.get(message_index).ok_or(0))
  next_b = b.add(temp.rotate_left(shift))
  rounds(rest, message, index.add(1), (d, next_b, b, c))

process_block : ((U32, U32, U32, U32), List(U32)) -> (U32, U32, U32, U32)
process_block(state, message) ->
  (a0, b0, c0, d0) = state
  (a, b, c, d) = rounds(round_table(), message, 0, state)
  (a0.add(a), b0.add(b), c0.add(c), d0.add(d))

md5_state : List(U8) -> Result((U32, U32, U32, U32), [IncompleteBlock])
md5_state(input) ->
  initial = (0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476)
  # Padding should make the word count a multiple of sixteen. `blocks` exposes
  # that obligation instead of silently treating a short suffix as a block.
  whole_blocks(words_le(pad(input)).blocks(16), initial)

whole_blocks : ({complete: List(List(U32)), remainder: List(U32)}, (U32, U32, U32, U32)) -> Result((U32, U32, U32, U32), [IncompleteBlock])
whole_blocks(parts, initial) if parts.remainder.is_empty() ->
  Ok(parts.complete.fold(initial, process_block))
whole_blocks(_, _) -> Err(IncompleteBlock)

md5_hash : List(U8) -> Result(List(U8), [IncompleteBlock])
md5_hash(input) ->
  (a, b, c, d) = md5_state(input)?
  Ok([a, b, c, d].flat_map(word_le_bytes))

hex_digit : Nat -> U8
hex_digit(digit) if digit < 10 -> U8.of_nat(digit.add('0'))
hex_digit(digit) -> U8.of_nat(digit.sub(10).add('a'))

hex_bytes : List(U8) -> List(U8)
hex_bytes(bytes) -> bytes.flat_map(hex_pair)

hex_pair : U8 -> List(U8)
hex_pair(byte) ->
  value = byte.to_nat()
  [hex_digit(value.div(16)), hex_digit(value.mod(16))]

to_hex : List(U8) -> Str
to_hex(bytes) -> Str.from_utf8(hex_bytes(bytes)).ok_or("")

# RFC 1321 vectors, including a message that crosses the 56-byte padding
# boundary and therefore occupies two blocks.
expect md5_hash("".to_utf8()).map_ok(to_hex) == Ok("d41d8cd98f00b204e9800998ecf8427e")
expect md5_hash("abc".to_utf8()).map_ok(to_hex) == Ok("900150983cd24fb0d6963f7d28e17f72")
expect md5_hash("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789".to_utf8())
  .map_ok(to_hex) == Ok("d174ab98d277d9f5a5611c2c9f419d9f")
