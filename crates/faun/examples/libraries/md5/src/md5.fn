# MD5 (RFC 1321) over the standard modular `U32`, a 64-byte block at a
# time.

package {}

export {Md5, md5_hash}

State = (U32, U32, U32, U32)

# The MD5 digest of `message`: its 16 bytes, the four state words each
# least significant byte first, as RFC 1321 writes them. `Str.hex` shows
# them as the usual 32 hex digits. MD5 is broken for security; use it only
# as a checksum.
md5_hash : List(U8) -> List(U8)
md5_hash(message) -> Md5.empty.update(message).digest()

# Incremental hashing keeps the chaining state and up to 63 pending bytes.
Md5 : (State, List(U8), Nat).(
  empty : Md5
  empty = (
    initial = (0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476)
    Md5((initial, [], 0))
  )

  update : (Md5, List(U8)) -> Md5
  update(Md5((state, pending, length)), chunk) -> (
    (next, tail) = update_blocks(state, pending, chunk)
    Md5((next, tail, length + chunk.len()))
  )

  digest : Md5 -> List(U8)
  digest(Md5((state, tail, length))) -> (
    (done, _) = blocks(state, padded(tail, length))
    (a, b, c, d) = done
    [a, b, c, d].flat_map(word_bytes)
  )
)

# Fill a pending block from the front of the new chunk. The rest of the
# chunk can be read directly, including when it arrived in a short read.
update_blocks : (State, List(U8), List(U8)) -> (State, List(U8))
update_blocks(state, [], chunk) -> blocks(state, chunk)
update_blocks(state, pending, chunk) -> (
  needed = 64 - pending.len()
  if chunk.len() < needed then (state, pending.concat(chunk))
  else (
    first = pending.concat(chunk.take(needed))
    blocks(compress(state, first), chunk.drop(needed))
  )
)

# Walk complete blocks through slices. Keep the final partial block for
# the next update or for padding at the end of the message.
blocks : (State, List(U8)) -> (State, List(U8))
blocks(state, bytes) if bytes.len() >= 64 ->
  blocks(compress(state, bytes.take(64)), bytes.drop(64))
blocks(state, []) -> (state, [])
blocks(state, tail) -> (state, tail)

word_bytes : U32 -> List(U8)
word_bytes(word) -> (
  (a, b, c, d) = word.le_bytes()
  [a, b, c, d]
)

# A one bit, zeroes, and the length in bits, to a whole number of blocks.
padded : (List(U8), Nat) -> List(U8)
padded(tail, length) -> (
  zeroes = (119 - length % 64) % 64
  tail.append(0x80)
    .concat(List.repeat(0, zeroes))
    .concat(length_bytes(U64.of_nat(length * 8)))
)

length_bytes : U64 -> List(U8)
length_bytes(bits) -> (
  (a, b, c, d, e, f, g, h) = bits.le_bytes()
  [a, b, c, d, e, f, g, h]
)

compress : (State, List(U8)) -> State
compress(start is (a, b, c, d), block) -> (
  (a2, b2, c2, d2) = steps.enumerate().fold(start, |state, step| round(block, state, step))
  (a + a2, b + b2, c + c2, d + d2)
)

word_at : (List(U8), Nat) -> U32
word_at(block, i) -> (
  block.drop(4 * i) is [a, b, c, d, *_] else return 0
  U32.of_le_bytes(a, b, c, d)
)

round : (List(U8), State, (Nat, (U32, Nat))) -> State
round(block, (a, b, c, d), (i, (k, s))) -> (
  (f, g) = mix(b, c, d, i)
  (d, b + (a + f + k + word_at(block, g)).rotate_left(s), b, c)
)

# Each round's function of b, c and d, and which word of the block it adds.
mix : (U32, U32, U32, Nat) -> (U32, Nat)
mix(b, c, d, i) if i < 16 -> (b & c | !b & d, i)
mix(b, c, d, i) if i < 32 -> (d & b | !d & c, (5 * i + 1) % 16)
mix(b, c, d, i) if i < 48 -> (b ^ c ^ d, (3 * i + 5) % 16)
mix(b, c, d, i) -> (c ^ (b | !d), 7 * i % 16)

# Each step's constant and how far it rotates.
steps : List((U32, Nat))
steps = [
  (0xd76aa478, 7), (0xe8c7b756, 12), (0x242070db, 17), (0xc1bdceee, 22),
  (0xf57c0faf, 7), (0x4787c62a, 12), (0xa8304613, 17), (0xfd469501, 22),
  (0x698098d8, 7), (0x8b44f7af, 12), (0xffff5bb1, 17), (0x895cd7be, 22),
  (0x6b901122, 7), (0xfd987193, 12), (0xa679438e, 17), (0x49b40821, 22),

  (0xf61e2562, 5), (0xc040b340, 9), (0x265e5a51, 14), (0xe9b6c7aa, 20),
  (0xd62f105d, 5), (0x02441453, 9), (0xd8a1e681, 14), (0xe7d3fbc8, 20),
  (0x21e1cde6, 5), (0xc33707d6, 9), (0xf4d50d87, 14), (0x455a14ed, 20),
  (0xa9e3e905, 5), (0xfcefa3f8, 9), (0x676f02d9, 14), (0x8d2a4c8a, 20),

  (0xfffa3942, 4), (0x8771f681, 11), (0x6d9d6122, 16), (0xfde5380c, 23),
  (0xa4beea44, 4), (0x4bdecfa9, 11), (0xf6bb4b60, 16), (0xbebfbc70, 23),
  (0x289b7ec6, 4), (0xeaa127fa, 11), (0xd4ef3085, 16), (0x04881d05, 23),
  (0xd9d4d039, 4), (0xe6db99e5, 11), (0x1fa27cf8, 16), (0xc4ac5665, 23),

  (0xf4292244, 6), (0x432aff97, 10), (0xab9423a7, 15), (0xfc93a039, 21),
  (0x655b59c3, 6), (0x8f0ccc92, 10), (0xffeff47d, 15), (0x85845dd1, 21),
  (0x6fa87e4f, 6), (0xfe2ce6e0, 10), (0xa3014314, 15), (0x4e0811a1, 21),
  (0xf7537e82, 6), (0xbd3af235, 10), (0x2ad7d2bb, 15), (0xeb86d391, 21),
]

# RFC 1321 vectors, including a message that crosses the 56-byte padding
# boundary and so takes two blocks.
expect Str.hex(md5_hash("".to_utf8())) == "d41d8cd98f00b204e9800998ecf8427e"
expect Str.hex(md5_hash("abc".to_utf8())) == "900150983cd24fb0d6963f7d28e17f72"
expect Str.hex(md5_hash("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789".to_utf8()))
  == "d174ab98d277d9f5a5611c2c9f419d9f"

# Split updates may end anywhere in a block, and a digest can be taken
# while the same prefix is still in use.
expect (
  prefix = Md5.empty.update("a".to_utf8())
  Str.hex(prefix.digest()) == "0cc175b9c0f1b6a831c399e269772661"
    & Str.hex(prefix.update([]).update("bc".to_utf8()).digest()) == "900150983cd24fb0d6963f7d28e17f72"
)

expect (
  input = List.range(257).map(U8.of_nat)
  expected = md5_hash(input)
  [0, 1, 55, 56, 63, 64, 65, 127, 128, 129, 256, 257].all(|n|
    Md5.empty.update(input.take(n)).update(input.drop(n)).digest() == expected)
)
