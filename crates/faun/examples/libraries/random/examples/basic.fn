# Native smoke entry for the PCG generator: the 64-bit state advances in raw
# machine words, and each drawn `U32` crosses back as one tagged immediate.
# The seed arrives on stdin so constant folding cannot stand in for the
# compiled arithmetic.

package {
  random: "../src/random"
}

import random {Random}

draw : (Random, Nat) -> List(U32)
draw(state, 0) -> []
draw(state, Succ(rest)) -> (
  (value, next_state) = state.next()
  draw(next_state, rest).prepend(value)
)

app : {stdin: List(U8), *} -> Result(Str, _)
app(input) -> (
  stdin = Str.from_utf8(input.stdin)?
  Nat.from_str(stdin.trim()).map_ok(report_draws)
)

report_draws : Nat -> Str
report_draws(seed) -> draw(Random.seed(seed), 6).map(U32.to_str).join("\n")

# The same fixed vector random.ori pins, seen through the decimal printer.
expect draw(Random.seed(42), 6).map(U32.to_str) == [
  "3270867926",
  "1795671209",
  "1924641435",
  "1143034755",
  "4121910957",
  "1757328946"
]

main!(host) -> host.run_stdin!(app)
