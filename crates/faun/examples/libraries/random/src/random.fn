# PCG-XSH-RR: a small deterministic generator with one private 64-bit state and
# a `U32` output. It is suitable for simulations, tests, and procedural data;
# it is not cryptographically secure.
#
# The private state is a standard wrapping `U64`; callers create a generator
# only through `seed` and thread the returned state through `next`.

package {}

export {Random}

Random : U64.(
  # One advance of `increment + value`: advancing from zero is `0·m + i = i`,
  # so PCG's usual seed-then-advance-twice collapses to the constant already
  # written below. `*` and `+` on a `U64` wrap modulo 2^64 and are worked out
  # in machine words wherever they appear, as the 64-bit state is held in
  # them, across calls too.
  seed : Nat -> Random
  seed(value) -> Random(
    (U64.of_nat(value) + 0x14057b7ef767814f) * 0x5851f42d4c957f2d + 0x14057b7ef767814f
  )

  # One draw: the output is the state's high bits xor-shifted and rotated by
  # its top five, and the new state is one more multiply-and-add.
  next : Random -> (U32, Random)
  next(Random(state)) -> (
    xorshifted = (state.shift_right(18) ^ state).shift_right(27)
    rotation = state.shift_right(59).to_nat()
    value = xorshifted.to_u32().rotate_right(rotation)
    (value, Random(state * 0x5851f42d4c957f2d + 0x14057b7ef767814f))
  )

  # A uniformly chosen element of `xs`, paired with the state after the draw
  # that chose it, or `Err(Empty)` when `xs` holds no element to choose. The
  # draw is one `next` reduced `mod xs.len()`, sharing the bias `shuffle`
  # documents, followed by one indexed read. No permutation stands behind
  # it: one element out of `n` costs one draw, not `n`.
  #
  # An empty list has no index at all, so what the reduction answers at a
  # zero length never reaches the caller: every index misses, and that miss
  # names the empty list.
  choice : (Random, List(a)) -> Result((a, Random), [Empty])
  choice(state, xs) -> (
    (value, after) = next(state)
    picked = xs.get(value.to_nat() % xs.len()).err_as(Empty)?
    Ok((picked, after))
  )

  # Fisher–Yates: a uniform permutation of `xs`, and the generator state
  # after the draws that chose it. The walk runs from the end: with `n`
  # elements still unplaced, the last of them swaps with a uniform position
  # in `0..n`, and the walk continues on the `n - 1` before it. The draw is
  # `mod n` of a 32-bit word, whose bias is below one part in eight million
  # at any length the buffer representation supports.
  shuffle : (Random, List(a)) -> (List(a), Random)
  shuffle(state, xs) -> walk(xs, xs.len(), state)
)

# The swaps land in place on the list threaded through the recursion; the
# count of unplaced elements is the descent.
walk : (List(a), Nat, Random) -> (List(a), Random)
walk(xs, 0, state) -> (xs, state)
walk(xs, count is Succ(m), state) -> (
  (value, next) = state.next()
  walk(xs.exchange(m, value.to_nat() % count).ok_or(xs), m, next)
)

# Drawing with replacement: `count` choices from `xs`, each from the state
# the one before it left. A miss reports the empty list once for the whole
# run, since a list with nothing to choose has nothing to choose twice.
draws : (Random, List(a), Nat) -> Result(List(a), [Empty])
draws(state, xs, 0) -> Ok([])
draws(state, xs, Succ(rest)) -> (
  (picked, after) = state.choice(xs)?
  draws(after, xs, rest).map_ok(|rest_drawn| rest_drawn.prepend(picked))
)

random_take : (Random, Nat) -> List(U32)
random_take(state, 0) -> []
random_take(state, Succ(rest)) -> (
  (value, next_state) = state.next()
  random_take(next_state, rest).prepend(value)
)

# A permutation this short is still sensitive to every draw before it, so a
# fixed vector pins the placement order and the `mod i+1` convention together.
expect (
  (shuffled, after) = Random.seed(42).shuffle([1, 2, 3, 4, 5, 6, 7, 8])
  shuffled == [3, 5, 6, 2, 1, 8, 4, 7]
)

# A single element still draws once — `mod 1` places it at zero — so the
# returned state has advanced.
expect (
  (shuffled, after) = Random.seed(7).shuffle([9])
  shuffled == [9]
)

# A fixed vector pins the state transition, output permutation, and seeding
# convention rather than merely checking that two runs happen to agree.
expect random_take(Random.seed(42), 6) == [
  0xc2f57bd6,
  0x6b07c4a9,
  0x72b7b29b,
  0x44215383,
  0xf5af5ead,
  0x68beb632
]

# The same three words `random_take` pins, reduced `mod 5`: 3270867926,
# 1795671209, and 1924641435 land on indices 1, 4, and 0.
expect draws(Random.seed(42), [10, 20, 30, 40, 50], 3) == Ok([20, 50, 10])

# A one-element list answers with that element at every draw, and an empty
# one answers with the miss instead of a value.
expect draws(Random.seed(7), [9], 4) == Ok([9, 9, 9, 9])
expect Random.seed(7).choice(List.range(0)).is_err()

# A choice is always a member: 64 draws over a four-element list stay inside
# it, whatever the reduction does to the word.
expect draws(Random.seed(3), [2, 4, 6, 8], 64).ok_or([]).all(|x| [2, 4, 6, 8].contains(x))
