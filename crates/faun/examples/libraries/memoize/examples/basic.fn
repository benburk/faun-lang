package {
  memoize: "../src/memoize"
}

import memoize {Memo}

Numbers = Memo(Nat, Nat)

fresh : (Numbers, Nat) -> (Nat, Numbers)
fresh(memo, n) -> (n + 1, memo)

stale : (Numbers, Nat) -> (Nat, Numbers)
stale(memo, n) -> (n + 100, memo)

# A miss computes and records; a hit returns the recorded value without using
# the second computation's answer.
expect
  (first, memo) = Memo.empty().memoize(4, 4, fresh)
  (second, _) = memo.memoize(4, 4, stale)
  first == 5 & second == 5

# A statically supplied computation may recurse back through the memoizer. The
# totality checker follows the list-field descent through the specialised
# higher-order adapters rather than losing it at their generic context.
memo_len : List(Nat) -> Nat
memo_len(items) ->
  (length, _) = memo_walk(items, Memo.empty())
  length

memo_walk : (List(Nat), Numbers) -> (Nat, Numbers)
memo_walk([], memo) -> (0, memo)
memo_walk([_, *rest], memo) -> memo.memoize(rest.len() + 1, rest, memo_step)

memo_step : (Numbers, List(Nat)) -> (Nat, Numbers)
memo_step(memo, rest) ->
  (length, next) = memo_walk(rest, memo)
  (length + 1, next)

expect memo_len([]) == 0
expect memo_len([4, 8, 15, 16, 23, 42]) == 6
