# JSON: text parsed into a `Json` tree and a tree rendered as text, and a
# tree decoded into typed values or built from them.
#
# Parsing is exact. An integer is an `Int` of any size; a number with a
# fraction or an exponent is the nearest `F64`; a string's escapes,
# surrogate pairs included, decode to UTF-8; and an error says the line and
# column it stopped at.
#
# Decoding and encoding are written out, one line a member. A type's
# `from_json` reads its members by name through `Fields`, each required, with
# a default, or optional, and refuses members it did not read; its `to_json`
# is an object built from a list of pairs. Nothing is derived. A type with
# its own `from_json` is found by `fields.decode(name)` wherever a member of
# that type is read, so codecs compose without naming each other.

package {}

export {
  Json.*, ParseError, Problem.*, DecodeError.*, Decode.*, Field, Fields
}

# The shapes of RFC 8259. A number is an `Int` where it has neither a
# fraction nor an exponent, so integers keep every digit, and a `Float`
# where it has either. A capitalised word means whatever its position's
# namespace says, so `Bool` the constructor and `Bool` the type never collide.
Json : [
  Null,
  Bool(Bool),
  Int(Int),
  Float(F64),
  String(Str),
  Array(List(Json)),
  Object(List((Str, Json)))
].(
  # Text to a tree, as `Nat.from_str` reads a number: the whole text is one
  # value, with whitespace around it.
  from_str : Str -> Result(Json, ParseError)
  from_str(text) -> (
    bytes = text.to_utf8()
    parsed = parse_value(bytes).and_then(|(value, rest)| parsed_all(value, rest))
    parsed.map_err(|(problem, rest)| located(bytes, problem, rest))
  )

  # The tree as compact text, every member and element in order. A `Float`
  # is written as `F64.to_str` writes it, which reads back as the same
  # number; one that is not finite has no JSON spelling and is `null`.
  to_str : Json -> Str
  to_str(Null) -> "null"
  to_str(Bool(False)) -> "false"
  to_str(Bool(True)) -> "true"
  to_str(Int(n)) -> n.to_str()
  to_str(Float(x)) if x.is_finite() -> x.to_str()
  to_str(Float(_)) -> "null"
  to_str(String(text)) -> render_string(text)
  to_str(Array(values)) -> "[${values.map(|value| value.to_str()).join(",")}]"
  to_str(Object(members)) -> "{${members.map(render_member).join(",")}}"

  # The tree as text for people: each element and member on a line of its
  # own, indented two spaces a level. An empty array or object stays `[]`
  # or `{}`.
  pretty : Json -> Str
  pretty(value) -> indented(value, "")

  # Reading a tree without decoding it --------------------------------------

  # An object's member named `name`, the first where there are several.
  get : (Json, Str) -> Result(Json, [Missing])
  get(Object(members), name) -> members
    .find(|(key, _)| key == name)
    .map_ok(|(_, member)| member)
    .err_as(Missing)
  get(_, _) -> Err(Missing)

  # An array's element at `index`, counting from nought.
  at : (Json, Nat) -> Result(Json, [Missing])
  at(Array(values), index) -> values.get(index).err_as(Missing)
  at(_, _) -> Err(Missing)

  # Decoding a tree ----------------------------------------------------------

  string : Json -> Decode(Str)
  string(String(text)) -> Decoded(text, [])
  string(_) -> Failed(Expected("string"))

  boolean : Json -> Decode(Bool)
  boolean(Bool(found)) -> Decoded(found, [])
  boolean(_) -> Failed(Expected("boolean"))

  int : Json -> Decode(Int)
  int(Int(n)) -> Decoded(n, [])
  int(_) -> Failed(Expected("integer"))

  nat : Json -> Decode(Nat)
  nat(Int(Pos(n))) -> Decoded(n, [])
  nat(_) -> Failed(Expected("natural number"))

  # The four widths, through each type's own `from_nat`: an integer the type
  # cannot hold is refused as the wrong kind of value.
  u8 : Json -> Decode(U8)
  u8(Int(Pos(n))) -> fitted(U8.from_nat(n), "u8")
  u8(_) -> Failed(Expected("u8"))

  u16 : Json -> Decode(U16)
  u16(Int(Pos(n))) -> fitted(U16.from_nat(n), "u16")
  u16(_) -> Failed(Expected("u16"))

  u32 : Json -> Decode(U32)
  u32(Int(Pos(n))) -> fitted(U32.from_nat(n), "u32")
  u32(_) -> Failed(Expected("u32"))

  u64 : Json -> Decode(U64)
  u64(Int(Pos(n))) -> fitted(U64.from_nat(n), "u64")
  u64(_) -> Failed(Expected("u64"))

  # Any number, an integer rounded to the nearest `F64`.
  f64 : Json -> Decode(F64)
  f64(Float(x)) -> Decoded(x, [])
  f64(Int(n)) -> Decoded(F64.of_int(n), [])
  f64(_) -> Failed(Expected("number"))

  # A string through any converter, a tag's own reader, say. The
  # converter's refusal is the decode error as it is.
  string_as : (Json, Str -> Result(a, DecodeError)) -> Decode(a)
  string_as(String(text), convert) -> accepted(convert(text))
  string_as(_, _) -> Failed(Expected("string"))

  # An array, each element by `decode`. A failure says at which index.
  array : (Json, Json -> Decode(a)) -> Decode(List(a))
  array(Array(values), decode) -> decode_values(values, decode, 0)
  array(_, _) -> Failed(Expected("array"))

  # An object used as a map, each member's value by `decode`, in the order
  # written. A name written twice is refused.
  object_of : (Json, Json -> Decode(a)) -> Decode(Map(Str, a))
  object_of(Object(members), decode) -> decode_members(members, decode, Map.empty)
  object_of(_, _) -> Failed(Expected("object"))

  # A value by `decode`, or where it is `null`, `Err(Missing)`: the row an
  # optional member answers where it is absent.
  nullable : (Json, Json -> Decode(a)) -> Decode(Result(a, [Missing]))
  nullable(Null, _) -> Decoded(Err(Missing), [])
  nullable(value, decode) -> decode(value).map(Ok)

  # Building a tree ----------------------------------------------------------

  of_str : Str -> Json
  of_str(text) -> String(text)

  of_bool : Bool -> Json
  of_bool(flag) -> Bool(flag)

  of_int : Int -> Json
  of_int(n) -> Int(n)

  of_nat : Nat -> Json
  of_nat(n) -> Int(Int.of_nat(n))

  of_u8 : U8 -> Json
  of_u8(n) -> of_nat(n.to_nat())

  of_u16 : U16 -> Json
  of_u16(n) -> of_nat(n.to_nat())

  of_u32 : U32 -> Json
  of_u32(n) -> of_nat(n.to_nat())

  of_u64 : U64 -> Json
  of_u64(n) -> of_nat(n.to_nat())

  of_f64 : F64 -> Json
  of_f64(x) -> Float(x)

  # An array, each value by `encode`.
  of_list : (List(a), a -> Json) -> Json
  of_list(values, encode) -> Array(values.map(encode))

  # An object of a map's entries, in its order, each value by `encode`.
  of_map : (Map(Str, a), a -> Json) -> Json
  of_map(entries, encode) -> Object(entries.to_list().map(|(name, value)| (name, encode(value))))

  # An object of these members, in this order.
  object : List((Str, Json)) -> Json
  object(members) -> Object(members)

  equals : (Json, Json) -> Bool
)

# Where parsing stopped and why: the line and the column, counted in
# characters, each from one.
ParseError : {problem: Problem, line: Nat, column: Nat}.(
  to_str : ParseError -> Str
  to_str(ParseError({problem, line, column})) -> "${problem} at line ${line}, column ${column}"

  equals : (ParseError, ParseError) -> Bool
)

Problem : [
  UnexpectedEnd,
  UnexpectedToken,
  InvalidString,
  InvalidEscape,
  InvalidUnicode,
  InvalidNumber,
  ExpectedColon,
  ExpectedCommaOrEnd,
  TrailingInput
].(
  to_str : Problem -> Str
  to_str(UnexpectedEnd) -> "unexpected end of JSON input"
  to_str(UnexpectedToken) -> "unexpected JSON token"
  to_str(InvalidString) -> "invalid JSON string"
  to_str(InvalidEscape) -> "invalid JSON string escape"
  to_str(InvalidUnicode) -> "invalid JSON Unicode escape"
  to_str(InvalidNumber) -> "invalid JSON number"
  to_str(ExpectedColon) -> "expected `:` after object key"
  to_str(ExpectedCommaOrEnd) -> "expected a comma or closing delimiter"
  to_str(TrailingInput) -> "unexpected input after JSON value"

  equals : (Problem, Problem) -> Bool
)

DecodeError : [
  Expected(Str),
  MissingField(Str),
  DuplicateField(Str),
  UnknownField(Str),
  OverlappingFields,
  AtField(Str, DecodeError),
  AtIndex(Nat, DecodeError),
  InvalidValue(Str)
].(
  to_str : DecodeError -> Str
  to_str(Expected(kind)) -> "expected ${kind}"
  to_str(MissingField(name)) -> "missing JSON field `${name}`"
  to_str(DuplicateField(name)) -> "JSON field `${name}` appears more than once"
  to_str(UnknownField(name)) -> "unknown JSON field `${name}`"
  to_str(OverlappingFields) -> "two decoders claimed the same JSON field"
  to_str(AtField(name, inner)) -> "at field `${name}`: ${inner}"
  to_str(AtIndex(index, inner)) -> "at array index ${index}: ${inner}"
  to_str(InvalidValue(message)) -> message

  equals : (DecodeError, DecodeError) -> Bool
)

# A decode carries the names of the object members it read. Members read by
# fields decoded separately are merged by name: one read twice is an
# overlap, and `Fields.finish` refuses any member no field read.
Decode(a) : [Decoded(a, List(Str)), Failed(DecodeError)].(
  # Two decodes as one, by `combine`; a record builder pairs a record's
  # fields this way, `Decode.sequence({name: ..., age: ...})`.
  sequence : (Decode(a), Decode(b), (a, b) -> c) -> Decode(c)
  sequence(Failed(error), _, _) -> Failed(error)
  sequence(_, Failed(error), _) -> Failed(error)
  sequence(Decoded(_, used_a), Decoded(_, used_b), _)
    if used_a.any(|name| used_b.contains(name)) ->
    Failed(OverlappingFields)
  sequence(Decoded(a, used_a), Decoded(b, used_b), combine) ->
    Decoded(combine(a, b), used_a.concat(used_b))

  map : (Decode(a), a -> b) -> Decode(b)
  map(Failed(error), _) -> Failed(error)
  map(Decoded(value, claims), convert) -> Decoded(convert(value), claims)

  result : Decode(a) -> Result(a, DecodeError)
  result(Failed(error)) -> Err(error)
  result(Decoded(value, _)) -> Ok(value)

  # A decode chosen by what an earlier one found, as a tagged union reads
  # its tag and then its fields. `context`, usually the fields, is handed
  # to `choose` with the value. The members both read are merged as
  # `sequence` merges them, so `finish` still sees every one.
  and_then : (Decode(a), c, (a, c) -> Decode(b)) -> Decode(b)
  and_then(Failed(error), _, _) -> Failed(error)
  and_then(Decoded(value, used), context, choose) -> claimed(choose(value, context), used)
)

# One member looked for: absent, found and decoded, or found and refused.
# `required`, `default` and `opt` say what an absent one means.
Field(a) : [Missing(Str), Value(Str, a), Failed(DecodeError)].(
  required : Field(a) -> Decode(a)
  required(Missing(name)) -> Decode.Failed(MissingField(name))
  required(Value(name, value)) -> Decoded(value, [name])
  required(Failed(error)) -> Decode.Failed(error)

  default : (Field(a), a) -> Decode(a)
  default(Missing(_), fallback) -> Decoded(fallback, [])
  default(Value(name, value), _) -> Decoded(value, [name])
  default(Failed(error), _) -> Decode.Failed(error)

  opt : Field(a) -> Decode(Result(a, [Missing]))
  opt(Missing(_)) -> Decoded(Err(Missing), [])
  opt(Value(name, value)) -> Decoded(Ok(value), [name])
  opt(Failed(error)) -> Decode.Failed(error)
)

# An object's members, bound once with `Fields.of` and read by name. A value
# that is not an object binds too, and every read of it fails, so a decoder
# is written the same whatever it is handed.
Fields : Result(List((Str, Json)), DecodeError).(
  of : Json -> Fields
  of(Object(members)) -> Fields(Ok(members))
  of(_) -> Fields(Err(Expected("object")))

  # `decoded`, refused where the object has a member nothing read.
  finish : (Fields, Decode(a)) -> Decode(a)
  finish(Fields(Ok(members)), decoded) -> finish_object(members, decoded, True)
  finish(Fields(Err(error)), _) -> Failed(error)

  # `decoded`, with members nothing read let pass: for input that may grow.
  finish_loose : (Fields, Decode(a)) -> Decode(a)
  finish_loose(Fields(Ok(members)), decoded) -> finish_object(members, decoded, False)
  finish_loose(Fields(Err(error)), _) -> Failed(error)

  # The member `name`, its value by `decode`.
  field : (Fields, Str, Json -> Decode(a)) -> Field(a)
  field(Fields(Ok(members)), name, decode) -> scan_field(members, name, decode)
  field(Fields(Err(error)), _, _) -> Failed(error)

  # The member `name`, by its type's own `from_json`, which the type the
  # field is read into decides.
  decode : (Fields, Str) -> Field(a) where a.from_json : Json -> Decode(a)
  decode(fields, name) -> field(fields, name, |value| a.from_json(value))

  # The member `name`, an array each element of which is read by `decode`.
  list : (Fields, Str, Json -> Decode(a)) -> Field(List(a))
  list(fields, name, decode) -> field(fields, name, |value| value.array(decode))

  string : (Fields, Str) -> Field(Str)
  string(fields, name) -> field(fields, name, Json.string)

  boolean : (Fields, Str) -> Field(Bool)
  boolean(fields, name) -> field(fields, name, Json.boolean)

  int : (Fields, Str) -> Field(Int)
  int(fields, name) -> field(fields, name, Json.int)

  nat : (Fields, Str) -> Field(Nat)
  nat(fields, name) -> field(fields, name, Json.nat)

  u8 : (Fields, Str) -> Field(U8)
  u8(fields, name) -> field(fields, name, Json.u8)

  u16 : (Fields, Str) -> Field(U16)
  u16(fields, name) -> field(fields, name, Json.u16)

  u32 : (Fields, Str) -> Field(U32)
  u32(fields, name) -> field(fields, name, Json.u32)

  u64 : (Fields, Str) -> Field(U64)
  u64(fields, name) -> field(fields, name, Json.u64)

  f64 : (Fields, Str) -> Field(F64)
  f64(fields, name) -> field(fields, name, Json.f64)
)

# Parsing ------------------------------------------------------------------

# Why parsing stopped, and the input from where it did, which says where.
Stop = (Problem, List(U8))

# The value, array and object parsers are one cycle of mutual recursion,
# each answering what it read and the input after it, so `?` is all the
# plumbing there is.
parse_value : List(U8) -> Result((Json, List(U8)), Stop)
parse_value([]) -> Err((UnexpectedEnd, []))
parse_value([x, *rest]) if is_space(x) -> parse_value(rest)
parse_value(['n', 'u', 'l', 'l', *rest]) -> Ok(parsed_json(Null, rest))
parse_value(['t', 'r', 'u', 'e', *rest]) -> Ok(parsed_json(Bool(True), rest))
parse_value(['f', 'a', 'l', 's', 'e', *rest]) -> Ok(parsed_json(Bool(False), rest))
parse_value(['"', *rest]) -> (
  (text, after) = parse_string(rest, [])?
  Ok(parsed_json(String(text), after))
)
parse_value(['[', *rest]) -> parse_array(rest, [])
parse_value(['{', *rest]) -> parse_object(rest, [])
parse_value(bytes is [first, *_]) if first == '-' | first.is_digit() -> parse_number(bytes)
parse_value(bytes) -> Err((UnexpectedToken, bytes))

# Whether anything but whitespace followed the one value.
parsed_all : (Json, List(U8)) -> Result(Json, Stop)
parsed_all(value, rest) if is_blank(rest) -> Ok(value)
parsed_all(_, rest) -> Err((TrailingInput, rest))

parsed_json : (Json, List(U8)) -> (Json, List(U8))
parsed_json(value, rest) -> (value, skip_space(rest))

parse_array : (List(U8), List(Json)) -> Result((Json, List(U8)), Stop)
parse_array([], _) -> Err((UnexpectedEnd, []))
parse_array([x, *rest], acc) if is_space(x) -> parse_array(rest, acc)
parse_array([']', *rest], acc) -> Ok(parsed_json(Array(acc.reverse()), rest))
parse_array(bytes, acc) -> (
  (value, after) = parse_value(bytes)?
  parse_array_after(after, acc, value)
)

# After an element, a `]` closes the array and a comma promises another.
parse_array_after : (List(U8), List(Json), Json) -> Result((Json, List(U8)), Stop)
parse_array_after([']', *rest], acc, value) -> Ok(parsed_json(Array(acc.prepend(value).reverse()), rest))
parse_array_after([',', *rest], acc, value) -> parse_array_comma(skip_space(rest), acc, value)
parse_array_after(bytes, _, _) -> Err((ExpectedCommaOrEnd, bytes))

# A comma promises another element: `[1,]` is not JSON.
parse_array_comma : (List(U8), List(Json), Json) -> Result((Json, List(U8)), Stop)
parse_array_comma(bytes is [']', *], _, _) -> Err((UnexpectedToken, bytes))
parse_array_comma(next, acc, value) -> parse_array(next, acc.prepend(value))

parse_object : (List(U8), List((Str, Json))) -> Result((Json, List(U8)), Stop)
parse_object([], _) -> Err((UnexpectedEnd, []))
parse_object([x, *rest], acc) if is_space(x) -> parse_object(rest, acc)
parse_object(['}', *rest], acc) -> Ok(parsed_json(Object(acc.reverse()), rest))
parse_object(['"', *key_bytes], acc) -> (
  (key, after_key) = parse_string(key_bytes, [])?
  parse_object_colon(skip_space(after_key), acc, key)
)
parse_object(bytes, _) -> Err((UnexpectedToken, bytes))

# After a key, a colon, then its value.
parse_object_colon : (List(U8), List((Str, Json)), Str) -> Result((Json, List(U8)), Stop)
parse_object_colon([':', *value_bytes], acc, key) -> (
  (value, after) = parse_value(value_bytes)?
  parse_object_after(after, acc, key, value)
)
parse_object_colon(bytes, _, _) -> Err((ExpectedColon, bytes))

# After a member, a `}` closes the object and a comma promises another.
parse_object_after : (List(U8), List((Str, Json)), Str, Json) -> Result((Json, List(U8)), Stop)
parse_object_after(['}', *rest], acc, key, value) ->
  Ok(parsed_json(Object(acc.prepend((key, value)).reverse()), rest))
parse_object_after([',', *rest], acc, key, value) -> parse_object_comma(skip_space(rest), acc, key, value)
parse_object_after(bytes, _, _, _) -> Err((ExpectedCommaOrEnd, bytes))

# A comma promises another member: `{"a":1,}` is not JSON.
parse_object_comma : (List(U8), List((Str, Json)), Str, Json) -> Result((Json, List(U8)), Stop)
parse_object_comma(bytes is ['}', *], _, _, _) -> Err((UnexpectedToken, bytes))
parse_object_comma(next, acc, key, value) -> parse_object(next, acc.prepend((key, value)))

# JSON's whitespace: space, line feed, carriage return and tab.
is_space : U8 -> Bool
is_space(b) -> b == ' ' | b == '\n' | b == '\r' | b == '\t'

skip_space : List(U8) -> List(U8)
skip_space([b, *rest]) if is_space(b) -> skip_space(rest)
skip_space(bytes) -> bytes

is_blank : List(U8) -> Bool
is_blank(bytes) -> skip_space(bytes).is_empty()

# A string's bytes after its opening quote, `acc` holding those read so far
# backwards.
parse_string : (List(U8), List(U8)) -> Result((Str, List(U8)), Stop)
parse_string([], _) -> Err((InvalidString, []))
parse_string(['"', *rest], acc) -> string_done(Str.from_utf8(acc.reverse()), rest)
parse_string(['\\', '"', *rest], acc) -> parse_string(rest, acc.prepend('"'))
parse_string(['\\', '\\', *rest], acc) -> parse_string(rest, acc.prepend('\\'))
parse_string(['\\', '/', *rest], acc) -> parse_string(rest, acc.prepend('/'))
parse_string(['\\', 'b', *rest], acc) -> parse_string(rest, acc.prepend(8))
parse_string(['\\', 'f', *rest], acc) -> parse_string(rest, acc.prepend(12))
parse_string(['\\', 'n', *rest], acc) -> parse_string(rest, acc.prepend('\n'))
parse_string(['\\', 'r', *rest], acc) -> parse_string(rest, acc.prepend('\r'))
parse_string(['\\', 't', *rest], acc) -> parse_string(rest, acc.prepend('\t'))
parse_string(bytes is ['\\', 'u', a, b, c, d, *rest], acc) -> (
  code = hex4(a, b, c, d).err_as((InvalidUnicode, bytes))?
  unicode_escape(code, rest, acc, bytes)
)
parse_string(bytes is ['\\', *], _) -> Err((InvalidEscape, bytes))
parse_string(bytes is [b, *_], _) if b < 32 -> Err((InvalidString, bytes))
parse_string([b, *rest], acc) -> parse_string(rest, acc.prepend(b))

string_done : (Result(Str, [InvalidUtf8]), List(U8)) -> Result((Str, List(U8)), Stop)
string_done(Ok(text), rest) -> Ok((text, rest))
string_done(Err(_), rest) -> Err((InvalidUnicode, rest))

# One decoded `\uXXXX`, whose escape begins `escape`. A scalar outside the
# surrogates is a character; a high surrogate takes the low one after it;
# anything else, a lone low surrogate or a high one with none, is refused.
unicode_escape : (Nat, List(U8), List(U8), List(U8)) -> Result((Str, List(U8)), Stop)
unicode_escape(code, rest, acc, _) if code < 0xd800 | 0xdfff < code ->
  parse_string(rest, prepend_codepoint(acc, code))
unicode_escape(code, ['\\', 'u', e, f, g, h, *after], acc, escape) if code <= 0xdbff -> (
  low = hex4(e, f, g, h).err_as((InvalidUnicode, escape))?
  pair_low(code, low, after, acc, escape)
)
unicode_escape(_, _, _, escape) -> Err((InvalidUnicode, escape))

pair_low : (Nat, Nat, List(U8), List(U8), List(U8)) -> Result((Str, List(U8)), Stop)
pair_low(high, low, after, acc, _) if 0xdc00 <= low & low <= 0xdfff ->
  parse_string(after, prepend_codepoint(acc, surrogate(high, low)))
pair_low(_, _, _, _, escape) -> Err((InvalidUnicode, escape))

surrogate : (Nat, Nat) -> Nat
surrogate(high, low) -> 0x10000 + (high - 0xd800) * 0x400 + (low - 0xdc00)

# `code`'s UTF-8 bytes on the front of `acc`, which is backwards.
prepend_codepoint : (List(U8), Nat) -> List(U8)
prepend_codepoint(acc, code) if code <= 0x7f -> acc.prepend(U8.of_nat(code))
prepend_codepoint(acc, code) if code <= 0x7ff -> acc
  .prepend(U8.of_nat(0xc0 + code / 0x40))
  .prepend(U8.of_nat(0x80 + code % 0x40))
prepend_codepoint(acc, code) if code <= 0xffff -> acc
  .prepend(U8.of_nat(0xe0 + code / 0x1000))
  .prepend(U8.of_nat(0x80 + code / 0x40 % 0x40))
  .prepend(U8.of_nat(0x80 + code % 0x40))
prepend_codepoint(acc, code) -> acc
  .prepend(U8.of_nat(0xf0 + code / 0x40000))
  .prepend(U8.of_nat(0x80 + code / 0x1000 % 0x40))
  .prepend(U8.of_nat(0x80 + code / 0x40 % 0x40))
  .prepend(U8.of_nat(0x80 + code % 0x40))

hex4 : (U8, U8, U8, U8) -> Result(Nat, [NotHex])
hex4(a, b, c, d) -> (
  w = hex_digit(a)?
  x = hex_digit(b)?
  y = hex_digit(c)?
  z = hex_digit(d)?
  Ok(w * 0x1000 + x * 0x100 + y * 0x10 + z)
)

hex_digit : U8 -> Result(Nat, [NotHex])
hex_digit(b is '0'..'9') -> Ok(b.to_nat() - '0')
hex_digit(b is 'a'..'f') -> Ok(b.to_nat() - 'a' + 10)
hex_digit(b is 'A'..'F') -> Ok(b.to_nat() - 'A' + 10)
hex_digit(_) -> Err(NotHex)

# A number, `bytes` beginning with its first character. Its text runs as
# far as characters a number may hold, and must be one whole: `-`, then `0`
# or digits not led by `0`, then an optional fraction and exponent.
parse_number : List(U8) -> Result((Json, List(U8)), Stop)
parse_number(bytes) -> (
  text = bytes.take_while(in_number)
  rest = bytes.drop(text.len())
  if number_end(text) is Err((problem, unread)) return Err((problem, unread.concat(rest)))
  written = Str.from_ascii(text).ok_or("")
  number = if text.any(|b| b == '.' | b == 'e' | b == 'E')
    then Float(F64.from_str(written).err_as((InvalidNumber, bytes))?)
    else Int(Int.from_str(written).err_as((InvalidNumber, bytes))?)
  Ok(parsed_json(number, rest))
)

in_number : U8 -> Bool
in_number(b) -> b.is_digit() | b == '-' | b == '+' | b == '.' | b == 'e' | b == 'E'

# Nothing, where `text` is one number; otherwise where it stops being one.
number_end : List(U8) -> Result({}, Stop)
number_end(['-', *rest]) -> magnitude_end(rest)
number_end(text) -> magnitude_end(text)

magnitude_end : List(U8) -> Result({}, Stop)
magnitude_end(['0', *rest]) -> integer_end(rest)
magnitude_end(text is [first, *_]) if first.is_digit() -> integer_end(text.drop_while(|b| b.is_digit()))
magnitude_end(text) -> Err((InvalidNumber, text))

# After the integer part: a digit here follows a leading zero, as in `01`.
integer_end : List(U8) -> Result({}, Stop)
integer_end(text is [next, *_]) if next.is_digit() -> Err((InvalidNumber, text))
integer_end(['.', *rest]) -> fraction_end(digits_end(rest)?)
integer_end(text) -> fraction_end(text)

fraction_end : List(U8) -> Result({}, Stop)
fraction_end([e, sign, *rest]) if (e == 'e' | e == 'E') & (sign == '+' | sign == '-') -> whole(digits_end(rest)?)
fraction_end([e, *rest]) if e == 'e' | e == 'E' -> whole(digits_end(rest)?)
fraction_end(text) -> whole(text)

# What follows one digit or more.
digits_end : List(U8) -> Result(List(U8), Stop)
digits_end(text is [first, *_]) if first.is_digit() -> Ok(text.drop_while(|b| b.is_digit()))
digits_end(text) -> Err((InvalidNumber, text))

whole : List(U8) -> Result({}, Stop)
whole([]) -> Ok({})
whole(text) -> Err((InvalidNumber, text))

# `problem` placed in `input` where `rest` begins: lines counted by line
# feeds, columns by characters, a UTF-8 continuation byte counting none.
located : (List(U8), Problem, List(U8)) -> ParseError
located(input, problem, rest) -> (
  read = input.take(input.len() - rest.len())
  line = read.count(|b| b == '\n') + 1
  column = read.reverse().take_while(|b| b != '\n').count(|b| b < 0x80 | b >= 0xc0) + 1
  ParseError({problem: problem, line: line, column: column})
)

# Decoding -----------------------------------------------------------------

# A width's verdict, worded as the type that was asked for.
fitted : (Result(a, [TooBig]), Str) -> Decode(a)
fitted(Ok(value), _) -> Decoded(value, [])
fitted(Err(TooBig), kind) -> Failed(Expected(kind))

accepted : Result(a, DecodeError) -> Decode(a)
accepted(Ok(value)) -> Decoded(value, [])
accepted(Err(error)) -> Failed(error)

# The second stage of `and_then`, holding the first stage's claims.
claimed : (Decode(b), List(Str)) -> Decode(b)
claimed(Failed(error), _) -> Failed(error)
claimed(Decoded(_, used_b), used_a) if used_a.any(|name| used_b.contains(name)) ->
  Failed(OverlappingFields)
claimed(Decoded(value, used_b), used_a) -> Decoded(value, used_a.concat(used_b))

# The member named `wanted`, found at most once: the rest of the members are
# looked through after the one found, so a second outranks what the first
# decoded to.
scan_field : (List((Str, Json)), Str, Json -> Decode(a)) -> Field(a)
scan_field([], wanted, _) -> Missing(wanted)
scan_field([(name, value), *rest], wanted, decode) if name == wanted ->
  found_field(scan_field(rest, wanted, decode), wanted, decode(value))
scan_field([_, *rest], wanted, decode) -> scan_field(rest, wanted, decode)

found_field : (Field(a), Str, Decode(a)) -> Field(a)
found_field(Failed(error), _, _) -> Failed(error)
found_field(Value(_, _), wanted, _) -> Failed(DuplicateField(wanted))
found_field(Missing(_), wanted, Failed(error)) -> Failed(AtField(wanted, error))
found_field(Missing(_), wanted, Decoded(found, _)) -> Value(wanted, found)

finish_object : (List((Str, Json)), Decode(a), Bool) -> Decode(a)
finish_object(_, Failed(error), _) -> Failed(error)
finish_object(members, Decoded(value, used), True) ->
  no_unknown(value, members.filter(|(name, _)| !used.contains(name)))
finish_object(_, Decoded(value, _), False) -> Decoded(value, [])

no_unknown : (a, List((Str, Json))) -> Decode(a)
no_unknown(value, []) -> Decoded(value, [])
no_unknown(_, [(name, _), *]) -> Failed(UnknownField(name))

decode_values : (List(Json), Json -> Decode(a), Nat) -> Decode(List(a))
decode_values([], _, _) -> Decoded([], [])
decode_values([value, *rest], decode, index) ->
  decoded_head(decode(value), rest, decode, index)

decoded_head : (Decode(a), List(Json), Json -> Decode(a), Nat) -> Decode(List(a))
decoded_head(Failed(error), _, _, index) -> Failed(AtIndex(index, error))
decoded_head(Decoded(found, _), rest, decode, index) ->
  decoded_tail(found, decode_values(rest, decode, index + 1))

decoded_tail : (a, Decode(List(a))) -> Decode(List(a))
decoded_tail(_, Failed(error)) -> Failed(error)
decoded_tail(found, Decoded(values, _)) -> Decoded([found, *values], [])

# An object's members into `map`, each value by `decode`.
decode_members : (List((Str, Json)), Json -> Decode(a), Map(Str, a)) -> Decode(Map(Str, a))
decode_members([], _, map) -> Decoded(map, [])
decode_members([(name, _), *], _, map) if map.contains(name) -> Failed(DuplicateField(name))
decode_members([(name, value), *rest], decode, map) ->
  member_decoded(decode(value), name, rest, decode, map)

member_decoded : (Decode(a), Str, List((Str, Json)), Json -> Decode(a), Map(Str, a)) -> Decode(Map(Str, a))
member_decoded(Failed(error), name, _, _, _) -> Failed(AtField(name, error))
member_decoded(Decoded(found, _), name, rest, decode, map) ->
  decode_members(rest, decode, map.insert(name, found))

# Rendering ----------------------------------------------------------------

render_string : Str -> Str
render_string(text) -> (
  escaped = Str.from_utf8(text.to_utf8().flat_map(escape_byte)).ok_or("")
  "\"${escaped}\""
)

# The escapes `parse_string` reads, the other way. Backspace and form feed
# are their scalars, 8 and 12, which have no escape of Faun's own.
escape_byte : U8 -> List(U8)
escape_byte('"') -> ['\\', '"']
escape_byte('\\') -> ['\\', '\\']
escape_byte(8) -> ['\\', 'b']
escape_byte(12) -> ['\\', 'f']
escape_byte('\n') -> ['\\', 'n']
escape_byte('\r') -> ['\\', 'r']
escape_byte('\t') -> ['\\', 't']
escape_byte(control) if control < 32 -> ['\\', 'u', '0', '0', hex_upper(control / 16), hex_upper(control % 16)]
escape_byte(other) -> [other]

hex_upper : U8 -> U8
hex_upper(v) if v < 10 -> '0' + v
hex_upper(v) -> 'A' + v - 10

render_member : ((Str, Json)) -> Str
render_member((name, value)) -> "${render_string(name)}:${value.to_str()}"

# `value` as `pretty` writes it, at a level indented by `indent`.
indented : (Json, Str) -> Str
indented(Array([]), _) -> "[]"
indented(Array(values), indent) -> (
  inner = "${indent}  "
  lines = values.map(|value| "${inner}${indented(value, inner)}").join(",\n")
  "[\n${lines}\n${indent}]"
)
indented(Object([]), _) -> "{}"
indented(Object(members), indent) -> (
  inner = "${indent}  "
  lines = members.map(|(name, value)| "${inner}${render_string(name)}: ${indented(value, inner)}").join(",\n")
  "{\n${lines}\n${indent}}"
)
indented(value, _) -> value.to_str()

# Expectations -------------------------------------------------------------

parses : (Str, Json) -> Bool
parses(text, expected) -> Json.from_str(text) == Ok(expected)

stops : (Str, Problem, Nat, Nat) -> Bool
stops(text, problem, line, column) ->
  Json.from_str(text) == Err(ParseError({problem: problem, line: line, column: column}))

# Integers keep every digit; a fraction or an exponent makes a float.
expect parses("-12345678901234567890", Int(-12345678901234567890))
expect parses("1.5", Float(1.5)) & parses("1e3", Float(1000.0)) & parses("-2.5E-3", Float(-0.0025))
expect parses("0", Int(0)) & parses("-0", Int(0)) & parses("0.0", Float(0.0))
expect stops("01", InvalidNumber, 1, 2) & stops("1.", InvalidNumber, 1, 3) & stops("-", InvalidNumber, 1, 2)
expect stops("1e", InvalidNumber, 1, 3) & stops("[1, 2-3]", InvalidNumber, 1, 6)

# The grammar is JSON's exactly: a comma promises another element.
expect stops("[1,]", UnexpectedToken, 1, 4) & stops("{\"a\":1,}", UnexpectedToken, 1, 8)
expect stops("{\"a\" 1}", ExpectedColon, 1, 6) & stops("[1 2]", ExpectedCommaOrEnd, 1, 4)
expect stops("", UnexpectedEnd, 1, 1) & stops("[", UnexpectedEnd, 1, 2) & stops("1 2", TrailingInput, 1, 3)

# A position counts lines and characters, so an error far into a document
# is found where it is.
expect stops("{\n  \"name\": \"é\",\n  \"age\": 3x\n}", ExpectedCommaOrEnd, 3, 11)
expect "${Json.from_str("[1,]")}" == "Err(unexpected JSON token at line 1, column 4)"

# Escapes, a surrogate pair among them, decode to UTF-8; a lone surrogate
# and a control character do not.
expect parses("\"\\u0041\\uD83D\\uDE00\\n\"", String("A😀\n"))
expect stops("\"\\uDE00\"", InvalidUnicode, 1, 2) & stops("\"a\\qb\"", InvalidEscape, 1, 3)
expect stops("\"a\nb\"", InvalidString, 1, 3)

# Rendering writes what parsing reads, and a float that is not finite as
# `null`, which JSON has in place of it.
expect Json.object([("a", Array([Int(1), Float(0.5), Null])), ("b", String("q\"\n"))]).to_str()
  == "{\"a\":[1,0.5,null],\"b\":\"q\\\"\\n\"}"
expect Float(F64.infinity).to_str() == "null" & Float(1.0e21).to_str() == "1.0e21"
expect Json.object([("a", Array([Int(1), Int(2)])), ("b", Object([])), ("c", Array([]))]).pretty()
  == "{\n  \"a\": [\n    1,\n    2\n  ],\n  \"b\": {},\n  \"c\": []\n}"

# A tree is read without decoding by name and index, each step a `Result`
# that `?` passes on.
first_user_name : Json -> Result(Json, [Missing])
first_user_name(document) -> (
  users = document.get("users")?
  first = users.at(0)?
  first.get("name")
)

expect Json.from_str("{\"users\":[{\"name\":\"Ada\"}]}").map_ok(first_user_name) == Ok(Ok(String("Ada")))
expect Object([]).get("x") == Err(Missing) & Array([Null]).at(1) == Err(Missing) & Null.get("x") == Err(Missing)
