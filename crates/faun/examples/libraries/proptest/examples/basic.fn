# Property-based testing in action. Two laws that hold, and one deliberate
# falsehood to show what shrinking buys: the random draw that breaks "every
# number is at most 100" is arbitrary noise — 847, 312, whatever the seed
# gives — but the *shrunk* counterexample is 101, the exact boundary of the
# claim. A failing property doesn't just say "wrong"; it hands back the
# smallest witness of why.

package {
  proptest: "../src/proptest",
  random: "../../random/src/random"
}

import proptest {Verdict, gen_nat, gen_list, shrink_nat, shrink_list}
import random {Random}

# for all lists xs: reversing twice is the identity.
reverse_twice_is_identity : List(Nat) -> Bool
reverse_twice_is_identity(xs) -> xs.reverse().reverse().equals(xs)

# for all lists xs and ys: length distributes over concatenation.
len_of_extend_is_sum : (List(Nat), List(Nat)) -> Bool
len_of_extend_is_sum(xs, ys) -> xs.extend(ys).len().equals(xs.len().add(ys.len()))

# The falsehood: "for all n, n ≤ 100". False for every n from 101 up.
at_most_one_hundred : Nat -> Bool
at_most_one_hundred(n) -> n <= 100

# `forall` tests one value, so a two-list law is tested through the pair.
pair_len_sum : ((List(Nat), List(Nat))) -> Bool
pair_len_sum((xs, ys)) -> len_of_extend_is_sum(xs, ys)

# A property whose counterexamples do not shrink: report the value as drawn.
no_shrinks : a -> List(a)
no_shrinks(_) -> []

nats : Random -> (Nat, Random)
nats(state) -> gen_nat(state, 1000)

nat_lists : Random -> (List(Nat), Random)
nat_lists(state) -> gen_list(state, 6, draw_small_nat)

draw_small_nat : Random -> (Nat, Random)
draw_small_nat(s) -> gen_nat(s, 20)

nat_list_shrinks : List(Nat) -> List(List(Nat))
nat_list_shrinks(xs) -> shrink_list(xs, shrink_nat)

# Pairs are generated by pairing two draws and tested through a wrapper, since
# properties take one value; this is how any n-ary law fits `forall`.
nat_list_pairs : Random -> ((List(Nat), List(Nat)), Random)
nat_list_pairs(state) ->
  (xs, after_xs) = nat_lists(state)
  (ys, after_ys) = nat_lists(after_xs)
  ((xs, ys), after_ys)

expect Verdict.forall(
  30, Random.seed(7),
  nat_lists,
  reverse_twice_is_identity,
  nat_list_shrinks
).passed()

expect Verdict.forall(
  30, Random.seed(11),
  nat_list_pairs,
  pair_len_sum,
  no_shrinks
).passed()

# The broken law is falsified, and the counterexample shrinks to exactly the
# boundary: 101. Not whichever large draw the seed happened to produce.
expect Verdict.forall(
  30, Random.seed(7),
  nats,
  at_most_one_hundred,
  shrink_nat
).smallest(0).equals(101)
