# Parse every line as two natural numbers separated by `x`.

package {
  parser: "../src/parser"
}

import parser {Input}

pairs(text) -> Input.from_str(text)
  .lines()
  .nat()?
  .skip_byte('x')?
  .nat()?
  .map(pair_row)
  .finish()

pair_row : ((Nat, Nat)) -> {left: Nat, right: Nat}
pair_row((left, right)) -> {left, right}

expect pairs("3x14\n2x5\n") == Ok([{left: 3, right: 14}, {left: 2, right: 5}])
expect pairs("3x\n").is_err()
