# Breadth-first search, petgraph's `Bfs` and edged's `LevelOrder`.

import edge {Graph, stored_edges}
import walk {unwalked, enter}
import worklist {drain_queue}

export {bfs}

# The nodes reachable from `start`, nearest first, each once, and none from a
# node the graph does not have.
bfs : (g, Nat) -> List(Nat) where Graph(g, e)
bfs(graph, start) -> (
  walked = drain_queue([start], unwalked(graph), stored_edges(graph) + 1, |walk, node| enter(graph, walk, node))
  walked.order
)
