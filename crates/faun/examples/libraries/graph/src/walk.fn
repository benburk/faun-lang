# Every walk is one loop over a worklist: take a node, enter it, and keep
# the targets of its edges for later, until nothing is left. A stack takes
# the last added first, which is depth first; a queue takes the first,
# which is breadth first. Each is added to at its end, and a stack taken
# from there too, since a list grows and shrinks at its end without being
# copied. A node is marked entered as it is taken, so one
# taken again is passed over, and a node the graph does not have counts as
# entered.

import edge {Walkable, targets}

export {bfs, dfs, groups_from, unseen}

# The nodes reachable from `start`, nearest first, each once.
bfs : (g, Nat) -> List(Nat) where Walkable(g, e)
bfs(graph, start) -> (
  seen = unseen(graph)
  order = []
  queue = [start]
  while queue is [node, *queue] do (
    if seen.get_or(node, True) continue
    seen = seen.put(node, True)
    order = order.append(node)
    edges = graph.edges_from(node)
    queue = queue.concat(targets(edges))
  )
  order
)

# The nodes reachable from `start` in depth-first preorder: each node's
# edges are followed in the order they were given, each to its end before
# the next.
dfs : (g, Nat) -> List(Nat) where Walkable(g, e)
dfs(graph, start) -> (
  groups = groups_from(graph, [start])
  groups.flatten()
)

# The nodes grouped by walks from each of `starts` in turn, each walk
# entering what no earlier one did, depth first, and none started from a
# node an earlier walk entered. Each node's targets go on the stack last
# first, so its first edge is followed first.
groups_from : (g, List(Nat)) -> List(List(Nat)) where Walkable(g, e)
groups_from(graph, starts) -> (
  seen = unseen(graph)
  groups = []
  for start in starts do (
    if seen.get_or(start, True) continue
    group = []
    stack = [start]
    while stack is [*stack, node] do (
      if seen.get_or(node, True) continue
      seen = seen.put(node, True)
      group = group.append(node)
      edges = graph.edges_from(node)
      next = targets(edges).reverse()
      stack = stack.concat(next)
    )
    groups = groups.append(group)
  )
  groups
)

# Every node of `graph` not yet entered.
unseen : g -> List(Bool) where Walkable(g, e)
unseen(graph) -> List.repeat(False, graph.node_count())
