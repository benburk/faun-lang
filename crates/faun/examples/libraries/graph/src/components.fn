# Which nodes belong together. An undirected graph's components need no
# walk: each edge joins the sets of its two ends, union-find over the edges
# as given. A directed graph's strongly connected components are Kosaraju's:
# one depth-first walk of every node says the order it leaves them in, and
# walks of the graph turned round, from the last left first, each enter one
# component.

import edge {Walkable, targets}
import walk {groups_from, unseen}

export {components, strong_components}

# The nodes grouped by which edges join them, each group in increasing
# order and the groups by their least node. A node no edge touches is its
# own group.
components : g -> List(List(Nat)) where
  g.node_count : g -> Nat,
  g.edges : g -> List((Nat, Nat, e))
components(graph) -> (
  count = graph.node_count()
  alone = List.range(count)
  edges = graph.edges()
  parents = edges.fold(alone, joined)
  empty = List.repeat([], count)
  members = alone.fold(empty, |groups, node| gathered(parents, groups, node))
  members.filter(|group| !group.is_empty())
)

# The set holding `node` is named by its least node, which is its own
# parent; every other node's parent is a smaller node of its set.
root : (List(Nat), Nat) -> Nat
root(parents, node) if parents.get_or(node, node) == node -> node
root(parents, node) -> root(parents, parents.get_or(node, node))

# The sets of an edge's two ends made one, under the lesser root.
joined : (List(Nat), (Nat, Nat, e)) -> List(Nat)
joined(parents, (one, other, _)) -> (
  first = root(parents, one)
  second = root(parents, other)
  parents.put(first.max(second), first.min(second))
)

# `node` added to the group its root names.
gathered : (List(Nat), List(List(Nat)), Nat) -> List(List(Nat))
gathered(parents, groups, node) -> (
  named = root(parents, node)
  held = groups.get_or(named, [])
  groups.put(named, held.append(node))
)

# The nodes grouped by which reach which both ways, each group in the order
# a walk of the graph turned round enters it, and the groups so that every
# edge between two goes from an earlier group to a later one.
strong_components : g -> List(List(Nat)) where
  Walkable(g, e),
  g.reversed : g -> g
strong_components(graph) -> (
  left = leaving_order(graph)
  turned = graph.reversed()
  groups_from(turned, left.reverse())
)

Step = [Enter(Nat), Leave(Nat)]

# Every node in the order a depth-first walk from each node in turn leaves
# it: after every node it was first to reach. Entering a node not entered
# before follows each of its edges and then leaves it; leaving it records
# it.
leaving_order : g -> List(Nat) where Walkable(g, e)
leaving_order(graph) -> (
  seen = unseen(graph)
  left = []
  for node in List.range(graph.node_count()) do (
    steps = [Enter(node)]
    while steps is [*steps, step] do (
      left = if step is Leave(done) then left.append(done) else left
      step is Enter(next) else continue
      if seen.get_or(next, True) continue
      seen = seen.put(next, True)
      edges = graph.edges_from(next)
      entering = targets(edges).map(|target| Enter(target))
      leaving = steps.append(Leave(next))
      steps = leaving.concat(entering.reverse())
    )
  )
  left
)
