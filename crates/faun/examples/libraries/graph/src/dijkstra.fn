# Dijkstra's algorithm, lazily: every edge leaving a settled node goes on
# the heap, and entries come off it cheapest first, so a node's first entry
# settles it and any later one finds it settled. Nothing compares costs but
# the heap. Each node is settled once and pushes each of its edges once.

import edge {Walkable}
import table {put}
import heap {Heap}

export {dijkstra, Paths, Weight}

# What a weight must answer: nought, the cost of the path that goes
# nowhere; adding, for going on; and comparing, for the heap.
Weight(e) = where
  e.zero : e,
  e.add : (e, e) -> e,
  e.cmp : (e, e) -> Order

# How a settled node was reached: at what cost, and from which node. The
# source is reached from itself.
Step(e) = {cost: e, from: Nat}

# How each node was settled, where it was.
Settled(e) = List(Result(Step(e), [Unreachable]))

# The cheapest paths from `source` to every node. The weights must not be
# negative.
dijkstra : (g, Nat) -> Paths(e) where Walkable(g, e), Weight(e)
dijkstra(graph, source) -> (
  unsettled = List.repeat(Err(Unreachable), graph.node_count())
  queue = Heap.empty.push(e.zero, {node: source, from: source})
  settled = queue.drain(unsettled, |settled, cost, {node, from}| settle(graph, settled, node, {cost, from}))
  Paths(settled)
)

# `node` settled by `step`, and an entry for each edge leaving it, unless
# it was settled already, more cheaply. A node the graph does not have
# counts as settled, so an edge to one leads nowhere.
settle : (g, Settled(e), Nat, Step(e)) -> (Settled(e), List((e, {node: Nat, from: Nat}))) where Walkable(g, e), Weight(e)
settle(_, settled, node, step) if settled.get_or(node, Ok(step)) is Ok(_) -> (settled, [])
settle(graph, settled, node, step) -> (
  marked = put(settled, node, Ok(step))
  edges = graph.edges_from(node)
  onward = edges.map(|edge| (step.cost + edge.weight, {node: edge.target, from: node}))
  (marked, onward)
)

# What Dijkstra's algorithm found from one source: how each node it
# reached was reached most cheaply.
Paths(e) : Settled(e).(
  # The least cost of a path to `target`.
  cost : (Paths(e), Nat) -> Result(e, [Unreachable])
  cost(Paths(settled), target) -> settled.get_or(target, Err(Unreachable)).map_ok(|step| step.cost)

  # The nodes of a cheapest path to `target`, from the source to `target`.
  path : (Paths(e), Nat) -> Result(List(Nat), [Unreachable])
  path(Paths(settled), target) -> back(settled, target, [])
)

# The path back from `node`, onto `route`, to the node reached from itself:
# the source.
back : (Settled(e), Nat, List(Nat)) -> Result(List(Nat), [Unreachable])
back(settled, node, route) -> (
  walked = [node, *route]
  step = settled.get_or(node, Err(Unreachable))
  if step is Ok({from, *})
    then (if from == node then Ok(walked) else back(settled, from, walked))
    else Err(Unreachable)
)
