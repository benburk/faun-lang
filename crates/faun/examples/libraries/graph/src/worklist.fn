# The loop every search here is: take an item, visit it, and keep what the
# visit adds for later, until nothing is left. A visit answers the state
# and the items it adds, as `Heap.drain`'s does; a stack takes the last
# added first, and a queue the first. `fuel` is how many items there may be
# in all, which each search knows: in a walk, a node entered once adds each
# of its edges once, so there are at most its stored edges and its start.

export {drain_stack, drain_queue}

drain_stack : (List(a), s, Nat, (s, a) -> (s, List(a))) -> s
drain_stack([item, *stack], state, Succ(fuel), visit) -> (
  (next, added) = visit(state, item)
  drain_stack(added.extend(stack), next, fuel, visit)
)
drain_stack(_, state, _, _) -> state

drain_queue : (List(a), s, Nat, (s, a) -> (s, List(a))) -> s
drain_queue([item, *queue], state, Succ(fuel), visit) -> (
  (next, added) = visit(state, item)
  drain_queue(queue.extend(added), next, fuel, visit)
)
drain_queue(_, state, _, _) -> state
