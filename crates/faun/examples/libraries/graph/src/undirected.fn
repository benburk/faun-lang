# An undirected graph: an edge is followed either way, stored both ways and
# a loop once.

import edge {Edge, Unweighted, targets, stored_edges}
import adjacency {unweighted, node_bound, both_ways, adjacency_of}
import walk {Walk, unwalked, enter}
import worklist {drain_stack}

export {UnGraph}

UnGraph(e) : {adjacency: List(List(Edge(e))), edges: Nat}.(
  # The graph of `pairs`, each a pair of ends, over `count` nodes, or more
  # where an edge names one past them. Its edges weigh nothing.
  from_edges : (Nat, List((Nat, Nat))) -> UnGraph(Unweighted)
  from_edges(count, pairs) -> from_weighted_edges(count, pairs.map(unweighted))

  # The graph of `edges`, each `(end, end, weight)`, over `count` nodes, or
  # more where an edge names one past them.
  from_weighted_edges : (Nat, List((Nat, Nat, e))) -> UnGraph(e)
  from_weighted_edges(count, edges) -> (
    stored = edges.flat_map(both_ways)
    adjacency = adjacency_of(stored, node_bound(count, edges))
    UnGraph({adjacency, edges: edges.len()})
  )

  node_count : UnGraph(e) -> Nat
  node_count(UnGraph({adjacency, *})) -> adjacency.len()

  # The edges the graph was built from: each counts once.
  edge_count : UnGraph(e) -> Nat
  edge_count(UnGraph({edges, *})) -> edges

  # The edges at `node`, each seen from it, in the order they were given.
  edges_from : (UnGraph(e), Nat) -> List(Edge(e))
  edges_from(UnGraph({adjacency, *}), node) -> adjacency.get_or(node, [])

  neighbors : (UnGraph(e), Nat) -> List(Nat)
  neighbors(graph, node) -> targets(edges_from(graph, node))

  # The nodes grouped by which reach which: the connected components, each
  # in the order a depth-first walk from its least node enters them, and the
  # groups by their least node.
  components : UnGraph(e) -> List(List(Nat))
  components(graph) -> (
    start = {walk: unwalked(graph), groups: []}
    bound = stored_edges(graph) + 1
    found = List.range(graph.node_count()).fold(start, |found, node| connected(graph, bound, node, found))
    found.groups
  )
)

Found = {walk: Walk, groups: List(List(Nat))}

# The component holding `node`, where no earlier one did: every node a walk
# from it enters, sharing what every earlier walk entered. No walk takes
# more than `bound` items.
connected : (UnGraph(e), Nat, Nat, Found) -> Found
connected(_, _, node, found) if found.walk.seen.get_or(node, True) -> found
connected(graph, bound, node, {walk, groups}) -> (
  fresh = {order: [], *walk}
  walked = drain_stack([node], fresh, bound, |entered, next| enter(graph, entered, next))
  {walk: walked, groups: groups.append(walked.order)}
)
