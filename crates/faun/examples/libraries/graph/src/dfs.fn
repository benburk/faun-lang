# Depth-first search, petgraph's `Dfs` and edged's `PreOrder`.

import edge {Graph}
import walk {unwalked, enter}
import worklist {drain_stack}

export {dfs}

# The nodes reachable from `start` in depth-first preorder: each node's
# edges are followed in the order they were given, each to its end before
# the next, and none from a node the graph does not have.
dfs : (g, Nat) -> List(Nat) where Graph(g, e)
dfs(graph, start) -> (
  walked = drain_stack([start], unwalked(graph), |walk, node| enter(graph, walk, node))
  walked.order
)
