# A directed graph: an edge is followed from its source to its target.

import edge {Edge, Unweighted, targets}
import adjacency {unweighted, node_bound, adjacency_of, arcs}
import undirected {UnGraph}

export {DiGraph}

DiGraph(e) : {adjacency: List(List(Edge(e))), edges: Nat}.(
  # The graph of `pairs`, each `(source, target)`, over `count` nodes, or
  # more where an edge names one past them. Its edges weigh nothing.
  from_edges : (Nat, List((Nat, Nat))) -> DiGraph(Unweighted)
  from_edges(count, pairs) -> from_weighted_edges(count, pairs.map(unweighted))

  # The graph of `edges`, each `(source, target, weight)`, over `count`
  # nodes, or more where an edge names one past them.
  from_weighted_edges : (Nat, List((Nat, Nat, e))) -> DiGraph(e)
  from_weighted_edges(count, edges) -> (
    adjacency = adjacency_of(edges, node_bound(count, edges))
    DiGraph({adjacency, edges: edges.len()})
  )

  node_count : DiGraph(e) -> Nat
  node_count(DiGraph({adjacency, *})) -> adjacency.len()

  edge_count : DiGraph(e) -> Nat
  edge_count(DiGraph({edges, *})) -> edges

  # The edges leaving `node`, in the order they were given, and none from a
  # node the graph does not have.
  edges_from : (DiGraph(e), Nat) -> List(Edge(e))
  edges_from(DiGraph({adjacency, *}), node) -> adjacency.get_or(node, [])

  # The targets of the edges leaving `node`, one for each edge.
  neighbors : (DiGraph(e), Nat) -> List(Nat)
  neighbors(graph, node) -> targets(edges_from(graph, node))

  # The graph with every edge turned round: what reaches a node here leaves
  # it there.
  reversed : DiGraph(e) -> DiGraph(e)
  reversed(DiGraph({adjacency, edges})) -> (
    turned = arcs(adjacency).map(|(source, target, weight)| (target, source, weight))
    DiGraph({adjacency: adjacency_of(turned, adjacency.len()), edges})
  )

  # The nodes grouped by which reach which along edges followed either way:
  # the weakly connected components. Each group is in ascending order, and
  # the groups by their least node.
  weak_components : DiGraph(e) -> List(List(Nat))
  weak_components(DiGraph({adjacency, *})) -> (
    undirected = UnGraph.from_weighted_edges(adjacency.len(), arcs(adjacency))
    undirected.components()
  )
)
