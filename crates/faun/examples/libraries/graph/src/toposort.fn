# Topological sort by Kahn's algorithm, petgraph's `toposort` and edged's
# `Topological`: a node is ready once every edge into it has been taken, and
# taking a ready node takes the edges leaving it. A node is made ready once,
# when its last edge in is taken. It asks a graph how many edges come into
# each node, which only a directed graph answers.

import edge {Walkable}
import table {put}
import walk {drain_stack}

export {toposort}

# Every node, each before the targets of the edges leaving it, or `Cycle`
# where edges go round and no such order exists. Of the nodes ready at
# once, the latest made ready goes first.
toposort : g -> Result(List(Nat), [Cycle]) where
  Walkable(g, e),
  g.in_degree : (g, Nat) -> Nat
toposort(graph) -> (
  count = graph.node_count()
  nodes = List.range(count)
  degrees = nodes.map(|node| graph.in_degree(node))
  ready = nodes.filter(|node| degrees.get_or(node, 0) == 0)
  taken = drain_stack(ready, {degrees, order: []}, |kahn, node| take(graph, kahn, node))
  sorted(taken.order, count)
)

Kahn = {degrees: List(Nat), order: List(Nat)}

# `node` taken, and the targets its edges make ready.
take : (g, Kahn, Nat) -> (Kahn, List(Nat)) where Walkable(g, e)
take(graph, {degrees, order}, node) -> (
  edges = graph.edges_from(node)
  freed = edges.fold({ready: [], degrees}, |state, edge| release(edge.target, state))
  ({degrees: freed.degrees, order: order.append(node)}, freed.ready)
)

# One edge into `target` taken: it is ready where that was its last.
release : (Nat, {ready: List(Nat), degrees: List(Nat)}) -> {ready: List(Nat), degrees: List(Nat)}
release(target, {ready, degrees}) if degrees.get_or(target, 0) == 1 ->
  {ready: [target, *ready], degrees: put(degrees, target, 0)}
release(target, {ready, degrees}) ->
  {ready, degrees: put(degrees, target, degrees.get_or(target, 0) - 1)}

# The order, where it holds every node; a node never ready was on a cycle.
sorted : (List(Nat), Nat) -> Result(List(Nat), [Cycle])
sorted(order, count) if order.len() == count -> Ok(order)
sorted(_, _) -> Err(Cycle)
