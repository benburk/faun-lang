# A SAT solver in the style of DPLL: choose a literal, assume it, simplify
# the formula, and where that fails, assume its opposite. A literal standing
# alone in its clause is chosen first: its opposite empties that clause at
# once, so unit propagation needs no code of its own.
#
# After SAT-MICRO by Conchon, Kanig and Lescuyer. Run, it colours the map of
# Australia in three colours.

import std.host {Host}

Literal : [Yes(Str), Not(Str)].(
  # The opposite literal, written `-literal`.
  neg : Literal -> Literal
  neg(Yes(name)) -> Not(name)
  neg(Not(name)) -> Yes(name)

  equals : (Literal, Literal) -> Bool
)

# A clause holds where one of its literals does, and a formula where every
# clause does. A model gives each variable it needed a value.
Clause = List(Literal)
Formula = List(Clause)
Model = Map(Str, Bool)

# What is left to hold once `literal` does: a clause it satisfies goes, and
# its opposite is struck from the rest.
assume : (Formula, Literal) -> Formula
assume(formula, literal) -> formula
  .filter(|clause| !clause.contains(literal))
  .map(|clause| clause.filter(|other| other != -literal))

# The literal of a clause standing alone, or `first` where none does.
pick : (Formula, Literal) -> Literal
pick([[unit], *_], _) -> unit
pick([_, *rest], first) -> pick(rest, first)
pick([], first) -> first

holding : (Model, Literal) -> Model
holding(model, Yes(name)) -> model.insert(name, True)
holding(model, Not(name)) -> model.insert(name, False)

solve : (Formula, Model) -> Result(Model, [Unsat])
solve([], model) -> Ok(model)
solve(formula, model) -> (
  formula is [[first, *_], *_] else return Err(Unsat)
  if formula.any(|clause| clause.is_empty()) return Err(Unsat)
  literal = pick(formula, first)
  solve(assume(formula, literal), holding(model, literal)) is (
    Ok(found) then Ok(found)
    Err(Unsat) then solve(assume(formula, -literal), holding(model, -literal))
  )
)

holds : (Model, Literal) -> Bool
holds(model, Yes(name)) -> model.get(name) == Ok(True)
holds(model, Not(name)) -> model.get(name) == Ok(False)

satisfies : (Model, Formula) -> Bool
satisfies(model, formula) -> formula.all(|clause| clause.any(|literal| holds(model, literal)))

# Colouring a map: a variable for each region in each colour. Every region
# is some colour and at most one, and neighbours are never the same.

regions : List(Str)
regions = ["WA", "NT", "SA", "Q", "NSW", "V", "T"]

borders : List((Str, Str))
borders = [
  ("WA", "NT"), ("WA", "SA"), ("NT", "SA"), ("NT", "Q"), ("SA", "Q"),
  ("SA", "NSW"), ("SA", "V"), ("Q", "NSW"), ("NSW", "V"),
]

painted : (Str, Str) -> Str
painted(region, colour) -> "${region} ${colour}"

# Each pair of colours once, in order.
pairs : List(Str) -> List((Str, Str))
pairs([]) -> []
pairs([first, *rest]) -> rest.map(|other| (first, other)).concat(pairs(rest))

# Each region is some colour, and at most one.
painted_once : (Str, List(Str)) -> Formula
painted_once(region, colours) -> [
  colours.map(|colour| Yes(painted(region, colour))),
  *pairs(colours).map(|(a, b)| [Not(painted(region, a)), Not(painted(region, b))]),
]

# Neighbours are never the same colour.
apart : ((Str, Str), List(Str)) -> Formula
apart((here, there), colours) -> colours.map(|colour| [Not(painted(here, colour)), Not(painted(there, colour))])

colouring : (List(Str), List((Str, Str)), List(Str)) -> Formula
colouring(regions, borders, colours) -> regions
  .flat_map(|region| painted_once(region, colours))
  .concat(borders.flat_map(|border| apart(border, colours)))

colours : List(Str)
colours = ["red", "green", "blue"]

# Each region and the colour the model gives it.
legend : Model -> Str
legend(model) -> regions
  .map(|region| (region, colours.find(|colour| holds(model, Yes(painted(region, colour)))).ok_or("any")))
  .map(|(region, colour)| "${region:<4}${colour}")
  .join("\n")

australia : Formula
australia = colouring(regions, borders, colours)

expect solve(australia, Map.empty).map_ok(|model| satisfies(model, australia)) == Ok(True)

# (a or b) and (not a or b) and (not b or c): b and c must hold.
expect solve([[Yes("a"), Yes("b")], [Not("a"), Yes("b")], [Not("b"), Yes("c")]], Map.empty)
  .map_ok(|model| holds(model, Yes("b")) & holds(model, Yes("c")))
  == Ok(True)

expect solve([[Yes("a")], [Not("a")]], Map.empty) == Err(Unsat)

# A triangle takes three colours, so two are not enough; and three pigeons
# do not fit in two holes.
expect solve(colouring(["x", "y", "z"], [("x", "y"), ("y", "z"), ("x", "z")], ["red", "green"]), Map.empty) == Err(Unsat)
expect solve(colouring(["1", "2", "3"], pairs(["1", "2", "3"]), ["left", "right"]), Map.empty) == Err(Unsat)

app : {args: List(Str)} -> Str
app(_) -> solve(australia, Map.empty).map_ok(legend).ok_or("no colouring")

main!(host) -> host.run!(app)
