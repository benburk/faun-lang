# A SAT solver in the style of DPLL: choose a literal, assume it, simplify
# the formula, and where that fails, assume its opposite. A literal standing
# alone in its clause is chosen first: its opposite empties that clause at
# once, so unit propagation needs no code of its own.
#
# The solver works over any variables that can be compared, as SAT-MICRO by
# Conchon, Kanig and Lescuyer works over any ordered type. Run, it colours
# the map of Australia in three colours, a variable for each region in each
# colour.

import std.host {Host}

Literal(v) : [Yes(v), Not(v)].(
  # The opposite literal, written `-literal`.
  neg : Literal(v) -> Literal(v)
  neg(Yes(x)) -> Not(x)
  neg(Not(x)) -> Yes(x)

  equals : (Literal(v), Literal(v)) -> Bool where Equatable(v)
)

# A clause holds where one of its literals does, and a formula where every
# clause does. A model is the literals assumed to make it hold.
Clause(v) = List(Literal(v))
Formula(v) = List(Clause(v))
Model(v) = List(Literal(v))

# What is left to hold once `literal` does: a clause it satisfies goes, and
# its opposite is struck from the rest.
assume : (Formula(v), Literal(v)) -> Formula(v) where Equatable(v)
assume(formula, literal) -> formula
  .filter(|clause| !clause.contains(literal))
  .map(|clause| clause.filter(|other| other != -literal))

# The literal of a clause standing alone, or `first` where none does.
pick : (Formula(v), Literal(v)) -> Literal(v)
pick([[unit], *_], _) -> unit
pick([_, *rest], first) -> pick(rest, first)
pick([], first) -> first

solve : (Formula(v), Model(v)) -> Result(Model(v), [Unsat]) where Equatable(v)
solve([], model) -> Ok(model)
solve(formula, model) -> (
  formula is [[first, *_], *_] else return Err(Unsat)
  if formula.any(|clause| clause.is_empty()) return Err(Unsat)
  literal = pick(formula, first)
  solve(assume(formula, literal), [literal, *model])
    .or_else(|_| solve(assume(formula, -literal), [-literal, *model]))
)

satisfies : (Model(v), Formula(v)) -> Bool where Equatable(v)
satisfies(model, formula) -> formula.all(|clause| clause.any(|literal| model.contains(literal)))

# Colouring a map: a variable for each region in each colour, the pair of
# the two. Every region is some colour and at most one, and neighbours are
# never the same.

Region : [WA, NT, SA, Q, NSW, V, T].(
  equals : (Region, Region) -> Bool

  to_str : Region -> Str
)

Colour : [Red, Green, Blue].(
  equals : (Colour, Colour) -> Bool

  to_str : Colour -> Str
)

regions : List(Region)
regions = [WA, NT, SA, Q, NSW, V, T]

borders : List((Region, Region))
borders = [(WA, NT), (WA, SA), (NT, SA), (NT, Q), (SA, Q), (SA, NSW), (SA, V), (Q, NSW), (NSW, V)]

colours : List(Colour)
colours = [Red, Green, Blue]

# Each pair of a list's elements once, in order.
pairs : List(a) -> List((a, a))
pairs([]) -> []
pairs([first, *rest]) -> rest.map(|other| (first, other)).concat(pairs(rest))

# Each region is some colour, and at most one.
painted_once : (r, List(c)) -> Formula((r, c))
painted_once(region, colours) -> [
  colours.map(|colour| Yes((region, colour))),
  *pairs(colours).map(|(a, b)| [Not((region, a)), Not((region, b))]),
]

# Neighbours are never the same colour.
apart : ((r, r), List(c)) -> Formula((r, c))
apart((here, there), colours) -> colours.map(|colour| [Not((here, colour)), Not((there, colour))])

colouring : (List(r), List((r, r)), List(c)) -> Formula((r, c))
colouring(regions, borders, colours) -> regions
  .flat_map(|region| painted_once(region, colours))
  .concat(borders.flat_map(|border| apart(border, colours)))

# Each region and the colour the model gives it.
legend : Model((Region, Colour)) -> Str
legend(model) -> regions
  .map(|region| "${region:<4}${colour_of(model, region).map_ok(Colour.to_str).ok_or("any")}")
  .join("\n")

colour_of : (Model((Region, Colour)), Region) -> Result(Colour, [NotFound])
colour_of(model, region) -> colours.find(|colour| model.contains(Yes((region, colour))))

australia : Formula((Region, Colour))
australia = colouring(regions, borders, colours)

expect solve(australia, []).map_ok(|model| satisfies(model, australia)) == Ok(True)

# (1 or 2) and (not 1 or 2) and (not 2 or 3): 2 and 3 must hold.
expect solve([[Yes(1), Yes(2)], [Not(1), Yes(2)], [Not(2), Yes(3)]], [])
  .map_ok(|model| model.contains(Yes(2)) & model.contains(Yes(3)))
  == Ok(True)

expect solve([[Yes(1)], [Not(1)]], []) == Err(Unsat)

# A triangle takes three colours, so two are not enough: the same formula
# as three pigeons in two holes.
expect solve(colouring([1, 2, 3], pairs([1, 2, 3]), [Red, Green]), []) == Err(Unsat)

app : {args: List(Str)} -> Str
app(_) -> solve(australia, []).map_ok(legend).ok_or("no colouring")

main!(host) -> host.run!(app)
