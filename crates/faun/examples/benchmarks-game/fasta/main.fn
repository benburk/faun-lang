# Three FASTA records with sixty bases per line. The first repeats the ALU
# sequence; the other two sample the given base frequencies with one
# continuous linear congruential generator.

import std.host {Host, WriteError}

alu : List(U8)
alu =
  "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGGGAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGACCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAATACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCAGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGGAGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCCAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA".to_utf8()

width : Nat
width = 60

# The generator's next seed. A seed `s` draws `s / 139968`.
next : Nat -> Nat
next(seed) -> (seed * 3877 + 29573) % 139968

# One step produces the next state and one base.
Generator = Nat -> (Nat, U8)

# Write at most 64 lines per block, carrying the generator across writes.
emit! : (Host, Nat, Nat, Generator) -> Result(Nat, WriteError)
emit!(_, 0, seed, _) -> Ok(seed)
emit!(host, n, seed, draw) -> (
  count = n.min(width * 64)
  (seed, bytes) = block(count, width, seed, draw, [])
  host.stdout.write_all!(bytes)?
  emit!(host, n - count, seed, draw)
)

# Append in output order. A newline ends the current line without advancing
# the generator, including the final, possibly short line of the block.
block : (Nat, Nat, Nat, Generator, List(U8)) -> (Nat, List(U8))
block(0, _, seed, _, bytes) -> (seed, bytes.append(10))
block(n, 0, seed, draw, bytes) -> block(n, width, seed, draw, bytes.append(10))
block(Succ(n), col, seed, draw, bytes) -> (
  (seed, byte) = draw(seed)
  block(n, col - 1, seed, draw, bytes.append(byte))
)

# Weights are integers in a common unit. A seed belongs to the first
# interval whose cumulative share is greater than seed / 139968.
# Rounding each upper limit up makes the integer comparison exact.
random! : (Host, Nat, Nat, Str, List(Nat)) -> Result(Nat, WriteError)
random!(host, n, seed, bases, weights) -> (
  total = weights.sum()
  limits = weights.trail(0, |sum, w| sum + w).map(|sum| (sum * 139968 + total - 1) / total)
  table = bases.to_utf8().zip(limits)
  emit!(host, n, seed, |s| (
    s = next(s)
    (base, _) = table.find(|(_, end)| s < end).ok_or((0, 0))
    (s, base)
  ))
)

expect next(42) == 32416

main! : Host -> []
main!(host) -> (
  n = Nat.from_str(host.args.get(1).ok_or("1000")).ok_or(1000)
  one = host.print!(">ONE Homo sapiens alu\n")
  repeated = emit!(host, 2 * n, 0, |i| ((i + 1) % alu.len(), alu.get_or(i, 0)))
  two = host.print!(">TWO IUB ambiguity codes\n")
  drawn = random!(host, 3 * n, 42, "acgtBDHKMNRSVWY", [27, 12, 12, 27, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2])
  seed = drawn.ok_or(42)
  three = host.print!(">THREE Homo sapiens frequency\n")
  # The published human frequencies in units of 10^-13.
  written = random!(host, 5 * n, seed, "acgt", [3029549426680, 1979883004921, 1975473066391, 3015094502008])
  host.exit!(0)
)
