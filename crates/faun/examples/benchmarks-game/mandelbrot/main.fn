# Mandelbrot, after the benchmarks-game program of the same name: the
# Mandelbrot set on an `n` by `n` grid, as a PBM bitmap, a pixel set where
# its point stays within two of nought for fifty steps.
#
# This is the benchmark of floating-point arithmetic in a tight walk: each
# pixel is up to fifty steps of a few multiplications and additions, then
# the pixels are packed eight to a byte.
#
# The first argument is `n`. What is written is the game's own output.

import std.host {Host, WriteError}

# Inside the main cardioid or period-two bulb the orbit stays bounded.
# Leave a margin at each boundary so points within rounding distance
# take the same fifty steps as the rest of the image.
pixel : (F64, F64) -> Bool
pixel(x, y) -> (
  u = x - 0.25
  yy = y * y
  q = u * u + yy
  if q * (q + u) + 1.0e-12 < 0.25 * yy return True
  if (x + 1.0) * (x + 1.0) + yy + 1.0e-12 < 0.0625 return True
  orbit(x, y, 0.0, 0.0, 50)
)

# At radius two the point is still in range. On this finite grid the sign
# of the distance to the squared limit detects strict escape.
orbit : (F64, F64, F64, F64, Nat) -> Bool
orbit(x, y, re, im, left) -> (
  rr = re * re
  ii = im * im
  if (4.0 - (rr + ii)).sign_bit() return False
  left is Succ(n) else return True
  orbit(x, y, rr - ii + x, 2.0 * re * im + y, n)
)

coordinate : (Nat, Nat, F64) -> F64
coordinate(at, n, low) -> 2.0 * F64.of_nat(at) / F64.of_nat(n) - low

# Build each PBM byte from its most significant bit. The last byte
# shifts in zeroes for positions past the end of the row.
row : (Nat, Nat) -> List(U8)
row(y, n) -> (
  im = coordinate(y, n, 1.0)
  List.range((n + 7) / 8).map(|i| (
    (_, byte) = 8.times((i * 8, U8.of_nat(0)), |(x, byte)| (
      set = x < n & pixel(coordinate(x, n, 1.5), im)
      (x + 1, byte + byte + set.select(1, 0))
    ))
    byte
  ))
)

expect row(0, 8) == [U8.of_nat(0)]
expect pixel(-0.5, 0.0) & !pixel(1.0, 1.0)

# Rows `y` to `n - 1`, written a row at a time.
drawn! : (Host, Nat, Nat) -> Result({}, WriteError)
drawn!(_, y, n) if y == n -> Ok({})
drawn!(host, y, n) -> (
  host.stdout.write_all!(row(y, n))?
  drawn!(host, y + 1, n)
)

main! : Host -> []
main!(host) -> (
  n = Nat.from_str(host.args.get(1).ok_or("200")).ok_or(200)
  header = host.print!("P4\n${n} ${n}\n")
  drawn = drawn!(host, 0, n)
  host.exit!(0)
)
