# Lines. An item or a block's line ends at a new line; a line goes on after
# an arrow, after an infix operator or a comma, and into a chain that begins
# with `.`. Indentation carries no meaning.

# A body of several lines is a block: its bindings, one to a line, then its
# answer, in parentheses.
area : (Nat, Nat) -> Nat
area(width, height) -> (
  inner_width = width - 2
  inner_height = height - 2
  inner_width * inner_height
)

expect area(5, 4) == 6

# The answer may begin on the line after the arrow.
answer : Nat
answer() ->
  42

expect answer() == 42

# An operator at a line's end carries it on.
total : (Nat, Nat, Nat) -> Nat
total(a, b, c) ->
  a +
    b *
    c

expect total(1, 2, 3) == 7

# A chain goes on at a line that begins with `.`.
evens_doubled : List(Nat) -> List(Nat)
evens_doubled(values) ->
  values
    .filter(|n| n % 2 == 0)
    .map(|n| n * 2)

expect evens_doubled([1, 2, 3, 4]) == [4, 8]

# Parentheses group, however deep.
expect ((((1)))) + (((2))) == 3

# Comments run to a line's end, beside code or on their own.
commented : Nat -> Nat   # a signature
# between a signature and its clauses
commented(n) -> n        # a clause

expect commented(1) == 1

# A block stands wherever an expression does, and its names leave with it:
# `inner` here is the block's, and gone after it.
scaled : Nat -> List(Nat)
scaled(n) -> [1, 2, 3].map(|x| (
  inner = x * n
  inner + 1
))

expect scaled(2) == [3, 5, 7]

nested : Nat -> Nat
nested(n) -> (
  inner = (
    inner = n + 1
    inner * 2
  )
  inner + 1
)

expect nested(1) == 5

# A guard is an expression, so it may be a block too.
large : Nat -> Bool
large(n) if (
  limit = 10
  n > limit
) -> True
large(_) -> False

expect large(11) & !large(3)

# An expectation of several lines is a block, as a body is.
expect (
  doubled = [1, 2, 3].map(|n| n * 2)
  doubled.len() == 3
    & doubled.last().ok_or(0) == 6
)

# Blank lines, and none, between items.
a : Nat
a() -> 1
b : Nat
b() -> a() + 1


expect b() == 2
