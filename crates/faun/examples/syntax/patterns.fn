# A pattern is written as the expression that builds what it matches.

# Names and `_`.
second : (Nat, Nat) -> Nat
second(_, b) -> b

expect second(1, 2) == 2

# Constructors, nested, and an or-pattern.
Shape : [Circle(Nat), Rect(Nat, Nat), Dot]

area : Shape -> Nat
area(Circle(r)) -> 3 * r * r
area(Rect(w, h)) -> w * h
area(Dot) -> 0

expect area(Circle(2)) == 12 & area(Rect(2, 5)) == 10 & area(Dot) == 0

flat : Shape -> Bool
flat(Dot | Rect(0, _) | Rect(_, 0)) -> True
flat(_) -> False

expect flat(Dot) & flat(Rect(0, 3)) & !flat(Rect(1, 1)) & !flat(Circle(0))

unwrap : Result(Result(Nat, Str), Str) -> Nat
unwrap(Ok(Ok(n))) -> n
unwrap(Ok(Err(_))) -> 1
unwrap(Err(_)) -> 0

expect unwrap(Ok(Ok(7))) == 7 & unwrap(Ok(Err("no"))) == 1 & unwrap(Err("no")) == 0

# Lists: empty, fixed, and with a rest, named or not.
describe : List(Nat) -> Nat
describe([]) -> 0
describe([a]) -> a
describe([a, b]) -> a + b
describe([a, b, *]) -> a * b

expect describe([]) == 0 & describe([5]) == 5 & describe([2, 3]) == 5 & describe([2, 3, 4]) == 6

tail_len : List(Nat) -> Nat
tail_len([_, *rest]) -> rest.len()
tail_len([]) -> 0

expect tail_len([1, 2, 3]) == 2 & tail_len([]) == 0

# Records: fields by name, renamed, and left open.
Point : {x: Nat, y: Nat}

sum_point : Point -> Nat
sum_point(Point({x, y})) -> x + y

expect sum_point(Point({x: 2, y: 3})) == 5 & sum_point(Point({y: 3, x: 2})) == 5

first_x : {x: Nat, y: Nat} -> Nat
first_x({x: across, *}) -> across

expect first_x({x: 4, y: 9}) == 4

# Tuples.
swap_sum : ((Nat, Nat)) -> Nat
swap_sum((a, b)) -> b * 10 + a

expect swap_sum((1, 2)) == 21

# Numerals and negative numerals.
classify : Int -> Nat
classify(-1) -> 1
classify(0) -> 2
classify(_) -> 3

expect classify(-1) == 1 & classify(0) == 2 & classify(5) == 3

# A range: inclusive at both ends, of numerals or characters, at any type a
# numeral can be. It binds nothing, and is a test the clause asks before its
# guard, so a clause holding one covers nothing.
digit : U8 -> Bool
digit('0'..'9') -> True
digit(_) -> False

expect digit('0') & digit('9') & !digit('/') & !digit(':')

size : Nat -> Nat
size(0..9) -> 1
size(10..99) -> 2
size(_) -> 3

expect size(0) == 1 & size(9) == 1 & size(10) == 2 & size(99) == 2 & size(100) == 3

near_zero : Int -> Bool
near_zero(0..2) -> True
near_zero(_) -> False

expect near_zero(2) & !near_zero(3) & !near_zero(-1)

# An end may be negative, and either may be `_`, leaving that side open.
sign : Int -> Nat
sign(_..-1) -> 0
sign(0) -> 1
sign(1.._) -> 2
sign(_) -> 3

expect sign(-7) == 0 & sign(-1) == 0 & sign(0) == 1 & sign(1) == 2 & sign(80) == 2

band : Int -> Nat
band(-10..-5) -> 1
band(-4..4) -> 2
band(_) -> 0

expect band(-10) == 1 & band(-5) == 1 & band(-11) == 0 & band(-4) == 2 & band(4) == 2 & band(5) == 0

high : U8 -> Bool
high(0x80.._) -> True
high(_) -> False

expect high(0x80) & high(0xff) & !high(0x7f)

# Ends past a word's size, and the one value a range of one end holds.
wide : U64 -> Nat
wide(5..5) -> 1
wide(1000..20000000000) -> 2
wide(_) -> 0

expect wide(5) == 1 & wide(4) == 0 & wide(20000000000) == 2 & wide(20000000001) == 0

# Ranges within a list, as a table of UTF-8's three-byte forms.
three_byte : List(U8) -> Bool
three_byte([0xe0, 0xa0..0xbf, 0x80..0xbf]) -> True
three_byte([0xe1..0xec, 0x80..0xbf, 0x80..0xbf]) -> True
three_byte(_) -> False

expect three_byte([0xe0, 0xa0, 0x80]) & !three_byte([0xe0, 0x9f, 0x80]) & three_byte([0xe5, 0xbf, 0xbf])

# A range in a constructor, beside a guard, and in each of an or-pattern's
# alternatives, which are a row each.
reading : [Level(Nat), Off] -> Nat
reading(Level(0..9)) if True -> 0
reading(Level(n)) -> n
reading(Off) -> 99

expect reading(Level(5)) == 0 & reading(Level(15)) == 15 & reading(Off) == 99

edges : Nat -> Bool
edges(0..2 | 8..9) -> True
edges(_) -> False

expect edges(1) & edges(9) & !edges(5)

# A string pattern is a test of equality.
greeting : Str -> Nat
greeting("hello") -> 1
greeting("hi") -> 2
greeting(_) -> 0

expect greeting("hello") == 1 & greeting("hi") == 2 & greeting("hey") == 0

# A binding takes a pattern, and so does a lambda's parameter.
pair_sum : ((Nat, Nat)) -> Nat
pair_sum(pair) -> (
  (a, b) = pair
  a + b
)

expect pair_sum((3, 4)) == 7
expect [(1, 2), (3, 4)].map(|(a, b)| a * b) == [2, 12]

# A sum's own name takes apart whichever constructor holds the value, where
# every one carries as many fields as it names. The clause is one copy for
# each constructor, so the payload has that constructor's type, and the
# name applied in the body puts back the constructor that was taken apart.
Reading : [Metres(Nat), Feet(Nat), Depth(Reading)].(
  to_str : Reading -> Str
  to_str(Reading(value)) -> "<${value}>"
)

expect Depth(Feet(3)).to_str() == "<<3>>"

Nudge : [Up(Nat), Down(Nat)].(
  to_str : Nudge -> Str
  to_str(Up(n)) -> "up ${n}"
  to_str(Down(n)) -> "down ${n}"
)

nudged : ((Nudge, Nat)) -> Nudge
nudged((Nudge(by), extra)) -> Nudge(by + extra)

expect nudged((Down(2), 1)).to_str() == "down 3"

# `name is pattern` names the whole value and takes it apart: the clause
# tests the list's head and hands on the list itself.
merge : (List(Nat), List(Nat)) -> List(Nat)
merge([], right) -> right
merge(left, []) -> left
merge([x, *xs], right is [y, *_]) if x <= y -> [x, *merge(xs, right)]
merge(left is [_, *_], [y, *ys]) -> [y, *merge(left, ys)]

expect merge([1, 4, 6], [2, 3, 7]) == [1, 2, 3, 4, 6, 7]

# `==name` matches a value equal to a name in scope, by its type's `equals`,
# and binds nothing.
value_of : (Str, List((Str, Nat))) -> Nat
value_of(_, []) -> 0
value_of(key, [(==key, value), *_]) -> value
value_of(key, [_, *rest]) -> value_of(key, rest)

expect value_of("b", [("a", 1), ("b", 2)]) == 2 & value_of("c", [("a", 1)]) == 0
