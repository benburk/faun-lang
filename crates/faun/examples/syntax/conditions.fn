# `if condition then yes else no`: an expression answering one of two
# values, the condition a `Bool`. Only the branch it chooses is worked out,
# and both answer one type. It takes everything after its `else`, so it
# begins an expression: as an operand it is written in parentheses.

sign : Int -> Str
sign(n) -> if n < 0 then "negative" else if n == 0 then "zero" else "positive"

# The branch not chosen is not worked out, so a recursion stops there.
count : Nat -> Nat
count(n) -> if n == 0 then 0 else 1 + count(n - 1)

# A branch may be a block, its bindings its own; and in a block, a line
# beginning `if` begins one, where after a clause it would be a guard.
spread : (Nat, Nat) -> Nat
spread(a, b) -> (
  low = a.min(b)
  if a == b then 0 else (
    high = a.max(b)
    high - low
  )
)

# A branch is a value and never leaves: to pass a failure on, both
# branches answer a `Result`, and the whole `if` is asked `?`.
parsed : (Bool, Str) -> Result(Nat, [Malformed])
parsed(strict, text) -> (
  n = (if strict then Nat.from_str(text) else Ok(0))?
  Ok(n + 1)
)

expect sign(-3) == "negative" & sign(0) == "zero" & sign(5) == "positive"
expect count(4) == 4
expect spread(3, 7) == 4 & spread(5, 5) == 0
expect (if True then 1 else 2) + 1 == 2
expect parsed(True, "41") == Ok(42) & parsed(False, "x") == Ok(1)
expect parsed(True, "x").is_err()

# `value is pattern` asks whether a value has a shape, answering a `Bool`.
# What the pattern binds is seen where the test is known to have held: the
# rest of an `&` chain, and the `then` of an `if` asking it.
present : List(Result(Nat, [Gone])) -> Nat
present(results) -> results.filter(|result| result is Ok(_)).len()

doubled : Result(Nat, [Gone]) -> Nat
doubled(r) -> if r is Ok(v) & v < 100 then v * 2 else 0

# Several values at once as a tuple; alternatives grouped in parentheses;
# a list's end; a test reading what an earlier one bound.
both : (Result(Nat, [Gone]), Result(Nat, [Gone])) -> Nat
both(a, b) -> if (a, b) is (Ok(x), Ok(y)) & x <= y then y - x else 0

word : Str -> Nat
word(text) -> if text is ("get" | "fetch") then 1 else 0

last : List(Nat) -> Nat
last(xs) -> if xs is [*_, x] & x is 1..9 then x else 0

# A name in a pattern always binds: one in scope is bound again where the
# test holds, as `=` would bind it, and `==name` compares instead. Where the
# ways meet it may be one type or another, so long as nothing reads it there.
inner : Result(Nat, [Gone]) -> Nat
inner(step) -> if step is Ok(step) then step else 0

limited : (Result(Nat, [Gone]), Nat) -> Nat
limited(r, limit) -> (
  r is Ok(limit) else return limit
  limit + 1
)

capped : (Result(Nat, [Gone]), Nat) -> Bool
capped(r, limit) -> r is Ok(==limit)

expect present([Ok(1), Err(Gone), Ok(3)]) == 2
expect doubled(Ok(4)) == 8 & doubled(Ok(400)) == 0 & doubled(Err(Gone)) == 0
expect both(Ok(2), Ok(5)) == 3 & both(Ok(5), Ok(2)) == 0 & both(Err(Gone), Ok(1)) == 0
expect word("get") == 1 & word("fetch") == 1 & word("put") == 0
expect last([4, 7]) == 7 & last([4, 70]) == 0 & last([]) == 0
expect inner(Ok(6)) == 6 & inner(Err(Gone)) == 0
expect limited(Ok(3), 9) == 4 & limited(Err(Gone), 9) == 9
expect capped(Ok(9), 9) & !capped(Ok(3), 9)
expect [1, 2] is [_, *_] & !([] is [_, *_])

# `condition else …`, a block's line: the lines after it go on where the
# condition holds, seeing what it bound, and the `else` leaves where it
# fails, by `return`, its value any expression, a block among them.
head_doubled : List(Nat) -> Nat
head_doubled(xs) -> (
  xs is [x, *_] else return 0
  doubled = x * 2
  doubled + 1
)

checked : (Str, Nat) -> Result(Nat, [Invalid])
checked(name, limit) -> (
  name.starts_with("_") else return Err(Invalid)
  Nat.from_str(name.drop_prefix("_")) is Ok(n) & n < limit else return (
    reason = Invalid
    Err(reason)
  )
  Ok(n)
)

expect head_doubled([4, 5]) == 9 & head_doubled([]) == 0
expect checked("_12", 20) == Ok(12) & checked("x", 20) == Err(Invalid) & checked("_30", 20) == Err(Invalid)

# A name both sides of an `|` bind is seen where either held.
Shape : [Circle(Nat), Square(Nat), Dot]

size : Shape -> Nat
size(shape) -> if shape is Circle(n) | shape is Square(n) then n else 0

expect size(Circle(3)) == 3 & size(Square(4)) == 4 & size(Dot) == 0

# `value is ( arms )`: the first arm whose pattern matches, and whose guard
# holds, answers. An arm is a line; its value may be a block.
Reading : [Celsius(Nat), Kelvin(Nat), Missing]

described : Reading -> Str
described(reading) -> reading is (
  Celsius(0) -> "freezing"
  Celsius(c) if c > 30 -> "hot"
  Celsius(c) | Kelvin(c) -> "${c} degrees"
  Missing -> (
    note = "no reading"
    note
  )
)

expect described(Celsius(0)) == "freezing" & described(Celsius(35)) == "hot"
expect described(Kelvin(300)) == "300 degrees" & described(Missing) == "no reading"

# A binding naming a name in scope assigns it, from there on: past the
# branch it was assigned in, and below a line's `else`.
tally : (List(Nat), Bool) -> (Nat, Nat)
tally(xs, strict) -> (
  count = xs.len()
  total = xs.sum()
  total = if strict then (
    count = count + 1
    total * 2
  ) else total
  (count, total)
)

expect tally([1, 2], True) == (3, 6) & tally([1, 2], False) == (2, 3)

# `if condition return …`, a block's line, leaves where its condition holds,
# what the condition bound seen by the leave alone; the lines after it go on
# where it fails.
explained : Result(Nat, [Bad(Str)]) -> Str
explained(r) -> (
  if r is Err(Bad(why)) return "bad: ${why}"
  if r is Ok(0) return "nothing"
  "some"
)

expect explained(Err(Bad("x"))) == "bad: x" & explained(Ok(0)) == "nothing" & explained(Ok(2)) == "some"
