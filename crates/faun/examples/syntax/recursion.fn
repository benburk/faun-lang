# Iteration is recursion, a fold, or a library function: there are no
# loops. A clause takes a list apart a case at a time, its tail call runs
# in constant stack, and a name bound again shadows the one before it to
# the end of its block.

summed : List(Nat) -> Nat
summed([]) -> 0
summed([x, *xs]) -> x + summed(xs)

expect summed([1, 2, 3]) == 6 & summed([]) == 0

# A worklist taken apart a head at a time, what it has seen handed on.
counted : (List(Nat), Nat) -> Nat
counted([], seen) -> seen
counted([_, *ready], seen) -> counted(ready, seen + 1)

expect counted([5, 6, 7], 0) == 3

# A walk that stops early is a fold that stops: `fold_until`'s step answers
# `Continue` to go on and `Stop` to answer at once.
evens_until : (List(Nat), Nat) -> Nat
evens_until(xs, stop) -> xs.fold_until(0, |total, x| if x == stop then Stop(total) else if x % 2 == 0 then Continue(total + x) else Continue(total))

first_over : (List(Nat), Nat) -> Nat
first_over(xs, limit) -> xs.find(|x| x > limit).ok_or(0)

expect evens_until([1, 2, 3, 4, 9, 6], 9) == 6
expect first_over([1, 5, 9], 4) == 5 & first_over([1], 4) == 0

# A walk inside a walk: each pair's count, summed.
pairs_below : List((Nat, Nat)) -> Nat
pairs_below(pairs) -> pairs.map(|(low, high)| List.range(high).count(|n| n >= low)).sum()

expect pairs_below([(1, 3), (0, 2)]) == 4

# Kahn's algorithm, the graph a list of each node's targets. Each step
# answers the state it hands the next, and a node's edges are a fold.
Kahn = {ready: List(Nat), degrees: Map(Nat, Nat)}

toposort : List(List(Nat)) -> Result(List(Nat), [Cycle])
toposort(graph) -> (
  nodes = List.range(graph.len())
  degrees = Map.counted(graph.flatten())
  ready = nodes.filter(|node| degrees.get_or(node, 0) == 0)
  order = taken(graph, {ready, degrees}, [])
  if order.len() == nodes.len() then Ok(order) else Err(Cycle)
)

taken : (List(List(Nat)), Kahn, List(Nat)) -> List(Nat)
taken(_, {ready: [], *}, order) -> order
taken(graph, {ready: [node, *ready], degrees}, order) -> (
  next = graph.get_or(node, []).fold({ready, degrees}, released)
  taken(graph, next, order.append(node))
)

released : (Kahn, Nat) -> Kahn
released({ready, degrees}, target) -> (
  degrees = degrees.update(target, |degree| degree - 1)
  if degrees.get_or(target, 0) > 0 then {ready, degrees} else {ready: [target, *ready], degrees}
)

expect toposort([[1, 2], [2], []]) == Ok([0, 1, 2]) & toposort([[1], [0]]) == Err(Cycle)

# A lambda's parameters are its own, so a fold may name its record's fields
# as the names it folds into.
mean : List(Nat) -> Nat
mean(xs) -> (
  total = 0
  count = 0
  {total, count} = xs.fold({total, count}, |{total, count}, x| {total: total + x, count: count + 1})
  if count == 0 then 0 else total / count
)

expect mean([2, 4, 9]) == 5 & mean([]) == 0

# A fold whose step may fail stops at the first failure.
parsed_sum : List(Str) -> Result(Nat, [Malformed])
parsed_sum(texts) -> texts.try_fold(0, |total, text| Nat.from_str(text).map_ok(|n| total + n))

expect parsed_sum(["1", "2"]) == Ok(3) & parsed_sum(["1", "x"]) == Err(Malformed)

# Arms counting both ways at once, folded.
signs : List(Int) -> (Nat, Nat)
signs(xs) -> xs.fold((0, 0), |(below, above), x| x is (
  0 then (below, above)
  _..-1 then (below + 1, above)
  _ then (below, above + 1)
))

expect signs([-2, 0, 3, 4]) == (1, 2)

# A name bound again shadows the one before it on the lines below, to the
# end of the block it is bound in: the branch's `n` is the branch's.
shadowed : Nat -> (Nat, Nat)
shadowed(n) -> (
  inner = if n > 0 then (
    n = n * 10
    n + 1
  ) else 0
  (n, inner)
)

expect shadowed(2) == (2, 21) & shadowed(0) == (0, 0)
