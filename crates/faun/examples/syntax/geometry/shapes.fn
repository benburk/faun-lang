# A module: what `export` names is all another module may import. `.*`
# exports a type with its constructors and methods.

export {Shape.*, unit_square}

Shape : [Square(Nat), Oblong(Nat, Nat)].(
  area : Shape -> Nat
  area(Square(side)) -> side * side
  area(Oblong(width, height)) -> width * height
)

unit_square : Shape
unit_square() -> Square(1)

hidden : Nat
hidden() -> 0
