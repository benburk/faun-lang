# Loops: `for` walks a list, `while` runs while its condition holds. A name
# bound before a loop and again in its body carries from round to round and
# out of the loop; one first bound in the body is the round's.

summed : List(Nat) -> Nat
summed(xs) -> (
  total = 0
  for x in xs do (
    total = total + x
  )
  total
)

expect summed([1, 2, 3]) == 6 & summed([]) == 0

# `while` with a test, whose names the round sees: a worklist taken apart a
# head at a time, the test binding its rest again as `=` would.
counted : List(Nat) -> Nat
counted(ready) -> (
  seen = 0
  while ready is [_, *ready] do (
    seen = seen + 1
  )
  seen
)

expect counted([5, 6, 7]) == 3

# `if c continue` ends the round, `if c break` the loop, and `return`
# answers the clause from inside any loop; each may end a round, and so may
# `c else continue`.
evens_until : (List(Nat), Nat) -> Nat
evens_until(xs, stop) -> (
  total = 0
  for x in xs do (
    if x == stop break
    x % 2 == 0 else continue
    total = total + x
  )
  total
)

# A name bound before the loop that `for` names its element with carries
# out of it, as any name the round binds again: here, the last element
# taken.
last_taken : List(Nat) -> Nat
last_taken(xs) -> (
  x = 0
  for x in xs do (
    if x > 5 break
  )
  x
)

expect last_taken([1, 7, 2]) == 7 & last_taken([1, 2]) == 2 & last_taken([]) == 0

# A name the round binds again at another type is held to one only where
# something reads it after: `x` is a `Str`, then each `Nat` taken.
tallied : (Str, List(Nat)) -> Nat
tallied(x, xs) -> (
  total = x.to_utf8().len()
  for x in xs do (
    total = total + x
  )
  total
)

expect tallied("ab", [3, 4]) == 9

first_over : (List(Nat), Nat) -> Nat
first_over(xs, limit) -> (
  for x in xs do (
    if x > limit return x
  )
  0
)

expect evens_until([1, 2, 3, 4, 9, 6], 9) == 6
expect first_over([1, 5, 9], 4) == 5 & first_over([1], 4) == 0

# Loops nest, and a pattern takes each element apart.
pairs_below : List((Nat, Nat)) -> Nat
pairs_below(pairs) -> (
  count = 0
  for (low, high) in pairs do (
    for n in List.range(high) do (
      if n < low continue
      count = count + 1
    )
  )
  count
)

expect pairs_below([(1, 3), (0, 2)]) == 4

# Kahn's algorithm, the graph a list of each node's targets.
toposort : List(List(Nat)) -> Result(List(Nat), [Cycle])
toposort(graph) -> (
  nodes = List.range(graph.len())
  degrees = Map.counted(graph.flatten())
  ready = nodes.filter(|node| degrees.get_or(node, 0) == 0)
  order = []
  while ready is [node, *ready] do (
    order = order.append(node)
    for target in graph.get_or(node, []) do (
      degrees = degrees.update(target, |degree| degree - 1)
      if degrees.get_or(target, 0) > 0 continue
      ready = ready.prepend(target)
    )
  )
  if order.len() == nodes.len() then Ok(order) else Err(Cycle)
)

expect toposort([[1, 2], [2], []]) == Ok([0, 1, 2]) & toposort([[1], [0]]) == Err(Cycle)

# A lambda's parameters are its own, so a fold may name its record's fields
# as the names it folds into.
mean : List(Nat) -> Nat
mean(xs) -> (
  total = 0
  count = 0
  {total, count} = xs.fold({total, count}, |{total, count}, x| {total: total + x, count: count + 1})
  if count == 0 then 0 else total / count
)

expect mean([2, 4, 9]) == 5 & mean([]) == 0

# A block whose last line is a binding, a leaving line or a loop answers
# `{}`: arms that only assign need no answer of their own.
signs : List(Int) -> (Nat, Nat)
signs(xs) -> (
  below = 0
  above = 0
  for x in xs do (
    x is (
      0 continue
      _..-1 then (below = below + 1)
      _ then (above = above + 1)
    )
  )
  (below, above)
)

expect signs([-2, 0, 3, 4]) == (1, 2)
