# Advent of Code 2015, day 1: Not Quite Lisp.
# Input is read as bytes; `(` raises the floor and `)` lowers it.

import std.host {Host}

step : U8 -> Int
step(40) -> 1
step(41) -> -1
step(_) -> 0

part1 : Str -> Int
part1(input) -> input.to_utf8().fold(0 |floor byte| floor + step(byte))

# The position of the first step into the basement, counting from one;
# nought where Santa never goes there.
part2 : Str -> Nat
part2(input) -> basement(input.to_utf8() 0 1)

basement : List(U8) Int Nat -> Nat
basement([] _ _) -> 0
basement([byte *rest] floor position) ->
  next = floor + step(byte)
  entered(next == -1 rest next position)

entered : Bool List(U8) Int Nat -> Nat
entered(True _ _ position) -> position
entered(False rest floor position) -> basement(rest floor position + 1)

main! : Host -> []
main!(host) ->
  read = host.stdin.read_to_str!()
  input = read.ok_or("")
  said = host.stdout.write_all!("part1: ${part1(input)} part2: ${part2(input)}\n".to_utf8())
  host.exit!(0)
