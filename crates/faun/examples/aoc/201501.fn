# Advent of Code 2015, day 1: Not Quite Lisp.
# Input is inspected as UTF-8 bytes; `(` raises the floor and `)` lowers it.

step : U8 -> Int
step('(') -> 1
step(')') -> -1
step(_) -> 0

parse : Str -> List(Int)
parse(input) -> input.to_utf8().map(step)

part1 : Str -> Int
part1(input) -> parse(input).sum()

part2 : Str -> Nat
part2(input) -> parse(input)
  .trail(0, Int.add)
  .find_index(|floor| floor == -1)
  .map_ok(|index| index + 1)
  .ok_or(0)

app : {stdin: List(U8), *} -> Result({part1: Int, part2: Nat}, _)
app(input) -> (
  stdin = Str.from_ascii(input.stdin)?
  Ok({part1: part1(stdin), part2: part2(stdin)})
)

main!(host) -> host.run_stdin!(app)
