# Advent of Code 2015, day 10: Elves Look, Elves Say.
# Each round reads the previous sequence aloud: every run of equal digits
# becomes the run's length then its digit. The scanner appends in forward
# order: the backend keeps a uniquely owned sequence growing in place, so
# each of round forty's quarter-million digits costs amortised constant
# time — where a prepend-and-reverse accumulator copies the buffer per
# element and turns the round quadratic. Tail recursion runs as a loop.
emit : (Nat, U8, List(U8)) -> List(U8)
emit(seen, digit, out) ->
  out.extend(seen.to_str().to_utf8()).append(digit)

say : (List(U8), U8, Nat, List(U8)) -> List(U8)
say([next, *rest], digit, seen, out) if next == digit -> say(rest, digit, seen + 1, out)
say([next, *rest], digit, seen, out) -> say(rest, next, 1, emit(seen, digit, out))
say([], digit, seen, out) -> emit(seen, digit, out)

step : List(U8) -> List(U8)
step([first, *rest]) -> say(rest, first, 1, [])
step([]) -> []

play : (List(U8), Nat) -> List(U8)
play(digits, rounds) -> rounds.times(digits, step)

part1 : Str -> Nat
part1(input) -> play(input.trim().to_utf8(), 40).len()

part2 : Str -> Nat
part2(input) -> play(input.trim().to_utf8(), 50).len()

# Part two is ten more readings of part one's sequence, so main plays the
# first forty rounds once and both answers share them.
app : {stdin: List(U8), *} -> Result({part1: Nat, part2: Nat}, _)
app(input) ->
  stdin = Str.from_ascii(input.stdin)?
  forty = play(stdin.trim().to_utf8(), 40)
  Ok({part1: forty.len(), part2: play(forty, 10).len()})

# The published chain, one reading at a time, then five at once.
expect step("1".to_utf8()) == "11".to_utf8()
expect step("11".to_utf8()) == "21".to_utf8()
expect step("21".to_utf8()) == "1211".to_utf8()
expect step("1211".to_utf8()) == "111221".to_utf8()
expect step("111221".to_utf8()) == "312211".to_utf8()
expect play("1".to_utf8(), 5) == "312211".to_utf8()
# A run longer than nine digits reads as a multi-digit count.
expect step("11111111111".to_utf8()) == "111".to_utf8()

main!(host) -> host.run_stdin!(app)
