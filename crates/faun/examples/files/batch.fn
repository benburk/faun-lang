# Files opened by one recursion and closed by another, each walking its
# list a clause at a time. The files opened so far go back up as a list,
# and a walk over them uses each up. A test takes apart what opening
# answered, and arms say what reading met. Every file opened is closed
# once, which is checked, not trusted.

import std.host {Host, File, Files, Mode.*}

main! : Host -> []
main!(host) -> (
  names = ["a.txt", "../outside.txt", "b.txt"]
  written = batch!(host.files, names)
  echoed = echoed!(host, names)
  host.exit!(U8.of_nat(written))
)

# Each name that opens, written its own name and closed: how many were.
batch! : (Files, List(Str)) -> Nat
batch!(files, names) -> (
  opened = opening!(files, names)
  writing!(opened)
)

# Each of `names` that opens for writing, with its file.
opening! : (Files, List(Str)) -> List((Str, File))
opening!(_, []) -> []
opening!(files, [name, *names]) -> (
  opened = files.open!(name, Overwrite)
  rest = opening!(files, names)
  opened is (
    Ok(file) then [(name, file), *rest]
    Err(_) then rest
  )
)

# How many of `opened` were written their name and closed well. Each is
# closed, whatever writing it met.
writing! : List((Str, File)) -> Nat
writing!([]) -> 0
writing!([(name, file), *opened]) -> (
  wrote = file.write_all!("${name}\n".to_utf8())
  closed = file.close!()
  others = writing!(opened)
  if wrote is Ok(_) & closed is Ok(_) then others + 1 else others
)

# What each of `names` holds, written out in turn.
echoed! : (Host, List(Str)) -> {}
echoed!(_, []) -> {}
echoed!(host, [name, *names]) -> (
  text = read_back!(host.files, name)
  said = host.stdout.write_all!(text)
  echoed!(host, names)
)

# What `name` holds, or nothing where it cannot be opened or read.
read_back! : (Files, Str) -> List(U8)
read_back!(files, name) -> files.open!(name, Read) is (
  Ok(file) then (
    read = file.read_to_end!()
    closed = file.close!()
    if read is Ok(bytes) then bytes else []
  )
  Err(_) then []
)
