# 16-bit words: the ring of naturals modulo 65536, wrapping by definition
# rather than overflowing. The wrapper is private, so every `U16` is below
# its modulus; a numeral builds one through `of_nat`, and one written at or
# above `numerals_below` is refused rather than wrapped.

import hasher {Hasher}

export {U16}

numerals_below : Nat
numerals_below() -> 65536

U16 : Nat.(
  zero : U16
  zero() -> U16(0)

  of_nat : Nat -> U16
  of_nat(n) -> U16(n % 65536)

  to_nat : U16 -> Nat
  to_nat(U16(value)) -> value

  add : (U16, U16) -> U16
  add(U16(a), U16(b)) -> U16((a + b) % 65536)

  sub : (U16, U16) -> U16
  sub(U16(a), U16(b)) -> U16((a + 65536 - b) % 65536)

  mul : (U16, U16) -> U16
  mul(U16(a), U16(b)) -> U16((a * b) % 65536)

  div : (U16, U16) -> U16
  div(U16(a), U16(b)) -> U16(a / b)

  mod : (U16, U16) -> U16
  mod(U16(a), U16(b)) -> U16(a % b)

  cmp : (U16, U16) -> Order

  to_str : U16 -> Str

  # Bitwise, as `Nat`'s: `a & b`, `a | b` and `a ^ b`. Two words' bits
  # make a word, so the remainder changes nothing and costs nothing; it
  # says the answer is one even where a word's range is still being
  # worked out round a loop.
  and : (U16, U16) -> U16
  and(U16(a), U16(b)) -> U16((a & b) % 65536)

  or : (U16, U16) -> U16
  or(U16(a), U16(b)) -> U16((a | b) % 65536)

  xor : (U16, U16) -> U16
  xor(U16(a), U16(b)) -> U16((a ^ b) % 65536)

  # Every bit flipped.
  not : U16 -> U16
  not(U16(a)) -> U16(65535 - a)

  # The bits moved up by `amount`, those past the top lost: nought where
  # `amount` is the width or more.
  shift_left : (U16, Nat) -> U16
  shift_left(U16(a), amount) if amount < 16 -> of_nat(a * 2.pow(amount))
  shift_left(_, _) -> U16(0)

  # The bits moved down by `amount`, those below the bottom lost.
  shift_right : (U16, Nat) -> U16
  shift_right(U16(a), amount) if amount < 16 -> U16(a / 2.pow(amount))
  shift_right(_, _) -> U16(0)

  # The bits moved up by `amount`, those past the top coming round to the
  # bottom. The width round is no change.
  rotate_left : (U16, Nat) -> U16
  rotate_left(U16(a), amount) ->
    # The bits moved up, below the width, and those past it, above.
    moved = a * 2.pow(amount % 16)
    U16(moved % 65536 + moved / 65536)

  rotate_right : (U16, Nat) -> U16
  rotate_right(word, amount) -> rotate_left(word, 16 - amount % 16)

  # `hasher` with `a` fed: widened to a word.
  # `n` as a word when it fits, and a refusal when it does not: the
  # checked narrowing, for values worked out at run time.
  from_nat : Nat -> Result(U16, [TooBig])
  from_nat(n) if n < 0x10000 -> Ok(of_nat(n))
  from_nat(_) -> Err(TooBig)

  # `base` raised to the `exponent`-th power, modulo 0x10000, by
  # `Nat.pow_mod`, so no intermediate grows past the ring.
  pow : (U16, Nat) -> U16
  pow(U16(base), exponent) -> U16(base.pow_mod(exponent, 0x10000))

  # The smaller of `a` and `b`.
  min : (U16, U16) -> U16
  min(U16(a), U16(b)) -> U16(a.min(b))

  # The larger of `a` and `b`.
  max : (U16, U16) -> U16
  max(U16(a), U16(b)) -> U16(a.max(b))

  # `word` as a `U16`; widening cannot wrap.
  of_u8 : U8 -> U16
  of_u8(word) -> U16(U8.to_nat(word))

  # The word's 2 bytes, least significant first. The count is the
  # contract, so the shape says it, and taking the tuple apart always matches.
  le_bytes : U16 -> (U8, U8)
  le_bytes(word) -> (
    U8.of_nat(to_nat(word)),
    U8.of_nat(to_nat(shift_right(word, 8))),
  )

  # The word whose little-endian bytes are these, least significant first.
  # The arity makes the width static, so every input converts.
  of_le_bytes : (U8, U8) -> U16
  of_le_bytes(a, b) ->
    of_u8(a) |
    shift_left(of_u8(b), 8)

  hash_into : (U16, h) -> h where Hasher(h)
  hash_into(a, hasher) -> hasher.write_u64(U64.of_nat(to_nat(a)))
)

expect U8.of_nat(3).pow(5) == 243 & U8.of_nat(3).pow(6) == 217 & U16.of_nat(2).pow(16) == 0
expect U16.of_nat(0xabcd).le_bytes() == (0xcd, 0xab)
