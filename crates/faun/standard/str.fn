# Strings are UTF-8 bytes in a nominal wrapper. String syntax alone may build
# the private Str and U8 wrappers directly; everything else reaches a string
# through these methods, and cannot take one apart by shape.

import hasher {Hasher}

export {Str}

Str : List(U8).(
  # The number of bytes, which for text beyond ASCII is more than the
  # number of characters.
  len : Str -> Nat
  len(Str(bytes)) -> bytes.len()

  concat : (Str, Str) -> Str
  concat(Str(left), Str(right)) -> Str(left.extend(right))

  to_str : Str -> Str
  to_str(text) -> text

  # The bytes the string is, first to last.
  to_utf8 : Str -> List(U8)
  to_utf8(Str(bytes)) -> bytes

  # Byte order: the first differing byte decides, and a string comes before
  # every string extending it. UTF-8 keeps that codepoint order. It is not
  # a collation.
  cmp : (Str, Str) -> Order
  cmp(Str(left), Str(right)) -> bytes_cmp(left, right)

  # `hasher` with the string fed: its bytes, after their count.
  # Whether every byte is ASCII, below 0x80.
  is_ascii : List(U8) -> Bool
  is_ascii(bytes) -> bytes.all(|byte| byte.to_nat() < 128)

  # Whether `bytes` is well-formed UTF-8: `from_utf8`'s test without the
  # wrapping.
  is_utf8 : List(U8) -> Bool
  is_utf8(bytes) -> utf8(bytes, 0, 128, 191)

  hash_into : (Str, h) -> h where Hasher(h)
  hash_into(Str(bytes), hasher) -> hasher.write_bytes(bytes)

  equals : (Str, Str) -> Bool
  equals(left, right) -> cmp(left, right).eq()

  # `Ok` of the bytes as a string where every one is ASCII, which is always
  # valid UTF-8.
  from_ascii : List(U8) -> Result(Str, [NotAscii])
  from_ascii(bytes) if bytes.all(|byte| byte.to_nat() < 128) -> Ok(Str(bytes))
  from_ascii(_) -> Err(NotAscii)

  # The bytes written as hexadecimal, two lowercase digits each, as a
  # digest is shown: `Str.hex([0x0f, 0xa0])` is `"0fa0"`.
  hex : List(U8) -> Str
  hex(bytes) -> Str(bytes.flat_map(|byte| [hex_digit(byte / 16), hex_digit(byte % 16)]))

  # `Ok` of the bytes as a string where they are well-formed UTF-8.
  from_utf8 : List(U8) -> Result(Str, [InvalidUtf8])
  from_utf8(bytes) if utf8(bytes, 0, 128, 191) -> Ok(Str(bytes))
  from_utf8(_) -> Err(InvalidUtf8)

  is_empty : Str -> Bool
  is_empty(Str(bytes)) -> bytes.is_empty()

  # The pieces with `separator` between neighbours, written
  # `Str.join(pieces, separator)`. Valid pieces and a valid separator meet
  # only where one character ends and the next begins.
  join : (List(Str), Str) -> Str
  join(pieces, Str(separator)) -> Str(pieces.map(to_utf8).join(separator))

  # The text `count` times over.
  repeat : (Str, Nat) -> Str
  repeat(text, count) -> join(List.repeat(text, count), "")

  # The text with spaces after it, before it, or either side to fill
  # `width` characters, as `${value:<12}`, `${value:>7}` and `${value:^9}`
  # write. Text already that wide is left as it is. A character is a Unicode
  # scalar: one a terminal shows two columns wide, or one joining its
  # neighbour, still counts once.
  pad_end : (Str, Nat) -> Str
  pad_end(text, width) -> text.concat(" ".repeat(width - scalars(text)))

  pad_start : (Str, Nat) -> Str
  pad_start(text, width) -> " ".repeat(width - scalars(text)).concat(text)

  # An odd space left over goes after.
  center : (Str, Nat) -> Str
  center(text, width) ->
    free = width - scalars(text)
    before = " ".repeat(free / 2)
    after = " ".repeat(free - free / 2)
    join([before, text, after], "")

  # Cutting and matching below go byte by byte, and are sound for text
  # anyway: no byte continuing a character equals a byte beginning one, so
  # a match never begins inside a character.

  starts_with : (Str, Str) -> Bool
  starts_with(Str(bytes), Str(prefix)) -> strip_prefix(bytes, prefix).is_ok()

  ends_with : (Str, Str) -> Bool
  ends_with(Str(bytes), Str(suffix)) -> strip_prefix(bytes.reverse(), suffix.reverse()).is_ok()

  # The text without `prefix` where it begins with it, and as it is where
  # it does not.
  drop_prefix : (Str, Str) -> Str
  drop_prefix(Str(bytes), Str(prefix)) -> Str(strip_prefix(bytes, prefix).ok_or(bytes))

  # The text without `suffix` where it ends with it, and as it is where it
  # does not.
  drop_suffix : (Str, Str) -> Str
  drop_suffix(Str(bytes), Str(suffix)) ->
    stripped = strip_prefix(bytes.reverse(), suffix.reverse())
    Str(stripped.map_ok(|kept| kept.reverse()).ok_or(bytes))

  # The pieces between each `separator`, empty ones kept, so there is one
  # more piece than separators. An empty separator leaves the text whole.
  split : (Str, Str) -> List(Str)
  split(text, Str([])) -> [text]
  split(Str(bytes), Str([first, *more])) -> split_into(bytes, (first, more), [], [])

  # The lines, each without its end, which is `\n` or `\r\n`. A final line
  # end ends the last line rather than beginning an empty one, and a `\r`
  # anywhere else is kept.
  lines : Str -> List(Str)
  lines(Str(bytes)) -> lines_into(bytes, [], [])

  # The text without the ASCII white space at either end: space, tab, line
  # feed, carriage return, vertical tab and form feed.
  trim : Str -> Str
  trim(Str(bytes)) -> Str(bytes.drop_while(space).reverse().drop_while(space).reverse())
)

# Whether `bytes` finish well-formed UTF-8, owing `owed` continuation bytes,
# the first of them from `low` to `high`: a lead byte says how many follow,
# and the first of them keeps out overlong forms, surrogates, and anything
# past U+10FFFF. One definition calling itself, so a long text is a loop.
utf8 : (List(U8), Nat, Nat, Nat) -> Bool
utf8([], 0, _, _) -> True
utf8([0x00..0x7f, *rest], 0, _, _) -> utf8(rest, 0, 128, 191)
utf8([0xc2..0xdf, *rest], 0, _, _) -> utf8(rest, 1, 128, 191)
utf8([0xe0, *rest], 0, _, _) -> utf8(rest, 2, 160, 191)
utf8([0xe1..0xec, *rest], 0, _, _) -> utf8(rest, 2, 128, 191)
utf8([0xed, *rest], 0, _, _) -> utf8(rest, 2, 128, 159)
utf8([0xee..0xef, *rest], 0, _, _) -> utf8(rest, 2, 128, 191)
utf8([0xf0, *rest], 0, _, _) -> utf8(rest, 3, 144, 191)
utf8([0xf1..0xf3, *rest], 0, _, _) -> utf8(rest, 3, 128, 191)
utf8([0xf4, *rest], 0, _, _) -> utf8(rest, 3, 128, 143)
utf8([byte, *rest], Succ(owed), low, high) if between(byte, low, high) -> utf8(rest, owed, 128, 191)
utf8(_, _, _, _) -> False

# `Ok` of what follows `prefix` in `bytes`, where they begin with it.
strip_prefix : (List(U8), List(U8)) -> Result(List(U8), [Mismatch])
strip_prefix(bytes, []) -> Ok(bytes)
strip_prefix([byte, *rest], [wanted, *prefix]) if byte == wanted -> strip_prefix(rest, prefix)
strip_prefix(_, _) -> Err(Mismatch)

# The pieces of `bytes` between each separator, `first` then `more`, where
# the piece so far is `piece` and those finished are `pieces`, both
# backwards. A separator is looked for past a byte equal to its first, so
# what follows one is no longer than the rest after that byte.
split_into : (List(U8), (U8, List(U8)), List(U8), List(Str)) -> List(Str)
split_into([byte, *rest], (first, more), piece, pieces) if byte == first ->
  found = strip_prefix(rest, more)
  split_step(found, byte, rest, ((first, more), piece, pieces))
split_into([byte, *rest], separator, piece, pieces) -> split_into(rest, separator, [byte, *piece], pieces)
split_into([], _, piece, pieces) -> [Str(piece.reverse()), *pieces].reverse()

# A separator where the bytes go on, and a fresh piece after it; or else
# the byte kept in the piece.
split_step : (Result(List(U8), [Mismatch]), U8, List(U8), ((U8, List(U8)), List(U8), List(Str))) -> List(Str)
split_step(Ok(after), _, _, (separator, piece, pieces)) ->
  split_into(after, separator, [], [Str(piece.reverse()), *pieces])
split_step(Err(_), byte, rest, (separator, piece, pieces)) ->
  split_into(rest, separator, [byte, *piece], pieces)

# The lines of `bytes`, the line so far `line` and those finished `lines`,
# both backwards.
lines_into : (List(U8), List(U8), List(Str)) -> List(Str)
lines_into([], [], lines) -> lines.reverse()
lines_into([], line, lines) -> [Str(line.reverse()), *lines].reverse()
lines_into(['\r', '\n', *rest], line, lines) -> lines_into(rest, [], [Str(line.reverse()), *lines])
lines_into(['\n', *rest], line, lines) -> lines_into(rest, [], [Str(line.reverse()), *lines])
lines_into([byte, *rest], line, lines) -> lines_into(rest, [byte, *line], lines)

hex_digit : U8 -> U8
hex_digit(digit) -> "0123456789abcdef".to_utf8().get_or(digit.to_nat(), 0)

space : U8 -> Bool
space(' ' | '\t' | '\n' | '\r' | 11 | 12) -> True
space(_) -> False

# The characters in `text`: each begins with a byte that does not continue
# another.
scalars : Str -> Nat
scalars(Str(bytes)) -> bytes.fold(0, |count, byte| between(byte, 128, 191).select(count, count + 1))

between : (U8, Nat, Nat) -> Bool
between(byte, low, high) -> byte.to_nat() >= low & byte.to_nat() <= high

bytes_cmp : (List(U8), List(U8)) -> Order
bytes_cmp([], []) -> Eq
bytes_cmp([], [_, *]) -> Lt
bytes_cmp([_, *], []) -> Gt
bytes_cmp([a, *left], [b, *right]) -> then_cmp(a.cmp(b), left, right)

then_cmp : (Order, List(U8), List(U8)) -> Order
then_cmp(Eq, left, right) -> bytes_cmp(left, right)
then_cmp(decided, _, _) -> decided

expect "a,b,,c".split(",").len() == 4
expect Str.join("a,b,,c".split(","), "-") == "a-b--c"
expect Str.join("one::two::".split("::"), "|") == "one|two|"
expect "abc".split("") == ["abc"] & "".split(",") == [""]
expect Str.join("x\ny\r\nz\n".lines(), "|") == "x|y|z" & "a\rb".lines() == ["a\rb"]
expect "".lines().is_empty() & "a\n\n".lines() == ["a", ""]
expect "  pad \t\n".trim() == "pad" & "   ".trim().is_empty()
expect "prefix-body".starts_with("prefix") & !"pre".starts_with("prefix")
expect "file.txt".ends_with(".txt") & "file.txt".drop_suffix(".txt") == "file"
expect "--x".drop_prefix("-") == "-x" & "x".drop_prefix("-") == "x"
expect "ab".repeat(3) == "ababab" & "ab".repeat(0) == ""
expect "ab".pad_end(4) == "ab  " & "ab".pad_start(4) == "  ab" & "abcde".pad_start(3) == "abcde"
expect "ab".center(5) == " ab  " & "ab".center(6) == "  ab  " & "".center(1) == " "
expect "é".pad_start(3) == "  é" & "🦌".pad_end(2) == "🦌 "
expect ["pear", "fig", "apple"].sort() == ["apple", "fig", "pear"]
expect Str.is_ascii("abc".to_utf8()) & !Str.is_ascii([0xc3, 0xa9]) & Str.is_utf8([0xc3, 0xa9]) & !Str.is_utf8([0xc3])
expect Str.hex([0x0f, 0xa0, 0x00, 0xff]) == "0fa000ff" & Str.hex([]) == ""
