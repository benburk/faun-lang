# A persistent map sorted by key: the specialty beside `Map`, for keys that
# must come back in order. The key's ordinary `cmp` method supplies the
# order; no runtime dictionary or distinguished key type is involved.
#
# The representation is an AVL tree, and that sentence belongs only here: the
# constructors are not exported, so callers build through `empty`/`insert`/
# `of_list` and observe through `get`/`len`/`to_list`. Every observation is
# stated in key order, which any ordered representation can honour — swapping
# the tree for a B-tree is this file's business alone.
#
# `equals` compares contents, by `to_list`: two maps with the same entries
# may have different shapes (insertion order decides), so the trees
# themselves are never compared.

import bounds {Equatable, Ordered, Printable}

export {SortedMap}

SortedMap(k, v) : [Tip, Bin(SortedMap(k, v), k, v, SortedMap(k, v), Nat)].(
  # The empty map.
  empty : SortedMap(k, v)
  empty = Tip

  # Whether `map` has no entries.
  is_empty : SortedMap(k, v) -> Bool
  is_empty(Tip) -> True
  is_empty(_) -> False

  # The number of entries in `map`.
  len : SortedMap(k, v) -> Nat
  len(Tip) -> 0
  len(Bin(left, _, _, right, _)) -> len(left) + 1 + len(right)

  # The value bound to `key` in `map`: `Ok(value)` when `key` is present;
  # otherwise `Err(Missing)`.
  get : (SortedMap(k, v), k) -> Result(v, [Missing]) where Ordered(k)
  get(Tip, _) -> Err(Missing)
  get(Bin(left, found, value, right, _), key) -> got(key.cmp(found), left, value, right, key)

  # The value bound to `key` in `map`, and `fallback` where it is absent.
  get_or : (SortedMap(k, v), k, v) -> v where Ordered(k)
  get_or(map, key, fallback) -> get(map, key).ok_or(fallback)

  # Whether `key` is bound in `map`.
  contains : (SortedMap(k, v), k) -> Bool where Ordered(k)
  contains(map, key) -> get(map, key).is_ok()

  # `map` with `value` bound to `key`, replacing any existing binding for that
  # key. An existing key keeps its position and takes the new value, so
  # insertion is how callers overwrite.
  insert : (SortedMap(k, v), k, v) -> SortedMap(k, v) where Ordered(k)
  insert(Tip, key, value) -> Bin(Tip, key, value, Tip, 1)
  insert(Bin(left, found, existing, right, depth), key, value) ->
    inserted_at(key.cmp(found), left, found, existing, right, depth, key, value)

  # `map` without any binding for `key`; unchanged when `key` is absent, so
  # removal is idempotent, and it undoes an `insert` of a key that was not
  # bound before: the entries come back, if not the shape.
  remove : (SortedMap(k, v), k) -> SortedMap(k, v) where Ordered(k)
  remove(Tip, _) -> Tip
  remove(Bin(left, found, value, right, _), key) ->
    removed_at(key.cmp(found), left, found, value, right, key)

  # `map` with `key`'s value replaced by `change` applied to it; unchanged
  # when `key` is absent, as `remove` is, and as `Map.update` does.
  update : (SortedMap(k, v), k, v -> v) -> SortedMap(k, v) where Ordered(k)
  update(map, key, change) -> get(map, key).map_ok(|value| insert(map, key, change(value))).ok_or(map)

  # `map` with `key`'s value replaced by `change` applied to it, or to
  # `missing` where `key` is absent, as `Map.update_or` does.
  update_or : (SortedMap(k, v), k, v, v -> v) -> SortedMap(k, v) where Ordered(k)
  update_or(map, key, missing, change) -> insert(map, key, change(get_or(map, key, missing)))

  # The keys of `map` in ascending order.
  keys : SortedMap(k, v) -> List(k)
  keys(map) -> to_list(map).map(|(key, _)| key)

  # The values of `map`, in ascending order of their keys.
  values : SortedMap(k, v) -> List(v)
  values(map) -> to_list(map).map(|(_, value)| value)

  # The result of combining the entries of `map` in ascending key order,
  # beginning with `initial`, each entry as its key and value: the left
  # subtree folded first, then this node, then the right.
  fold : (SortedMap(k, v), a, (a, k, v) -> a) -> a
  fold(Tip, initial, _) -> initial
  fold(Bin(left, key, value, right, _), initial, combine) ->
    fold(right, combine(fold(left, initial, combine), key, value), combine)

  # `map` with each value changed by `change`, its keys and shape as they
  # were.
  map_values : (SortedMap(k, v), v -> w) -> SortedMap(k, w)
  map_values(Tip, _) -> Tip
  map_values(Bin(left, key, value, right, depth), change) ->
    Bin(map_values(left, change), key, change(value), map_values(right, change), depth)

  # The entries of `map` in ascending key order — the map's one observable
  # shape.
  # The entries whose keys are at least `low`, in ascending order, the
  # parts of the tree holding only smaller keys passed over.
  from : (SortedMap(k, v), k) -> List((k, v)) where Ordered(k)
  from(map, low) -> from_onto(map, low, [])

  # The entries whose keys are at least `low` and below `high`, in
  # ascending order, visiting only the parts of the tree that hold them.
  range : (SortedMap(k, v), k, k) -> List((k, v)) where Ordered(k)
  range(map, low, high) -> range_onto(map, low, high, [])

  to_list : SortedMap(k, v) -> List((k, v))
  to_list(map) -> all_onto(map, [])

  # The map as the call building it is written, its entries in ascending
  # key order: `SortedMap.of_list([(1, "a"), (2, "b")])`.
  to_str : SortedMap(k, v) -> Str where
    Printable(k),
    Printable(v)
  to_str(map) -> "SortedMap.of_list(${to_list(map)})"

  # Whether `map` and `other` bind the same keys to equal values: their
  # ascending entries agree, however either was built.
  equals : (SortedMap(k, v), SortedMap(k, v)) -> Bool where
    Equatable(k),
    Equatable(v)
  equals(map, other) -> to_list(map) == to_list(other)

  # The map binding each entry of `entries`, later entries winning exactly as
  # repeated `insert` calls would.
  of_list : List((k, v)) -> SortedMap(k, v) where Ordered(k)
  of_list(entries) -> entries.fold(Tip, |built, (key, value)| insert(built, key, value))

  # The elements of `values` gathered by `key`, as `Map.grouped` gathers
  # them, the groups in ascending key order and each in the order read.
  grouped : (List(v), v -> k) -> SortedMap(k, List(v)) where Ordered(k)
  grouped(values, key) -> (
    gathered = values.fold(Tip, |table, value| update_or(table, key(value), [], |group| [value, *group]))
    map_values(gathered, |group| group.reverse())
  )

  # How many times each of `values` occurs, as `Map.counted` counts, in
  # ascending order of the values.
  counted : List(k) -> SortedMap(k, Nat) where Ordered(k)
  counted(values) -> values.fold(Tip, |tally, value| update_or(tally, value, 0, |count| count + 1))
)

height : SortedMap(k, v) -> Nat
height(Tip) -> 0
height(Bin(_, _, _, _, depth)) -> depth

node : (SortedMap(k, v), k, v, SortedMap(k, v)) -> SortedMap(k, v)
node(left, key, value, right) -> Bin(left, key, value, right, height(left).max(height(right)) + 1)

# Rebuild a node whose children differ in height by at most one more than
# AVL allows (one child just grew by one), restoring the invariant with the
# classic single or double rotation toward the lighter side.
balanced : (SortedMap(k, v), k, v, SortedMap(k, v)) -> SortedMap(k, v)
balanced(left, key, value, right) if height(right) + 1 < height(left) ->
  rotate_right(left, key, value, right)
balanced(left, key, value, right) if height(left) + 1 < height(right) ->
  rotate_left(left, key, value, right)
balanced(left, key, value, right) -> node(left, key, value, right)

# The left child grew. A heavier-or-level inner-left rotates once; a heavier
# inner-right needs the double rotation through it.
rotate_right : (SortedMap(k, v), k, v, SortedMap(k, v)) -> SortedMap(k, v)
rotate_right(Tip, key, value, right) -> node(Tip, key, value, right)
rotate_right(Bin(inner_left, pivot_key, pivot_value, inner_right, _), key, value, right) if height(inner_right) <= height(inner_left) ->
  node(inner_left, pivot_key, pivot_value, node(inner_right, key, value, right))
rotate_right(Bin(inner_left, pivot_key, pivot_value, Tip, depth), key, value, right) ->
  node(Bin(inner_left, pivot_key, pivot_value, Tip, depth), key, value, right)
rotate_right(Bin(inner_left, pivot_key, pivot_value, Bin(middle_left, middle_key, middle_value, middle_right, _), _), key, value, right) ->
  node(
    node(inner_left, pivot_key, pivot_value, middle_left),
    middle_key,
    middle_value,
    node(middle_right, key, value, right),
  )

# The mirror image: the right child grew.
rotate_left : (SortedMap(k, v), k, v, SortedMap(k, v)) -> SortedMap(k, v)
rotate_left(left, key, value, Tip) -> node(left, key, value, Tip)
rotate_left(left, key, value, Bin(inner_left, pivot_key, pivot_value, inner_right, _)) if height(inner_left) <= height(inner_right) ->
  node(node(left, key, value, inner_left), pivot_key, pivot_value, inner_right)
rotate_left(left, key, value, Bin(Tip, pivot_key, pivot_value, inner_right, depth)) ->
  node(left, key, value, Bin(Tip, pivot_key, pivot_value, inner_right, depth))
rotate_left(left, key, value, Bin(Bin(middle_left, middle_key, middle_value, middle_right, _), pivot_key, pivot_value, inner_right, _)) ->
  node(
    node(left, key, value, middle_left),
    middle_key,
    middle_value,
    node(middle_right, pivot_key, pivot_value, inner_right),
  )

# The comparison's verdict walks left, stops, or walks right. The
# children arrive straight from `get`'s pattern, so each walk descends.
got : (Order, SortedMap(k, v), v, SortedMap(k, v), k) -> Result(v, [Missing]) where Ordered(k)
got(Lt, left, _, _, key) -> SortedMap.get(left, key)
got(Eq, _, value, _, _) -> Ok(value)
got(Gt, _, _, right, key) -> SortedMap.get(right, key)

# The comparison's verdict replaces in place or descends, rebalancing the
# grown side. The node arrives as its pieces, and the recursion goes into
# a child.
inserted_at : (Order, SortedMap(k, v), k, v, SortedMap(k, v), Nat, k, v) -> SortedMap(k, v) where Ordered(k)
inserted_at(Eq, left, _, _, right, depth, key, value) -> Bin(left, key, value, right, depth)
inserted_at(Lt, left, found, existing, right, _, key, value) ->
  balanced(SortedMap.insert(left, key, value), found, existing, right)
inserted_at(Gt, left, found, existing, right, _, key, value) ->
  balanced(left, found, existing, SortedMap.insert(right, key, value))

# The comparison's verdict removes here or descends, rebalancing the side
# that did not shrink. The node arrives as its pieces, as for `inserted_at`,
# and the recursion goes into a child.
removed_at : (Order, SortedMap(k, v), k, v, SortedMap(k, v), k) -> SortedMap(k, v) where Ordered(k)
removed_at(Lt, left, found, value, right, key) ->
  balanced(SortedMap.remove(left, key), found, value, right)
removed_at(Gt, left, found, value, right, key) ->
  balanced(left, found, value, SortedMap.remove(right, key))
removed_at(Eq, left, _, _, right, _) -> joined(left, right)

# The two children of a removed node as one tree. Every key on the left is
# below every key on the right, so the right child's smallest entry can take
# the removed node's place and the rest of the right child rebalances beside
# it.
joined : (SortedMap(k, v), SortedMap(k, v)) -> SortedMap(k, v)
joined(left, Tip) -> left
joined(left, Bin(inner_left, key, value, inner_right, _)) -> (
  ((least, least_value), rest) = split_smallest(inner_left, key, value, inner_right)
  balanced(left, least, least_value, rest)
)

# The smallest entry of the node `(left, key, value, right)` and that node
# without it: the entry itself when nothing lies to its left, otherwise the
# one found further left, with the path back up rebalanced.
split_smallest : (SortedMap(k, v), k, v, SortedMap(k, v)) -> ((k, v), SortedMap(k, v))
split_smallest(Tip, key, value, right) -> ((key, value), right)
split_smallest(Bin(inner_left, inner_key, inner_value, inner_right, _), key, value, right) -> (
  (least, rest) = split_smallest(inner_left, inner_key, inner_value, inner_right)
  (least, balanced(rest, key, value, right))
)


# Every entry of `map`, in ascending order, before `after`: the walk goes
# right to left, so each entry is put on the front of what follows it.
all_onto : (SortedMap(k, v), List((k, v))) -> List((k, v))
all_onto(Tip, after) -> after
all_onto(Bin(left, key, value, right, _), after) -> all_onto(left, [(key, value), *all_onto(right, after)])

# The entries whose keys are at least `low`, before `after`.
from_onto : (SortedMap(k, v), k, List((k, v))) -> List((k, v)) where Ordered(k)
from_onto(Tip, _, after) -> after
from_onto(Bin(_, key, _, right, _), low, after) if key < low -> from_onto(right, low, after)
from_onto(Bin(left, key, value, right, _), low, after) -> from_onto(left, low, [(key, value), *all_onto(right, after)])

# The entries whose keys are at least `low` and below `high`, before
# `after`.
range_onto : (SortedMap(k, v), k, k, List((k, v))) -> List((k, v)) where Ordered(k)
range_onto(Tip, _, _, after) -> after
range_onto(Bin(_, key, _, right, _), low, high, after) if key < low -> range_onto(right, low, high, after)
range_onto(Bin(left, key, _, _, _), low, high, after) if key >= high -> range_onto(left, low, high, after)
range_onto(Bin(left, key, value, right, _), low, high, after) ->
  range_onto(left, low, high, [(key, value), *range_onto(right, low, high, after)])

expect SortedMap.counted(["b", "a", "b"]).to_list() == [("a", 1), ("b", 2)]
expect "${SortedMap.counted(["b", "a", "b"])}" == "SortedMap.of_list([(\"a\", 1), (\"b\", 2)])"
expect SortedMap.grouped([1, 2, 3, 4, 5], |n| n % 2).to_list() == [(0, [2, 4]), (1, [1, 3, 5])]
expect SortedMap.of_list([(2, [1])]).update_or(1, [], |xs| [0, *xs]).update_or(2, [], |xs| [0, *xs]).to_list() == [(1, [0]), (2, [0, 1])]
expect SortedMap.of_list([(1, 10)]).update(1, |n| n + 1).update(2, |n| n + 1).to_list() == [(1, 11)]
expect SortedMap.of_list([(2, "b"), (1, "a")]) == SortedMap.of_list([(1, "a"), (2, "b")])
expect SortedMap.of_list([(1, "a")]) != SortedMap.of_list([(1, "b")])
expect SortedMap.of_list([(2, "b"), (1, "a"), (3, "c")]).from(2) == [(2, "b"), (3, "c")]
expect SortedMap.of_list([(2, "b"), (1, "a"), (3, "c")]).range(1, 3) == [(1, "a"), (2, "b")]
