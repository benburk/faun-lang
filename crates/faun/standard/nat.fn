# Unary naturals and the small arithmetic kernel used by the bootstrap
# standard library.

import hasher {Hasher}

export {Nat.*}

Nat : [Zero, Succ(Nat)].(
  zero : Nat
  zero() -> 0

  # A numeral of a generic type is built through its type's `of_nat`, and a
  # natural is already one.
  of_nat : Nat -> Nat
  of_nat(n) -> n

  add : (Nat, Nat) -> Nat
  add(0, y) -> y
  add(Succ(n), y) -> Succ(n + y)

  sub : (Nat, Nat) -> Nat
  sub(0, _) -> 0
  sub(Succ(m), 0) -> Succ(m)
  sub(Succ(m), Succ(n)) -> m - n

  mul : (Nat, Nat) -> Nat
  mul(0, _) -> 0
  mul(Succ(m), y) -> y + m * y

  div : (Nat, Nat) -> Nat
  div(_, 0) -> 0
  div(0, Succ(_)) -> 0
  div(Succ(a), Succ(b)) -> (
    quotient = div(a, Succ(b))
    div_step(nat_same(mod(a, Succ(b)), b), quotient)
  )

  mod : (Nat, Nat) -> Nat
  mod(a, 0) -> a
  mod(0, Succ(_)) -> 0
  mod(Succ(a), Succ(b)) -> (
    remainder = mod(a, Succ(b))
    mod_step(nat_same(remainder, b), remainder)
  )

  # `base` to the `exponent`, squaring the base as the exponent halves: as
  # many steps as the exponent has bits, each going round again. The
  # compiler recognizes the walk, and answers a power as one operation.
  pow : (Nat, Nat) -> Nat
  pow(base, exponent) -> pow_into(base, exponent, 1)

  times : (Nat, a, a -> a) -> a
  times(0, value, _) -> value
  times(Succ(count), value, f) -> times(count, f(value), f)

  # One comparison each way, which the compiler recognizes as instructions,
  # rather than a walk down both counts. `equals` is its `Eq`, which the
  # compiler answers as the one comparison again.
  cmp : (Nat, Nat) -> Order
  cmp(a, b) -> nat_order(nat_below(a, b), nat_same(a, b))

  min : (Nat, Nat) -> Nat
  min(a, b) -> (a <= b).select(a, b)

  max : (Nat, Nat) -> Nat
  max(a, b) -> (a <= b).select(b, a)

  # Bitwise, a bit of the answer for each place either has one: `a & b`,
  # `a | b` and `a ^ b`. Each walk goes on only while both have bits left.
  # The compiler recognizes these walks, and answers each as one
  # instruction on a word, or a digit at a time past one.
  and : (Nat, Nat) -> Nat
  and(a, b) -> and_bits(a, b, 1, 0)

  or : (Nat, Nat) -> Nat
  or(a, b) -> or_bits(a, b, 1, 0)

  xor : (Nat, Nat) -> Nat
  xor(a, b) -> xor_bits(a, b, 1, 0)

  # The decimal text.
  to_str : Nat -> Str
  to_str(n) -> Str.from_ascii(nat_decimal(n)).ok_or("")

  # `Ok` of the number `text` writes in decimal: one digit or more, and
  # nothing else, no sign and no space.
  from_str : Str -> Result(Nat, [Malformed])
  from_str(text) -> nat_digits(text.to_utf8(), 0, False)

  # `hasher` with `n` fed: its value.
  # `Ok(n)` when `i` is the natural `n`; otherwise `Err(Negative)`: the
  # fallible narrowing `Int.of_nat` widens from, where `Int.abs` drops the
  # sign instead.
  from_int : Int -> Result(Nat, [Negative])
  from_int(Pos(n)) -> Ok(n)
  from_int(NegSucc(_)) -> Err(Negative)

  # `base` raised to the `exponent`-th power, modulo `modulus`, each
  # product taken modulo as it is made, so no intermediate grows past it:
  # `pow` then `%` would build `255 ^ 255`, a 2048-bit number, only to
  # throw most of it away. By squaring, as `pow` goes.
  pow_mod : (Nat, Nat, Nat) -> Nat
  pow_mod(base, exponent, modulus) -> pow_mod_into(base % modulus, exponent, 1 % modulus, modulus)

  hash_into : (Nat, h) -> h where Hasher(h)
  hash_into(n, hasher) -> hasher.write_u64(U64.of_nat(n))

)

# The decimal digits of `n`, most significant first.
nat_decimal : Nat -> List(U8)
nat_decimal(n) -> nat_decimal_onto(n, [])

# The decimal digits of `n` before `written`, the least significant taken
# first and put in front, so the walk is a loop holding one number at a
# time however many digits it has. Past a single digit `n` is at least ten,
# so a tenth of it is less.
nat_decimal_onto : (Nat, List(U8)) -> List(U8)
nat_decimal_onto(n, written) if n < 10 -> [U8.of_nat(n + '0'), *written]
nat_decimal_onto(n, written) -> nat_decimal_onto(n / 10, [U8.of_nat(n % 10 + '0'), *written])

# The number `bytes` go on to write, having written `value` so far, and
# whether a digit was seen yet.
nat_digits : (List(U8), Nat, Bool) -> Result(Nat, [Malformed])
nat_digits([], value, seen) -> seen.select(Ok(value), Err(Malformed))
nat_digits([byte, *rest], value, _) if byte.is_digit() ->
  nat_digits(rest, value * 10 + (byte.to_nat() - '0'), True)
nat_digits(_, _, _) -> Err(Malformed)

# The bits of `a` and `b` combined from `place` up, added to `built`, the
# bits below. Each step halves both, and stops where either has none left;
# what is left of the other is then what it keeps.
and_bits : (Nat, Nat, Nat, Nat) -> Nat
and_bits(0, _, _, built) -> built
and_bits(_, 0, _, built) -> built
and_bits(a, b, place, built) -> and_bits(a / 2, b / 2, place * 2, built + a % 2 * (b % 2) * place)

or_bits : (Nat, Nat, Nat, Nat) -> Nat
or_bits(0, b, place, built) -> built + b * place
or_bits(a, 0, place, built) -> built + a * place
or_bits(a, b, place, built) -> (
  low = (a % 2 == 1 | b % 2 == 1).to_nat()
  or_bits(a / 2, b / 2, place * 2, built + low * place)
)

xor_bits : (Nat, Nat, Nat, Nat) -> Nat
xor_bits(0, b, place, built) -> built + b * place
xor_bits(a, 0, place, built) -> built + a * place
xor_bits(a, b, place, built) -> xor_bits(a / 2, b / 2, place * 2, built + (a + b) % 2 * place)

# `built` times `base` to the `exponent`.
pow_into : (Nat, Nat, Nat) -> Nat
pow_into(_, 0, built) -> built
pow_into(base, 1, built) -> built * base
pow_into(base, exponent, built) -> (
  kept = (exponent % 2 == 1).select(built * base, built)
  pow_into(base * base, exponent / 2, kept)
)

# `built` times `base` to the `exponent`, modulo `modulus`.
pow_mod_into : (Nat, Nat, Nat, Nat) -> Nat
pow_mod_into(_, 0, built, _) -> built
pow_mod_into(base, exponent, built, modulus) -> (
  kept = (exponent % 2 == 1).select(built * base % modulus, built)
  pow_mod_into(base * base % modulus, exponent / 2, kept, modulus)
)

# Whether `a` and `b` are one number: a walk down both, which the compiler
# recognizes as one comparison.
nat_same : (Nat, Nat) -> Bool
nat_same(0, 0) -> True
nat_same(0, Succ(_)) -> False
nat_same(Succ(_), 0) -> False
nat_same(Succ(a), Succ(b)) -> nat_same(a, b)

nat_below : (Nat, Nat) -> Bool
nat_below(_, 0) -> False
nat_below(0, Succ(_)) -> True
nat_below(Succ(a), Succ(b)) -> nat_below(a, b)

nat_order : (Bool, Bool) -> Order
nat_order(True, _) -> Lt
nat_order(False, True) -> Eq
nat_order(False, False) -> Gt

div_step(True, quotient) -> Succ(quotient)
div_step(False, quotient) -> quotient

mod_step(True, _) -> 0
mod_step(False, remainder) -> Succ(remainder)

expect Nat.from_str("0").ok_or(9) == 0 & Nat.from_str("007").ok_or(0) == 7
expect Nat.from_str("1234").ok_or(0) == 1234
expect Nat.from_str("").is_err() & Nat.from_str("12a").is_err() & Nat.from_str("-1").is_err()
expect 3.min(5) == 3 & 3.max(5) == 5
# `&`, `|` and `^` bind looser than comparisons, so a bitwise answer is
# compared in parentheses.
expect (12 & 10) == 8 & (12 | 10) == 14 & (12 ^ 10) == 6
expect (0 & 7) == 0 & (0 | 7) == 7 & (7 ^ 7) == 0 & (5 | 0) == 5
expect (1267650600228229401496703205376 | 1) == 1267650600228229401496703205377
expect 2.pow(0) == 1 & 2.pow(10) == 1024 & 3.pow(5) == 243 & 0.pow(0) == 1 & 0.pow(3) == 0
expect (-3).pow(3) == -27 & Nat.pow_mod(3, 200, 1000) == 1 & Nat.pow_mod(5, 0, 1) == 0
expect Nat.from_int(-2) == Err(Negative) & Nat.from_int(4) == Ok(4)
