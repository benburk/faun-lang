# The host x86_64-linux supplies, mounted at `std.host`. `Host` is the authority a
# program is handed. Its fields are startup values the target produces
# before `main!` runs; a field nothing reads is never produced. Its bodyless
# methods are the effects the program may ask of the target.
#
# Standard input, output and error are Ori's streams, and so is a file: a
# read moves some bytes or says the stream has ended, a write moves some
# bytes and answers how many, and either may answer the error it met;
# `read_to_end!` and `write_all!` go on until the stream is done, and on a
# stream that never ends, `read_to_end!` never does either. Each stream is
# what a descriptor names, and the three standard ones are the first three.
#
# What every target shares is in `common.fn`; what is here is Linux's: its
# descriptors, its `open` flags and its error numbers.
#
# A `File` is a resource: what opens one is the program's to close, once,
# on every way it goes on, and nothing is asked of it afterwards.

import hosts.common {Bytes, Chunk, Mode.*, IoError, OpenError, ReadError, WriteError, CloseError, filled, read_chunks!, read_text!, write_everything!, finish!, serve_stdin!}
import bounds {Printable}

export {Host, Stdin, Stdout, Stderr, Files, File, Bytes, Chunk, Mode.*, IoError, OpenError, ReadError, WriteError, CloseError}

# The arguments the program was run with, its own name first.
Host : {args: List(Str)}.(
  # Finish with `status`: nought is done, and anything else says what went
  # wrong. A status is a byte, which is all of one every target keeps.
  exit! : (Host, U8) -> []

  stdin : Host -> Stdin
  stdin(_) -> Stdin

  stdout : Host -> Stdout
  stdout(_) -> Stdout

  stderr : Host -> Stderr
  stderr(_) -> Stderr

  # The files beneath where the program runs.
  files : Host -> Files
  files(_) -> Files

  # `text` on standard output, all of it.
  print! : (Host, Str) -> Result({}, WriteError)
  print!(host, text) -> (
    wrote = host.stdout.write_all!(text.to_utf8())
    went = wrote?
    Ok({})
  )

  # `text` and a line's end on standard output.
  println! : (Host, Str) -> Result({}, WriteError)
  println!(host, text) -> host.print!("${text}\n")

  # Run `app` on the arguments the program was run with, its own name
  # first, and print what it answers and a line's end, finishing with
  # status nought. It
  # declares the fields it reads, `{args: List(Str), *}` or none at all.
  # This is the quick way to a whole program: an app answering a `Result`
  # prints `Ok(...)` or `Err(...)`, which says which it was, and one that
  # must finish with another status writes its own `main!`.
  run! : (Host, {args: List(Str)} -> a) -> [] where Printable(a)
  run!(host, app) -> (
    status = finish!(host.stdout, app({args: host.args}))
    host.exit!(status)
  )

  # The same, having read standard input to its end first, handed to `app`
  # as bytes beside the arguments: an app wanting text asks
  # `Str.from_utf8` itself. Input that cannot be read is reported on
  # standard error, and the app is not run.
  run_stdin! : (Host, {args: List(Str), stdin: List(U8)} -> a) -> [] where Printable(a)
  run_stdin!(host, app) -> (
    input = host.stdin.read_to_end!()
    status = serve_stdin!(host.stdout, host.stderr, input, host.args, app)
    host.exit!(status)
  )
)

Stdin : [Stdin].(
  # Up to `count` bytes, fewer where fewer are ready, or `End` where none
  # are left. Asked for none, it answers none and asks the target nothing.
  read! : (Stdin, Nat) -> Result(Chunk, ReadError)
  read!(_, count) -> read_from!(Fd(0), count)

  # Every byte to the end.
  read_to_end! : Stdin -> Result(List(U8), ReadError)
  read_to_end!(input) -> read_chunks!(input, [])

  # Every byte to the end, as text.
  read_to_str! : Stdin -> Result(Str, [IsADirectory, Other(Nat), InvalidUtf8])
  read_to_str!(input) -> read_text!(input)
)

Stdout : [Stdout].(
  # Some of `bytes`, from the first: how many went.
  write! : (Stdout, List(U8)) -> Result(Nat, WriteError)
  write!(_, bytes) -> put!(Fd(1), bytes)

  # All of `bytes`: how many that is.
  write_all! : (Stdout, List(U8)) -> Result(Nat, WriteError)
  write_all!(output, bytes) -> write_everything!(output, bytes)
)

Stderr : [Stderr].(
  # Some of `bytes`, from the first: how many went.
  write! : (Stderr, List(U8)) -> Result(Nat, WriteError)
  write!(_, bytes) -> put!(Fd(2), bytes)

  # All of `bytes`: how many that is.
  write_all! : (Stderr, List(U8)) -> Result(Nat, WriteError)
  write_all!(output, bytes) -> write_everything!(output, bytes)
)

# Where a program opens files: beneath where it runs, and nowhere else.
Files : [Files].(
  # What `name` names, opened as `mode` says. A name reaching above where
  # the program runs, by `..` or from the root or through a link, is refused
  # as `Escapes`.
  open! : (Files, Str, Mode) -> Result(File, OpenError)
  open!(files, name, mode) -> named!(files, name.to_utf8(), (flags(mode), made(mode)))
)

# An open file: what `Files.open!` answers, and the program's to close.
File : [File(Fd)].(
  # Up to `count` bytes, fewer where fewer are ready, or `End` where none
  # are left. Asked for none, it answers none and asks the target nothing.
  read! : (File, Nat) -> Result(Chunk, ReadError)
  read!(File(fd), count) -> read_from!(fd, count)

  # Some of `bytes`, from the first: how many went.
  write! : (File, List(U8)) -> Result(Nat, WriteError)
  write!(File(fd), bytes) -> put!(fd, bytes)

  # Done with it, whether or not what was written got where it was going:
  # the error closing it met, if any. Nothing may be asked of it after.
  close! : File -> Result({}, CloseError)
  close!(file) -> (
    closed = fd_close!(file)
    outcome(closed).map_ok(|_| {}).map_err(close_error)
  )

  # Every byte to the end.
  read_to_end! : File -> Result(List(U8), ReadError)
  read_to_end!(file) -> read_chunks!(file, [])

  # Every byte to the end, as text.
  read_to_str! : File -> Result(Str, [IsADirectory, Other(Nat), InvalidUtf8])
  read_to_str!(file) -> read_text!(file)

  # All of `bytes`: how many that is.
  write_all! : (File, List(U8)) -> Result(Nat, WriteError)
  write_all!(file, bytes) -> write_everything!(file, bytes)
)

# What Linux names an open stream by. Only this module makes one, so no
# number a program worked out can be handed to a routine as one.
Fd : [Fd(U32)]

# What the target answers for: how many bytes moved, or the descriptor
# opened, or the error met, as `outcome` reads it. Bytes are handed where
# they lie, and a read fills a list of its own, answered beside what the
# target said. A name is handed ended by a nought byte, so one holding a
# nought byte is not handed.
fd_put! : (Fd, List(U8)) -> Nat
fd_read! : (Fd, Nat) -> (List(U8), Nat)
fd_open! : (Files, List(U8), Nat, Nat) -> Nat
fd_close! : File -> Nat

# Linux's `open` flags for each mode, each with `O_CLOEXEC`, so that no file
# the program opens is handed on to a program it starts.
flags : Mode -> Nat
flags(Read) -> 524288
flags(Overwrite) -> 524865
flags(Append) -> 525377
flags(CreateNew) -> 524481
flags(Edit) -> 524290
flags(Load) -> 524354

# Who may read and write a file a mode makes, before the umask: anyone, and
# nought for a mode that makes none, which is what Linux asks of one.
made : Mode -> Nat
made(Read) -> 0
made(Edit) -> 0
made(_) -> 438

# Open `name`, ended by a nought byte as Linux reads one, so none may be in it.
named! : (Files, List(U8), (Nat, Nat)) -> Result(File, OpenError)
named!(_, name, _) if name.contains(0) -> Err(Other(22))
named!(files, name, how) -> opening!(files, name.append(0), how, 8)

# Open `name`, asking again, up to `tries` times, where the kernel was
# interrupted or found the name moving under it.
opening! : (Files, List(U8), (Nat, Nat), Nat) -> Result(File, OpenError)
opening!(files, name, mode is (how, made), tries) -> (
  answer = fd_open!(files, name, how, made)
  opened!(files, name, mode, tries, outcome(answer))
)

opened! : (Files, List(U8), (Nat, Nat), Nat, Result(Nat, Nat)) -> Result(File, OpenError)
opened!(_, _, _, _, Ok(fd)) -> Ok(File(Fd(U32.of_nat(fd))))
opened!(files, name, how, Succ(tries), Err(4)) -> opening!(files, name, how, tries)
opened!(files, name, how, Succ(tries), Err(11)) -> opening!(files, name, how, tries)
opened!(_, _, _, _, Err(code)) -> Err(open_error(code))

# Up to `count` bytes from what `fd` names, and no more than 65536.
read_from! : (Fd, Nat) -> Result(Chunk, ReadError)
read_from!(_, 0) -> Ok(Data([]))
read_from!(fd, count) -> (
  (bytes, answer) = fd_read!(fd, 65536 - (65536 - count))
  filled(bytes, outcome(answer).map_err(read_error))
)

# Some of `bytes` to what `fd` names: how many went.
put! : (Fd, List(U8)) -> Result(Nat, WriteError)
put!(fd, bytes) -> (
  went = fd_put!(fd, bytes)
  outcome(went).map_err(write_error)
)

# What the target answers: a number, or an error number that far short of
# the top of a word, as a kernel answers `-errno`. No error is more than
# 4095, so an answer that far from the top or nearer is one.
outcome : Nat -> Result(Nat, Nat)
outcome(answer) -> answered(answer, answer - 18446744073709547520)

answered : (Nat, Nat) -> Result(Nat, Nat)
answered(answer, 0) -> Ok(answer)
answered(answer, Succ(_)) -> Err(18446744073709551615 - (answer - 1))

# What an error number of Linux's is, to what met it.
open_error : Nat -> OpenError
open_error(1) -> Denied
open_error(2) -> NotFound
open_error(9) -> Denied
open_error(13) -> Denied
open_error(17) -> AlreadyExists
open_error(18) -> Escapes
open_error(20) -> NotADirectory
open_error(21) -> IsADirectory
open_error(28) -> NoSpace
open_error(95) -> Unsupported
open_error(122) -> NoSpace
open_error(code) -> Other(code)

read_error : Nat -> ReadError
read_error(21) -> IsADirectory
read_error(code) -> Other(code)

# A write to a pipe nobody reads is `BrokenPipe`: the target ignores
# `SIGPIPE` before anything runs, so the write answers rather than ending the
# program from inside it.
write_error : Nat -> WriteError
write_error(28) -> NoSpace
write_error(32) -> BrokenPipe
write_error(122) -> NoSpace
write_error(code) -> Other(code)

close_error : Nat -> CloseError
close_error(28) -> NoSpace
close_error(122) -> NoSpace
close_error(code) -> Other(code)
