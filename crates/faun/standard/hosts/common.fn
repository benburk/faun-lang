# What every host module shares: the rows its streams and files answer, how
# a file is opened, and the loops that go on reading or writing until a
# stream is done. A host module imports this and exports what a program
# names. Nothing here reaches a target's routines: each loop is generic over
# the stream it is handed, so it is written once and is the same everywhere.

import bounds {Printable}

export {Bytes, Chunk, Mode.*, IoError, OpenError, ReadError, WriteError, CloseError, filled, read_chunks!, read_text!, write_everything!, finish!, serve_stdin!}

# What a stream or a file moves.
Bytes = List(U8)

# What one read answers: some bytes, or that the stream has ended and no
# more will come.
Chunk = [Data(List(U8)), End]

# How a file is opened: to read it as it is; to write it from nothing, made
# if it is not there; to write after what it holds, made if it is not there;
# to write it made new, refused as `AlreadyExists` if it is there; to read
# and write it as it is; and to read and write it, made if it is not there.
Mode : [Read, Overwrite, Append, CreateNew, Edit, Load]

# What opening a name can meet.
OpenError = [NotFound, Denied, AlreadyExists, NotADirectory, IsADirectory, Escapes, NoSpace, Unsupported, Other(Nat)]

# What reading a stream can meet.
ReadError = [IsADirectory, Other(Nat)]

# What writing a stream can meet.
WriteError = [BrokenPipe, NoSpace, Other(Nat)]

# What closing a file can meet: an error writing it met and did not say.
CloseError = [NoSpace, Other(Nat)]

# Everything any of them can meet, for a program's own signatures, which
# `?` joins each into.
IoError = [NotFound, Denied, AlreadyExists, NotADirectory, IsADirectory, NotEmpty, Escapes, BrokenPipe, NoSpace, Unsupported, Other(Nat)]

# What a read answers, from the bytes the target filled and what it said:
# none is the end, since a read asked for none never reaches the target.
filled : (List(U8), Result(Nat, e)) -> Result(Chunk, e)
filled(_, Err(error)) -> Err(error)
filled([], Ok(_)) -> Ok(End)
filled(bytes, Ok(_)) -> Ok(Data(bytes))

# Every byte to the end, after `read`. Each chunk goes on the end of what
# came before, in place where there is room. A stream that never ends is
# read for as long as it goes on.
read_chunks! : (r, List(U8)) -> Result(List(U8), ReadError) where
  r.read! : (r, Nat) -> Result(Chunk, ReadError)
read_chunks!(input, read) -> (
  got = input.read!(65536)
  read_on!(input, read, got)
)

read_on! : (r, List(U8), Result(Chunk, ReadError)) -> Result(List(U8), ReadError) where
  r.read! : (r, Nat) -> Result(Chunk, ReadError)
read_on!(_, _, Err(error)) -> Err(error)
read_on!(_, read, Ok(End)) -> Ok(read)
read_on!(input, read, Ok(Data(chunk))) -> read_chunks!(input, read.concat(chunk))

# Every byte to the end of what `input` reads, as text.
read_text! : r -> Result(Str, [IsADirectory, Other(Nat), InvalidUtf8]) where
  r.read! : (r, Nat) -> Result(Chunk, ReadError)
read_text!(input) -> (
  read = read_chunks!(input, [])
  bytes = read?
  text = Str.from_utf8(bytes)?
  Ok(text)
)

# All of `bytes`: how many that is.
write_everything! : (w, List(U8)) -> Result(Nat, WriteError) where
  w.write! : (w, List(U8)) -> Result(Nat, WriteError)
write_everything!(output, bytes) -> (
  wrote = write_rest!(output, bytes, bytes.len())
  done = wrote?
  Ok(bytes.len())
)

# Write the last `left` of `bytes` until none are left. Nothing is counted,
# since a total would be a number the host's answers add up to, wider than
# any word a target picks: once it ends well, every byte went. The bytes go
# round unchanged, so bytes known before the program runs are still known on
# every round, and what is left only falls, so it is never more than there
# were.
write_rest! : (w, List(U8), Nat) -> Result({}, WriteError) where
  w.write! : (w, List(U8)) -> Result(Nat, WriteError)
write_rest!(_, _, 0) -> Ok({})
write_rest!(output, bytes, left) -> (
  wrote = output.write!(bytes.drop(bytes.len() - left))
  went = wrote?
  write_on!(output, bytes, left, went)
)

# Go on writing after a write that moved `went`. A stream that took none of
# what it was offered would take none of it again, so that is an I/O error
# rather than a reason to ask again.
write_on! : (w, List(U8), Nat, Nat) -> Result({}, WriteError) where
  w.write! : (w, List(U8)) -> Result(Nat, WriteError)
write_on!(_, _, _, 0) -> Err(Other(5))
write_on!(output, bytes, left, went) -> write_rest!(output, bytes, left - went)

# What a runner finishes with: nought where what it printed was written.
# `value` said on `output`, and a line's end after it.
finish! : (o, a) -> U8 where
  o.write_all! : (o, List(U8)) -> Result(Nat, WriteError),
  Printable(a)
finish!(output, value) -> (
  wrote = output.write_all!("${value}\n".to_utf8())
  written_status(wrote)
)

written_status : Result(Nat, WriteError) -> U8
written_status(Ok(_)) -> 0
written_status(Err(_)) -> 1

# `error: ` and what went wrong, on `errors`: one, or two where even that
# could not be written.
report! : (w, Str) -> U8 where
  w.write_all! : (w, List(U8)) -> Result(Nat, WriteError)
report!(errors, text) -> (
  wrote = errors.write_all!("error: ${text}\n".to_utf8())
  reported_status(wrote)
)

reported_status : Result(Nat, WriteError) -> U8
reported_status(Ok(_)) -> 1
reported_status(Err(_)) -> 2

# Run `app` on the arguments and what standard input held, printing what it
# answers on `output`; input that could not be read is reported on `errors`,
# and the app is not run.
serve_stdin! : (o, w, Result(List(U8), ReadError), List(Str), {args: List(Str), stdin: List(U8)} -> a) -> U8 where
  o.write_all! : (o, List(U8)) -> Result(Nat, WriteError),
  w.write_all! : (w, List(U8)) -> Result(Nat, WriteError),
  Printable(a)
serve_stdin!(_, errors, Err(error), _, _) -> report!(errors, error.to_str())
serve_stdin!(output, _, Ok(input), args, app) -> finish!(output, app({args: args, stdin: input}))
