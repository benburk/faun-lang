# Concrete Boolean utilities. Equality is `cmp`'s, derived with it.

import hasher {Hasher}

export {Bool.*}

Bool : [False, True].(
  not : Bool -> Bool
  not(False) -> True
  not(True) -> False

  and : (Bool, Bool) -> Bool
  and(True, True) -> True
  and(_, _) -> False

  or : (Bool, Bool) -> Bool
  or(False, False) -> False
  or(_, _) -> True

  xor : (Bool, Bool) -> Bool
  xor(True, False) -> True
  xor(False, True) -> True
  xor(_, _) -> False

  select : (Bool, a, a) -> a
  select(True, yes, _) -> yes
  select(False, _, no) -> no

  to_nat : Bool -> Nat
  to_nat(False) -> 0
  to_nat(True) -> 1

  # False before True.
  cmp : (Bool, Bool) -> Order

  to_str : Bool -> Str

  # `hasher` with `a` fed: as 0 or 1, its place.
  hash_into : (Bool, h) -> h where Hasher(h)
)
