# Concrete Boolean utilities. Equality is written out while bodyless method
# derivation remains outside the bootstrap frontend.

import hasher {Hasher}

export {Bool.*}

Bool : [False, True].(
  not : Bool -> Bool
  not(False) -> True
  not(True) -> False

  and : (Bool, Bool) -> Bool
  and(True, True) -> True
  and(_, _) -> False

  or : (Bool, Bool) -> Bool
  or(False, False) -> False
  or(_, _) -> True

  xor : (Bool, Bool) -> Bool
  xor(True, False) -> True
  xor(False, True) -> True
  xor(_, _) -> False

  select : (Bool, a, a) -> a
  select(True, yes, _) -> yes
  select(False, _, no) -> no

  to_nat : Bool -> Nat
  to_nat(False) -> 0
  to_nat(True) -> 1

  # False before True.
  cmp : (Bool, Bool) -> Order
  cmp(False, True) -> Lt
  cmp(True, False) -> Gt
  cmp(_, _) -> Eq

  to_str : Bool -> Str
  to_str(False) -> "False"
  to_str(True) -> "True"

  # `hasher` with `a` fed: as 0 or 1.
  hash_into : (Bool, h) -> h where Hasher(h)
  hash_into(a, hasher) -> hasher.write_u64(U64.of_nat(to_nat(a)))

  equals : (Bool, Bool) -> Bool
  equals(False, False) -> True
  equals(True, True) -> True
  equals(_, _) -> False
)
