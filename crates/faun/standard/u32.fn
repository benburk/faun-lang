# 32-bit words: the ring of naturals modulo 4294967296, wrapping by definition
# rather than overflowing. The wrapper is private, so every `U32` is below
# its modulus; a numeral builds one through `of_nat`, and one written at or
# above `numerals_below` is refused rather than wrapped.

import hasher {Hasher}

export {U32}

numerals_below : Nat
numerals_below() -> 4294967296

U32 : Nat.(
  zero : U32
  zero() -> U32(0)

  of_nat : Nat -> U32
  of_nat(n) -> U32(n % 4294967296)

  to_nat : U32 -> Nat
  to_nat(U32(value)) -> value

  add : (U32, U32) -> U32
  add(U32(a), U32(b)) -> U32((a + b) % 4294967296)

  sub : (U32, U32) -> U32
  sub(U32(a), U32(b)) -> U32((a + 4294967296 - b) % 4294967296)

  mul : (U32, U32) -> U32
  mul(U32(a), U32(b)) -> U32((a * b) % 4294967296)

  div : (U32, U32) -> U32
  div(U32(a), U32(b)) -> U32(a / b)

  mod : (U32, U32) -> U32
  mod(U32(a), U32(b)) -> U32(a % b)

  cmp : (U32, U32) -> Order

  to_str : U32 -> Str

  # Bitwise, as `Nat`'s: `a & b`, `a | b` and `a ^ b`. Two words' bits
  # make a word, so the remainder changes nothing and costs nothing; it
  # says the answer is one even where a word's range is still being
  # worked out round a loop.
  and : (U32, U32) -> U32
  and(U32(a), U32(b)) -> U32((a & b) % 4294967296)

  or : (U32, U32) -> U32
  or(U32(a), U32(b)) -> U32((a | b) % 4294967296)

  xor : (U32, U32) -> U32
  xor(U32(a), U32(b)) -> U32((a ^ b) % 4294967296)

  # Every bit flipped.
  not : U32 -> U32
  not(U32(a)) -> U32(4294967295 - a)

  # The bits moved up by `amount`, those past the top lost: nought where
  # `amount` is the width or more.
  shift_left : (U32, Nat) -> U32
  shift_left(U32(a), amount) if amount < 32 -> of_nat(a * 2.pow(amount))
  shift_left(_, _) -> U32(0)

  # The bits moved down by `amount`, those below the bottom lost.
  shift_right : (U32, Nat) -> U32
  shift_right(U32(a), amount) if amount < 32 -> U32(a / 2.pow(amount))
  shift_right(_, _) -> U32(0)

  # The bits moved up by `amount`, those past the top coming round to the
  # bottom. The width round is no change.
  rotate_left : (U32, Nat) -> U32
  rotate_left(U32(a), amount) ->
    # The bits moved up, below the width, and those past it, above.
    moved = a * 2.pow(amount % 32)
    U32(moved % 4294967296 + moved / 4294967296)

  rotate_right : (U32, Nat) -> U32
  rotate_right(word, amount) -> rotate_left(word, 32 - amount % 32)

  # `hasher` with `a` fed: widened to a word.
  # `n` as a word when it fits, and a refusal when it does not: the
  # checked narrowing, for values worked out at run time.
  from_nat : Nat -> Result(U32, [TooBig])
  from_nat(n) if n < 0x100000000 -> Ok(of_nat(n))
  from_nat(_) -> Err(TooBig)

  # `base` raised to the `exponent`-th power, modulo 0x100000000, by
  # `Nat.pow_mod`, so no intermediate grows past the ring.
  pow : (U32, Nat) -> U32
  pow(U32(base), exponent) -> U32(base.pow_mod(exponent, 0x100000000))

  # The smaller of `a` and `b`.
  min : (U32, U32) -> U32
  min(U32(a), U32(b)) -> U32(a.min(b))

  # The larger of `a` and `b`.
  max : (U32, U32) -> U32
  max(U32(a), U32(b)) -> U32(a.max(b))

  # `word` as a `U32`; widening cannot wrap.
  of_u8 : U8 -> U32
  of_u8(word) -> U32(U8.to_nat(word))

  # `word` as a `U32`; widening cannot wrap.
  of_u16 : U16 -> U32
  of_u16(word) -> U32(U16.to_nat(word))

  # The word's 4 bytes, least significant first. The count is the
  # contract, so the shape says it, and taking the tuple apart always matches.
  le_bytes : U32 -> (U8, U8, U8, U8)
  le_bytes(word) -> (
    U8.of_nat(to_nat(word)),
    U8.of_nat(to_nat(shift_right(word, 8))),
    U8.of_nat(to_nat(shift_right(word, 16))),
    U8.of_nat(to_nat(shift_right(word, 24))),
  )

  # The word whose little-endian bytes are these, least significant first.
  # The arity makes the width static, so every input converts.
  of_le_bytes : (U8, U8, U8, U8) -> U32
  of_le_bytes(a, b, c, d) ->
    of_u8(a) |
    shift_left(of_u8(b), 8) |
    shift_left(of_u8(c), 16) |
    shift_left(of_u8(d), 24)

  hash_into : (U32, h) -> h where Hasher(h)
  hash_into(a, hasher) -> hasher.write_u64(U64.of_nat(to_nat(a)))
)

expect U32.from_nat(4294967296).is_err() & U64.from_nat(18446744073709551615).is_ok()
expect U32.of_nat(0x12345678).le_bytes() == (0x78, 0x56, 0x34, 0x12)
expect U32.of_le_bytes(0x78, 0x56, 0x34, 0x12) == 0x12345678
