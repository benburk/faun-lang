# Bootstrap standard package for the Ori-compatible frontend. It keeps the
# useful arithmetic and polymorphic utilities that do not need method
# constraints, hashing, or bodyless derivation.

package {}

import bool {Bool.*}
import order {Order.*}
import nat {Nat.*}
import int {Int.*}
import u8 {U8}
import u16 {U16}
import u32 {U32}
import u64 {U64}
import list {List.*}
import result {Result.*}
import str {Str}
import float.f32 {F32}
import float.f64 {F64}

exports {Bool.* Order.* Nat.* Int.* U8 U16 U32 U64 List.* Result.* Str F32 F64}
