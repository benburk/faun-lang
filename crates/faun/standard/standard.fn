# Bootstrap standard package for the Ori-compatible frontend. It keeps the
# useful arithmetic and polymorphic utilities that do not need records,
# tuples, method constraints, hashing, or bodyless derivation.

lib {}

import bool {Bool.*}
import never {Never}
import nat {Nat.*}
import int {Int.*}
import u8 {U8}
import list {List.*}
import result {Result.*}
import str {Str}

exports {Bool.* Never Nat.* Int.* U8 List.* Result.* Str}
