# Polymorphic list utilities that need neither tuples, records nor
# constraints. They follow Ori's standard list: the receiver
# comes first, so `xs.get(i)` means `get(xs i)`.
#
# A lookup that can miss answers a `Result` whose error is a structural
# tag naming the miss. A tag belongs to no module, so a caller's own
# failures join it in one row.

exports {List.*}

List(a) : [Nil Cons(a List(a))].(
  len : List(a) -> Nat
  len([]) -> 0
  len([_ *tail]) -> 1 + len(tail)

  is_empty : List(a) -> Bool
  is_empty([]) -> True
  is_empty([_ *_]) -> False

  append : List(a) a -> List(a)
  append([] value) -> [value]
  append([head *tail] value) -> [head *append(tail value)]

  extend : List(a) List(a) -> List(a)
  extend([] right) -> right
  extend([head *tail] right) -> [head *extend(tail right)]

  prepend : List(a) a -> List(a)
  prepend(values value) -> [value *values]

  map : List(a) (a -> b) -> List(b)
  map([] _) -> []
  map([head *tail] f) -> [f(head) *map(tail f)]

  map2 : List(a) List(b) (a b -> c) -> List(c)
  map2([head *tail] [other *rest] f) -> [f(head other) *map2(tail rest f)]
  map2(_ _ _) -> []

  flat_map : List(a) (a -> List(b)) -> List(b)
  flat_map([] _) -> []
  flat_map([head *tail] f) -> extend(f(head) flat_map(tail f))

  flatten : List(List(a)) -> List(a)
  flatten([]) -> []
  flatten([head *tail]) -> extend(head flatten(tail))

  # The lists with `separator` between neighbours and at neither edge.
  join : List(List(a)) List(a) -> List(a)
  join([] _) -> []
  join([only] _) -> only
  join([head *tail] separator) -> extend(extend(head separator) join(tail separator))

  filter : List(a) (a -> Bool) -> List(a)
  filter([] _) -> []
  filter([head *tail] keep) if keep(head) -> [head *filter(tail keep)]
  filter([_ *tail] keep) -> filter(tail keep)

  count : List(a) (a -> Bool) -> Nat
  count([] _) -> 0
  count([head *tail] keep) if keep(head) -> count(tail keep) + 1
  count([_ *tail] keep) -> count(tail keep)

  any : List(a) (a -> Bool) -> Bool
  any([] _) -> False
  any([head *tail] test) -> test(head) | any(tail test)

  all : List(a) (a -> Bool) -> Bool
  all([] _) -> True
  all([head *tail] test) -> test(head) & all(tail test)

  fold : List(a) b (b a -> b) -> b
  fold([] state _) -> state
  fold([head *tail] state f) -> fold(tail f(state head) f)

  # The fold from the right: `f` takes the element before the state.
  fold_right : List(a) b (a b -> b) -> b
  fold_right([] state _) -> state
  fold_right([head *tail] state f) -> f(head fold_right(tail state f))

  # Every state a left fold passes through, without the seed.
  trail : List(a) b (b a -> b) -> List(b)
  trail([] _ _) -> []
  trail([head *tail] state f) ->
    next = f(state head)
    [next *trail(tail next f)]

  # The same length, and equal elements in order, by the element's own
  # `equals`.
  equals : List(a) List(a) -> Bool where a.equals : a a -> Bool
  equals([] []) -> True
  equals([] [_ *_]) -> False
  equals([_ *_] []) -> False
  equals([x *left] [y *right]) -> x.equals(y) & equals(left right)

  # Whether an element equals `wanted`.
  contains : List(a) a -> Bool where a.equals : a a -> Bool
  contains(values wanted) -> values.any(|value| value == wanted)

  # The elements added up from their type's nought.
  sum : List(a) -> a where
    a.zero : a
    a.add : a a -> a
  sum(values) -> values.fold(a.zero() |total value| total + value)

  reverse : List(a) -> List(a)
  reverse(values) -> reverse_into(values [])

  first : List(a) -> Result(a [Empty])
  first([]) -> Err(Empty)
  first([head *_]) -> Ok(head)

  last : List(a) -> Result(a [Empty])
  last([]) -> Err(Empty)
  last([only]) -> Ok(only)
  last([_ *tail]) -> last(tail)

  # The element at `index`, counting from nought.
  get : List(a) Nat -> Result(a [OutOfBounds])
  get([] _) -> Err(OutOfBounds)
  get([head *_] 0) -> Ok(head)
  get([_ *tail] Succ(index)) -> get(tail index)

  get_or : List(a) Nat a -> a
  get_or(values index fallback) -> get(values index).ok_or(fallback)

  # The list with the element at `index` replaced by `value`.
  set : List(a) Nat a -> Result(List(a) [OutOfBounds])
  set([] _ _) -> Err(OutOfBounds)
  set([_ *tail] 0 value) -> Ok([value *tail])
  set([head *tail] Succ(index) value) -> set(tail index value).map_ok(|rest| [head *rest])

  # The elements exchanged at `i` and `j`, each read before either is
  # written, so a list threaded through here is swapped where it lies.
  exchange : List(a) Nat Nat -> Result(List(a) [OutOfBounds])
  exchange(values i j) ->
    a = get(values i)?
    b = get(values j)?
    Ok(put(put(values i b) j a))

  # `Ok` of every element mapped, where each maps; the first `Err` else.
  try_map : List(a) (a -> Result(b e)) -> Result(List(b) e)
  try_map([] _) -> Ok([])
  try_map([head *tail] f) ->
    converted = f(head)?
    Ok([converted *try_map(tail f)?])

  find : List(a) (a -> Bool) -> Result(a [NotFound])
  find([] _) -> Err(NotFound)
  find([head *_] test) if test(head) -> Ok(head)
  find([_ *tail] test) -> find(tail test)

  find_index : List(a) (a -> Bool) -> Result(Nat [NotFound])
  find_index([] _) -> Err(NotFound)
  find_index([head *_] test) if test(head) -> Ok(0)
  find_index([_ *tail] test) -> find_index(tail test).map_ok(|index| index + 1)

  take : List(a) Nat -> List(a)
  take([head *tail] Succ(count)) -> [head *take(tail count)]
  take(_ _) -> []

  drop : List(a) Nat -> List(a)
  drop(values 0) -> values
  drop([] _) -> []
  drop([_ *tail] Succ(count)) -> drop(tail count)

  take_while : List(a) (a -> Bool) -> List(a)
  take_while([head *tail] keep) if keep(head) -> [head *take_while(tail keep)]
  take_while(_ _) -> []

  drop_while : List(a) (a -> Bool) -> List(a)
  drop_while([head *tail] skip) if skip(head) -> drop_while(tail skip)
  drop_while(values _) -> values

  # `0 1 ... count - 1`, written `List.range(count)`. Built from the end,
  # each element the count that is left: every one is below `count`, which
  # is what a compiler reading the recursion can see.
  range : Nat -> List(Nat)
  range(count) -> range_into(count [])

  # `count` copies of `value`, written `List.repeat(value count)`.
  repeat : a Nat -> List(a)
  repeat(_ 0) -> []
  repeat(value Succ(count)) -> [value *repeat(value count)]
)

reverse_into : List(a) List(a) -> List(a)
reverse_into([] output) -> output
reverse_into([head *tail] output) -> reverse_into(tail [head *output])

# `values` with the element at `index` replaced, unchanged where there is
# none: the store `exchange` makes once its reads have succeeded.
put : List(a) Nat a -> List(a)
put(values index value) -> List.set(values index value).ok_or(values)

range_into : Nat List(Nat) -> List(Nat)
range_into(0 built) -> built
range_into(Succ(left) built) -> range_into(left [left *built])
