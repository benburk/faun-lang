# Result utilities.

import bounds {Equatable, Printable}

export {Result.*}

Result(a, e) : [Ok(a), Err(e)].(
  map_ok : (Result(a, e), a -> b) -> Result(b, e)
  map_ok(Ok(value), f) -> Ok(f(value))
  map_ok(Err(error), _) -> Err(error)

  map_err : (Result(a, e), e -> f) -> Result(a, f)
  map_err(Ok(value), _) -> Ok(value)
  map_err(Err(error), f) -> Err(f(error))

  err_as : (Result(a, e), f) -> Result(a, f)
  err_as(Ok(value), _) -> Ok(value)
  err_as(Err(_), error) -> Err(error)

  and_then : (Result(a, e), a -> Result(b, e)) -> Result(b, e)
  and_then(Ok(value), f) -> f(value)
  and_then(Err(error), _) -> Err(error)

  # The value, or where there is none, what `alternative` makes of the
  # error: the next thing to try, which is tried only where this failed.
  or_else : (Result(a, e), e -> Result(a, f)) -> Result(a, f)
  or_else(Ok(value), _) -> Ok(value)
  or_else(Err(error), alternative) -> alternative(error)

  map2 : (Result(a, e), Result(b, e), (a, b) -> c) -> Result(c, e)
  map2(Ok(a), Ok(b), f) -> Ok(f(a, b))
  map2(Err(error), _, _) -> Err(error)
  map2(_, Err(error), _) -> Err(error)

  is_ok : Result(a, e) -> Bool
  is_ok(Ok(_)) -> True
  is_ok(Err(_)) -> False

  is_err : Result(a, e) -> Bool
  is_err(value) -> is_ok(value).not()

  ok_or : (Result(a, e), a) -> a
  ok_or(Ok(value), _) -> value
  ok_or(Err(_), fallback) -> fallback

  err_or : (Result(a, e), e) -> e
  err_or(Ok(_), fallback) -> fallback
  err_or(Err(error), _) -> error

  # `Ok(value)` or `Err(error)`, each by its own type's `to_str`, as a tag
  # is written: which it was is the first thing it says.
  to_str : Result(a, e) -> Str where
    Printable(a),
    Printable(e)

  # Both `Ok` with equal values, or both `Err` with equal errors, each by
  # its own type's `equals`. A tag row's is structural.
  equals : (Result(a, e), Result(a, e)) -> Bool where
    Equatable(a),
    Equatable(e)
)

expect Ok(1).err_as(Missing) == Ok(1) & Ok(1).err_as(Missing) != Ok(2)
expect Nat.from_str("4").or_else(|_| Nat.from_str("7")) == Ok(4) & Nat.from_str("x").or_else(|_| Nat.from_str("7")) == Ok(7)
expect Nat.from_str("x").or_else(|Malformed| Err(Gone)) == Err(Gone)
expect Err(Missing).map_ok(|n| n + 1) == Err(Missing) & Ok(3).err_as(Missing) != Err(Missing)
expect Nat.from_str("48") == Ok(48) & Nat.from_str("x") == Err(Malformed)
expect Nat.from_str("48").to_str() == "Ok(48)" & Nat.from_str("x").to_str() == "Err(Malformed)"
