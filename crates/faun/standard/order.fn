# The answer of a three-way comparison. A type is ordered by defining one
# `cmp : (T, T) -> Order`, and `<`, `<=`, `>` and `>=` are fixed views of its
# answer, so they cannot disagree about it: exactly one of `Lt`, `Eq`, `Gt`
# holds for any pair.

import hasher {Hasher}

export {Order.*}

Order : [Lt, Eq, Gt].(
  lt : Order -> Bool
  lt(Lt) -> True
  lt(_) -> False

  le : Order -> Bool
  le(Gt) -> False
  le(_) -> True

  gt : Order -> Bool
  gt(Gt) -> True
  gt(_) -> False

  ge : Order -> Bool
  ge(Lt) -> False
  ge(_) -> True

  eq : Order -> Bool
  eq(Eq) -> True
  eq(_) -> False

  ne : Order -> Bool
  ne(Eq) -> False
  ne(_) -> True

  # This order, or where it is `Eq`, the next: how a tuple is ordered
  # position by position. Written `|`, as `a.cmp(b) | c.cmp(d)`.
  or : (Order, Order) -> Order
  or(Eq, next) -> next
  or(decided, _) -> decided

  equals : (Order, Order) -> Bool

  to_str : Order -> Str

  hash_into : (Order, h) -> h where Hasher(h)
)

expect Lt.ne() & !Eq.ne()
expect 1.cmp(2) == Lt & Gt != Eq & Gt.to_str() == "Gt"
