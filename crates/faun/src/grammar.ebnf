(* Faun's grammar, over the lexer's tokens.

   Each choice is made by the next token alone: the grammar is LL(1), and the
   `ebnf` tests check that it is, and that it reads what the parser reads.
   Editors read by its port in `editors/tree-sitter-faun`: change both.

   Terminals are token kinds: quoted, as spelled, or named in capitals. The
   lexer decides what adjacency means, so the grammar never sees a space:
     NEWLINE     the end of a line of items or of a block; a line beginning
                 `if` goes on with the line before where items are written,
                 as a guard, and begins a block's next line
     CALL_PAREN  `(` straight after an operand: a call's, or a type's
   and `.`, `..`, `.*` and `?` are written against what they join. A prefix
   `-` or `!`, a rest's `*`, or a pattern's `==`, touches what it takes, and
   an infix `-`, `*` or `==` has its value before it, spaced or touching on
   both sides alike: `x -3`, `! x`, `[a, * rest]`, `a *b` and `a ==b` are
   refused, so space never chooses between two readings. A line beginning `- ` goes
   on with the line before, as `-` is then infix; one beginning `-3` does
   not.

   Elements are parted by commas, and a sequence may end with one: each
   `xs = x [ "," [ xs ] ]` below is one or more `x`, commas between, and
   perhaps one after.

   A pattern is written as the expression that builds what it matches, so a
   binding and a clause's arguments are expressions here; the parser makes
   each a pattern once its line says it is one. A line is one item whole: a body of
   several lines is a block, and a `where` list's constraints are parted by
   commas. *)

file              = [ line ] { NEWLINE [ line ] } EOF ;

(* A keyword's line, or a name and what follows it. After a type's name,
   and its parameters, `=` names a type; after a value's name, `=` gives
   the value, and after a function's and its patterns, `->` its body. *)
line              = directive
                  | "expect" expr
                  | TYPE [ call ] after-type
                  | ( NAME | EFFECT ) [ call ] ( ":" typed | clause | "=" expr ) ;
after-type        = "=" ( constraints | type )
                  | ":" typed ;
(* A clause's guard and body. *)
clause            = [ "if" expr ] "->" expr ;

directive         = "package" "{" [ dependencies ] "}"
                  | "import" NAME { "." NAME } "{" [ exposures ] "}"
                  | "export" "{" [ exported ] "}" ;
dependencies      = NAME ":" STR_START { STR_TEXT } STR_END [ "," [ dependencies ] ] ;
exposures         = any-name [ ".*" ] [ ":" any-name ] [ "," [ exposures ] ] ;
exported          = any-name [ ".*" ] [ "," [ exported ] ] ;
any-name          = NAME | EFFECT | TYPE ;

(* A signature, a data declaration, or a `where` list's constraint. A
   function type's parameters are the parenthesized types before its arrow,
   or the one type there: `(Nat, Nat) -> Nat`, `Nat -> Nat`. *)
typed             = type [ constraints ] [ methods ] ;
methods           = ".(" [ line ] { NEWLINE [ line ] } ")" ;

(* Constraints are parted by commas, and the last takes none: a comma never
   ends a line, so a list of one to a line is one line. *)
constraints       = "where" constraint { "," constraint } ;
constraint        = TYPE CALL_PAREN types ")"
                  | member-constraint ;
member-constraint = NAME "." ( NAME | EFFECT ) ":" type ;

type              = type-operand [ "->" type-operand ] ;
type-operand      = TYPE [ CALL_PAREN types ")" ]
                  | NAME
                  | "_"
                  | "(" types ")"
                  | "[" [ variants ] "]"
                  | "{" [ field-types ] "}" ;
types             = type [ "," [ types ] ] ;
variants          = TYPE [ CALL_PAREN types ")" ] [ "," [ variants ] ] ;
field-types       = NAME ":" type [ "," [ field-types ] ]
                  | "*" [ "," ] ;

(* Infix operators, loosest first:
     |   ^   &   is   == != < <= > >=   + -   / % *
   each level left-associative. `is` tests the value on its left against
   the pattern its operand spells; the parser refuses one tested again or
   compared, which this grammar does not say. *)
(* An `if` takes everything after its `else`, so it begins an expression
   and is no operand: `1 + (if c then a else b)`. *)
expr              = if-head "then" expr "else" expr
                  | plain ;
plain             = operand expr-tail ;
if-head           = "if" expr ;
expr-tail         = { infix operand } ;
infix             = "|" | "^" | "&" | "is" | "==" | "!=" | "<" | "<=" | ">"
                  | ">=" | "+" | "-" | "/" | "%" | "*" ;
(* `==name` is a pattern's: a value equal to the name. *)
operand           = prefix operand
                  | "==" NAME
                  | primary { postfix } ;
prefix            = "-" | "!" ;
postfix           = call
                  | "?"
                  | "." ( NAME | EFFECT | TYPE ) ;
call              = CALL_PAREN [ arguments ] ")" ;
arguments         = argument [ "," [ arguments ] ] ;
argument          = "|" operands "|" expr
                  | expr ;
operands          = operand [ "," [ operands ] ] ;

primary           = TYPE
                  | ( NUMBER | CHAR ) [ ".." range-end ]
                  | DECIMAL
                  | "_" [ ".." range-end ]
                  | NAME
                  | EFFECT
                  | STR_START { STR_TEXT | SPLICE_START expr [ width ] SPLICE_END } STR_END
                  | "(" parenthesized ")"
                  | "[" [ elements ] "]"
                  | "{" [ fields ] "}" ;
exprs             = expr [ "," [ exprs ] ] ;

(* A parenthesis holds lines; after its first, the next token says which:
   `,` a tuple, `if`, `then` or a leave arms, a line's end a block's next
   line, and `)` one value grouped, where the line is one. That a tuple's
   member and an arm's pattern are values is told after parsing. *)
parenthesized     = block-line [ "," [ exprs ] | arm-tail { NEWLINE arm } | NEWLINE lines ] ;
(* Arms a line apiece, which an `is` takes: `x is (P then a` … `)`. An
   arm's guard is a condition, so its value follows `then`, or it leaves
   as an `if` line does. Arms no `is` takes are refused after parsing, and
   so is an arm leaving where its `is` is not a line's value or a body's
   answer. *)
arm               = expr arm-tail ;
arm-tail          = [ "if" expr ] ( "then" expr | leave ) ;
(* A block's lines: bindings, leaving lines and values. A line beginning
   `if` is the ternary, or, where a leave follows its condition, a line
   leaving where the condition holds; a ternary beginning a line takes no
   `=` and no `else`, which `(if a then b else c) else return x` puts in
   parentheses. A block answers its last line where that is a value, and
   `{}` where it is a binding or a leaving line; that is told after
   parsing. *)
lines             = block-line { NEWLINE block-line } ;
block-line        = if-head ( "then" expr "else" expr | leave )
                  | plain [ line-tail ] ;
(* A binding, or a line going on where its condition holds and leaving by
   its `else` where it fails. *)
line-tail         = "=" expr | "else" leave ;
(* The only ways a body leaves: `return`'s value is any expression, a
   block among them. *)
leave             = "return" expr ;
(* A list's rest may have elements after it, which its end matches:
   `[*front, last]`. *)
elements          = expr [ "," [ elements ] ]
                  | rest [ "," [ exprs ] ] ;
(* A field may be a path, given its value, `{a.b: e, *base}`, replacing a
   field of a field; a path in a record with no base is refused later. *)
fields            = field [ "," [ fields ] ]
                  | rest [ "," ] ;
field             = NAME ( "." NAME { "." NAME } ":" expr | [ ":" expr ] ) ;
rest              = "*" [ expr ] ;

(* A range's end may be negated, or `_` to leave that side open. Its start
   is negated as an operand is, `-3..5`, and the parser holds the `-` to it. *)
range-end         = NUMBER | CHAR | "_" | "-" ( NUMBER | CHAR ) ;
width             = ":" ( "<" | ">" ) NUMBER ;
