(* Faun's grammar, over the lexer's tokens.

   Each choice is made by the next token alone: the grammar is LL(1), and the
   `ebnf` tests check that it is, and that it reads what the parser reads.

   Terminals are token kinds: quoted, as spelled, or named in capitals. The
   lexer decides what adjacency means, so the grammar never sees a space:
     NEWLINE     the end of a line of items or of a body
     CALL_PAREN  `(` straight after an operand: a call's, or a type's
   and `.`, `..`, `.*` and `?` are written against what they join.

   Elements are parted by commas, and a sequence may end with one: each
   `xs = x [ "," [ xs ] ]` below is one or more `x`, commas between, and
   perhaps one after.

   A pattern is written as the expression that builds what it matches, so a
   binding's or a clause's head is an expression here; the parser makes it a
   pattern once its line says it is one, and groups lines into items. *)

file              = [ line ] { NEWLINE [ line ] } EOF ;

(* A keyword's line, or an expression and what follows it. After a type's
   name alone, `=` names a type. *)
line              = directive
                  | "expect" statement
                  | TYPE after-type
                  | untyped-operand expr-tail [ trailer ] ;
after-type        = "=" ( constraints | type )
                  | ":" typed
                  | clause
                  | postfix { postfix } expr-tail [ trailer ]
                  | infix operand expr-tail [ trailer ]
                  | (* the name alone *) ;
trailer           = "=" ( constraints | expr )
                  | ":" typed
                  | clause ;
clause            = [ "if" expr ] "->" statement ;
statement         = expr [ "=" expr ] ;

directive         = "package" "{" [ dependencies ] "}"
                  | "import" NAME { "." NAME } "{" [ exposures ] "}"
                  | "export" "{" [ exported ] "}" ;
dependencies      = NAME ":" STR_START { STR_TEXT } STR_END [ "," [ dependencies ] ] ;
exposures         = any-name [ ".*" ] [ ":" any-name ] [ "," [ exposures ] ] ;
exported          = any-name [ ".*" ] [ "," [ exported ] ] ;
any-name          = NAME | EFFECT | TYPE ;

(* A signature, a data declaration, or a `where` list's constraint. A
   function type's parameters are the parenthesized types before its arrow,
   or the one type there: `(Nat, Nat) -> Nat`, `Nat -> Nat`. *)
typed             = type [ constraints ] [ methods ] ;
methods           = ".(" [ line ] { NEWLINE [ line ] } ")" ;

(* A member's constraint ends its line; more follow on lines of their own. *)
constraints       = "where" constraint-list ;
constraint-list   = TYPE CALL_PAREN types ")" [ "," [ constraint-list ] ]
                  | member-constraint ;
member-constraint = NAME "." ( NAME | EFFECT ) ":" type ;

type              = type-operand [ "->" type-operand ] ;
type-operand      = TYPE [ CALL_PAREN types ")" ]
                  | NAME
                  | "_"
                  | "(" types ")"
                  | "[" [ variants ] "]"
                  | "{" [ field-types ] "}" ;
types             = type [ "," [ types ] ] ;
variants          = TYPE [ CALL_PAREN types ")" ] [ "," [ variants ] ] ;
field-types       = NAME ":" type [ "," [ field-types ] ]
                  | "*" [ "," ] ;

(* Infix operators, loosest first:
     |   ^   &   == != < <= > >=   + -   / % *
   each level left-associative. *)
expr              = operand expr-tail ;
expr-tail         = { infix operand } ;
infix             = "|" | "^" | "&" | "==" | "!=" | "<" | "<=" | ">" | ">="
                  | "+" | "-" | "/" | "%" | "*" ;
operand           = prefix operand
                  | primary { postfix } ;
untyped-operand   = prefix operand
                  | untyped-primary { postfix } ;
prefix            = "-" | "!" ;
postfix           = CALL_PAREN [ arguments ] ")"
                  | "?"
                  | "." ( NAME | EFFECT | TYPE ) ;
arguments         = argument [ "," [ arguments ] ] ;
argument          = "|" operands "|" expr
                  | expr ;
operands          = operand [ "," [ operands ] ] ;

primary           = TYPE | untyped-primary ;
untyped-primary   = ( NUMBER | CHAR ) [ ".." range-end ]
                  | DECIMAL
                  | "_" [ ".." range-end ]
                  | NAME
                  | EFFECT
                  | STR_START { STR_TEXT | SPLICE_START expr [ width ] SPLICE_END } STR_END
                  | "(" exprs ")"
                  | "[" [ elements ] "]"
                  | "{" [ fields ] "}" ;
exprs             = expr [ "," [ exprs ] ] ;
elements          = expr [ "," [ elements ] ]
                  | rest ;
fields            = NAME [ ":" expr ] [ "," [ fields ] ]
                  | rest ;
rest              = "*" [ expr ] [ "," ] ;

(* A range's end may be negated, or `_` to leave that side open. Its start
   is negated as an operand is, `-3..5`, and the parser holds the `-` to it. *)
range-end         = NUMBER | CHAR | "_" | "-" ( NUMBER | CHAR ) ;
width             = ":" ( "<" | ">" | "^" ) NUMBER ;
