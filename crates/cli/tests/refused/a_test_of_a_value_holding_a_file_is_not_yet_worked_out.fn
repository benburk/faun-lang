import std.host {Host, Files, IoError, Mode.*}

main! : Host -> []
main!(host) -> (
  ran = program!(host.files)
  host.exit!(0)
)

program! : Files -> Result(Nat, IoError)
program!(files) -> (
  opened = files.open!("a.txt", Read)
  closed = if opened is Ok(file) then file.close!() else Ok({})
  Ok(0)
)
