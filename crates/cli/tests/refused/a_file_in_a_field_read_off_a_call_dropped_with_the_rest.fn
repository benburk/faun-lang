import std.host {Host, File, Files, Mode.*}

main! : Host -> []
main!(host) -> host.exit!(0)

swapped : {a: File, b: File} -> {a: File, b: File}
swapped({a, b}) -> {a: b, b: a}

# What `swapped` answers is named by nothing, so the file in its field `b`
# goes with it.
program! : {a: File, b: File} -> Nat
program!(pair) -> (
  closed = swapped(pair).a.close!()
  0
)
