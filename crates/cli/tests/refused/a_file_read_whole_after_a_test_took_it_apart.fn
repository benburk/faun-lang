import std.host {Host, Files, Mode.*}

main! : Host -> []
main!(host) -> (
  ran = program!(host.files)
  host.exit!(0)
)

program! : Files -> Nat
program!(files) -> (
  opened = files.open!("a.tmp", Overwrite)
  if opened is Ok(file) then (
    closed = file.close!()
    again = if opened is Ok(other) then other.close!() else Ok({})
    1
  ) else 0
)
