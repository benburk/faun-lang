import std.host {Host}

# Each alias names the last twice, so the last is a type of 2^20 parts.
A0 = Nat
A1 = (A0, A0)
A2 = (A1, A1)
A3 = (A2, A2)
A4 = (A3, A3)
A5 = (A4, A4)
A6 = (A5, A5)
A7 = (A6, A6)
A8 = (A7, A7)
A9 = (A8, A8)
A10 = (A9, A9)
A11 = (A10, A10)
A12 = (A11, A11)
A13 = (A12, A12)
A14 = (A13, A13)
A15 = (A14, A14)
A16 = (A15, A15)
A17 = (A16, A16)
A18 = (A17, A17)
A19 = (A18, A18)
A20 = (A19, A19)

main! : Host -> []
main!(host) -> host.exit!(0)
