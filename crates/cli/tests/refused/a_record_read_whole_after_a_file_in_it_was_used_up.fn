import std.host {Host, File, Files, Mode.*}

main! : Host -> []
main!(host) -> host.exit!(0)

program! : {a: File, b: File} -> Nat
program!(pair) -> (
  closed = pair.a.close!()
  close_both!(pair)
)

close_both! : {a: File, b: File} -> Nat
close_both!({a, b}) -> (
  first = a.close!()
  second = b.close!()
  0
)
