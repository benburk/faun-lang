import std.host {Host, Files, Mode.*}

main! : Host -> []
main!(host) -> (
  ran = program!(host.files, ["a.tmp"])
  host.exit!(0)
)

program! : (Files, List(Str)) -> Nat
program!(files, names) -> (
  kept = []
  for name in names do (
    files.open!(name, Overwrite) is Ok(file) else continue
    kept = [file]
  )
  for file in kept do (
    closed = file.close!()
  )
  0
)
