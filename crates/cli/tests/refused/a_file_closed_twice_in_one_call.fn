import std.host {Host}

import std.host {Files, File, IoError, Mode.*}

    main! : Host -> []
    main!(host) ->
      ran = program!(host.files)
      host.exit!(0)

    program! : Files -> Result(Nat, IoError)
program!(files) ->
  file = files.open!("a.txt", Read)?
  closed = both!(file, file)
  Ok(0)

both! : (File, File) -> Nat
both!(a, b) ->
  x = a.close!()
  y = b.close!()
  0
