import std.host {Host, Files, Mode.*}

main! : Host -> []
main!(host) -> (
  ran = program!(host.files, ["a.tmp"])
  host.exit!(0)
)

program! : (Files, List(Str)) -> Nat
program!(files, names) -> (
  files.open!("a.tmp", Overwrite) is Ok(file) else return 0
  for name in names do (
    closed = file.close!()
  )
  0
)
