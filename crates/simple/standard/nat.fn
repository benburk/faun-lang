# Naturals are unbounded. Constructor order is not a representation.
type Nat Zero Succ(Nat)
type Bool False True

add(a Zero) -> a
add(a Succ(b)) -> Succ(add(a b))

sub(Zero b) -> Zero
sub(Succ(a) Zero) -> Succ(a)
sub(Succ(a) Succ(b)) -> sub(a b)

mul(a Zero) -> Zero
mul(a Succ(b)) -> add(a mul(a b))

equals(Zero Zero) -> True
equals(Zero Succ(b)) -> False
equals(Succ(a) Zero) -> False
equals(Succ(a) Succ(b)) -> equals(a b)

less_than(Zero Zero) -> False
less_than(Zero Succ(b)) -> True
less_than(Succ(a) Zero) -> False
less_than(Succ(a) Succ(b)) -> less_than(a b)

# Primitive recursion on the dividend keeps termination structural.
# The helpers choose whether the next step completes another divisor.
mod(a Zero) -> a
mod(Zero Succ(b)) -> Zero
mod(Succ(a) Succ(b)) ->
  r = mod(a Succ(b))
  mod_step(equals(r b) r)
mod_step(True r) -> Zero
mod_step(False r) -> Succ(r)

div(a Zero) -> Zero
div(Zero Succ(b)) -> Zero
div(Succ(a) Succ(b)) ->
  q = div(a Succ(b))
  div_step(equals(mod(a Succ(b)) b) q)
div_step(True q) -> Succ(q)
div_step(False q) -> q
