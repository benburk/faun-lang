# Prepend nat.fn. Pos(n) = n; NegSucc(n) = -(n + 1).
# Zero has exactly one representation: Pos(Zero).
type Int Pos(Nat) NegSucc(Nat)
type IntNatConversion IntNegative IntNatural(Nat)

int_zero() -> Pos(Zero)
int_from_nat(n) -> Pos(n)
int_to_nat_checked(Pos(n)) -> IntNatural(n)
int_to_nat_checked(NegSucc(n)) -> IntNegative

int_abs(Pos(n)) -> n
int_abs(NegSucc(n)) -> Succ(n)
int_is_negative(Pos(n)) -> False
int_is_negative(NegSucc(n)) -> True

# Negate a natural, including canonical zero.
int_negative_nat(Zero) -> Pos(Zero)
int_negative_nat(Succ(n)) -> NegSucc(n)
int_negate(Pos(n)) -> int_negative_nat(n)
int_negate(NegSucc(n)) -> Pos(Succ(n))

# The signed difference of two naturals, without truncating the sign.
int_difference(a b) -> int_difference_step(less_than(a b) a b)
int_difference_step(False a b) -> Pos(sub(a b))
int_difference_step(True a b) -> int_negative_nat(sub(b a))

int_add(Pos(a) Pos(b)) -> Pos(add(a b))
int_add(Pos(a) NegSucc(b)) -> int_difference(a Succ(b))
int_add(NegSucc(a) Pos(b)) -> int_difference(b Succ(a))
int_add(NegSucc(a) NegSucc(b)) -> NegSucc(Succ(add(a b)))

int_sub(a b) -> int_add(a int_negate(b))

int_mul(Pos(a) Pos(b)) -> Pos(mul(a b))
int_mul(Pos(a) NegSucc(b)) -> int_negative_nat(mul(a Succ(b)))
int_mul(NegSucc(a) Pos(b)) -> int_negative_nat(mul(Succ(a) b))
int_mul(NegSucc(a) NegSucc(b)) -> Pos(mul(Succ(a) Succ(b)))

int_equals(Pos(a) Pos(b)) -> equals(a b)
int_equals(Pos(a) NegSucc(b)) -> False
int_equals(NegSucc(a) Pos(b)) -> False
int_equals(NegSucc(a) NegSucc(b)) -> equals(a b)

int_less_than(Pos(a) Pos(b)) -> less_than(a b)
int_less_than(Pos(a) NegSucc(b)) -> False
int_less_than(NegSucc(a) Pos(b)) -> True
int_less_than(NegSucc(a) NegSucc(b)) -> less_than(b a)

# Signed division/remainder deliberately not defined yet.
