# What inflate and deflate share: the symbols DEFLATE codes lengths and
# distances with, from RFC 1951's tables, and the fixed code's lengths.

export {length_table, distance_table, fixed_literal_lengths, first_codes, reversed}

# For each length symbol from 257, its base length times 16 plus how many
# extra bits follow it.
length_table : List(U32)
length_table = [
  3 * 16, 4 * 16, 5 * 16, 6 * 16, 7 * 16, 8 * 16, 9 * 16, 10 * 16,
  11 * 16 + 1, 13 * 16 + 1, 15 * 16 + 1, 17 * 16 + 1,
  19 * 16 + 2, 23 * 16 + 2, 27 * 16 + 2, 31 * 16 + 2,
  35 * 16 + 3, 43 * 16 + 3, 51 * 16 + 3, 59 * 16 + 3,
  67 * 16 + 4, 83 * 16 + 4, 99 * 16 + 4, 115 * 16 + 4,
  131 * 16 + 5, 163 * 16 + 5, 195 * 16 + 5, 227 * 16 + 5,
  258 * 16,
]

# For each distance symbol, its base distance times 16 plus its extra bits.
distance_table : List(U32)
distance_table = List.range(30).map(distance_entry)

# Distances come in pairs per number of extra bits, from 1, 2, 3 and 4
# with none, each pair's base past the last's span.
distance_entry : Nat -> U32
distance_entry(symbol) if symbol < 4 -> U32.of_nat((symbol + 1) * 16)
distance_entry(symbol) -> (
  extra = symbol / 2 - 1
  base = 2.pow(extra + 1) + (symbol % 2) * 2.pow(extra) + 1
  U32.of_nat(base * 16 + extra)
)

# The lengths of the fixed literal and length code.
fixed_literal_lengths : List(Nat)
fixed_literal_lengths =
  List.repeat(8, 144).concat(List.repeat(9, 112)).concat(List.repeat(7, 24)).concat(List.repeat(8, 8))

# Each length's first code, as RFC 1951 counts them out.
first_codes : (List(Nat), Nat, Nat, List(Nat)) -> List(Nat)
first_codes(_, 16, _, firsts) -> firsts
first_codes(counts, length, code, firsts) -> (
  next = (code + counts.get(length - 1).ok_or(0) * (length > 1).select(1, 0)) * 2
  first_codes(counts, length + 1, next, firsts.append(next))
)

# The low `length` bits of `code` in the other order, after `done`.
reversed : (Nat, Nat, Nat) -> Nat
reversed(_, 0, done) -> done
reversed(code, Succ(left), done) -> reversed(code / 2, left, done * 2 + code % 2)
