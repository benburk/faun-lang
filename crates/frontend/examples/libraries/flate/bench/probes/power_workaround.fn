# The same with `2.pow(k)` worked out once, before the walk.
package {}

import std.host {Host}

walk : (Nat, Nat, Nat, Nat) -> Nat
walk(0, _, _, sum) -> sum
walk(Succ(left), x, size, sum) -> walk(left, (x * 5 + 1) % 16777216, size, sum + x % size)

main! : Host -> []
main!(host) -> (
  k = host.args.len() + 9
  printed = host.println!("${walk(10000000, 1, 2.pow(k), 0)}")
  host.exit!(0)
)
