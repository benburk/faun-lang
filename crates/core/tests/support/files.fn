# Every way a file is opened, beneath where the program runs: one read, one
# made or written over, one written after its end, and one made new, which is
# there the second time it is asked for, and a name reaching above refused,
# as is one longer than any target reads.
# Each file opened is the program's to close, and is closed. Nothing to read
# is status two.

import std.host {Files, File, Chunk, IoError, Host, Mode.*}

main! : Host -> []
main!(host) ->
  copied = copy!(host.files)
  host.exit!(U8.of_nat(copied.ok_or(2)))

copy! : Files -> Result(Nat, IoError)
copy!(files) ->
  source = files.open!("input.txt", Read)?
  reading = source.read!(64)
  closing = source.close!()
  chunk = reading?
  closed = closing?
  bytes = held(chunk)
  target = files.open!("output.txt", Overwrite)?
  wrote = write_and_close!(target, bytes)?
  after = files.open!("output.txt", Append)?
  added = write_and_close!(after, "+tail".to_utf8())?
  made = files.open!("created.txt", CreateNew)?
  shut = made.close!()?
  again = files.open!("created.txt", CreateNew)
  above = files.open!("../outside.txt", Read)
  long = files.open!(twice(twice(twice(twice("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")))), Read)
  refused!(again, above, long)

# What a read held: nothing, once the file has ended.
held : Chunk -> List(U8)
held(Data(bytes)) -> bytes
held(End) -> []

# Twice as long, for a name longer than a literal is.
twice : Str -> Str
twice(text) -> text.concat(text)

write_and_close! : (File, List(U8)) -> Result(Nat, IoError)
write_and_close!(file, bytes) ->
  writing = file.write_all!(bytes)
  closing = file.close!()
  count = writing?
  done = closing?
  Ok(count)

refused! : (Result(File, IoError), Result(File, IoError), Result(File, IoError)) -> Result(Nat, IoError)
refused!(Err(_), Err(_), Err(_)) -> Ok(0)
refused!(again, above, long) ->
  a = shut!(again)
  b = shut!(above)
  c = shut!(long)
  Ok(3)

# Close a file opened where none should have been.
shut! : Result(File, IoError) -> Nat
shut!(Ok(file)) ->
  closing = file.close!()
  1
shut!(Err(_)) -> 0
