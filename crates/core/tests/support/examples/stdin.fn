# All of standard input, written back to standard output and to standard
# error, exiting with four more than how many bytes it was.

import std.host {Host}

main! : Host -> []
main!(host) -> (
  read = host.stdin.read_to_end!()
  input = read.ok_or([])
  echoed = host.stdout.write_all!(input)
  told = host.stderr.write_all!(input)
  host.exit!(U8.of_nat(input.len() + 4))
)
