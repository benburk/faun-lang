# All of standard input, written back to standard output and to standard
# error, exiting with four more than how many bytes it was.

import std.host {Host}

main! : Host -> []
main!(host) ->
  input = host.stdin!()
  echoed = host.stdout!(input)
  told = host.stderr!(input)
  host.exit!((input.len() + 4) % 256)
