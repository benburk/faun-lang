# Signed integers use the same canonical representation as Ori: Pos(n) is n,
# and NegSucc(n) is -(n + 1).

exports {Int.*}

Int : [Pos(Nat) NegSucc(Nat)].(
  of_nat : Nat -> Int
  of_nat(n) -> Pos(n)

  neg : Int -> Int
  neg(Pos(0)) -> Pos(0)
  neg(Pos(Succ(m))) -> NegSucc(m)
  neg(NegSucc(m)) -> Pos(Succ(m))
)
