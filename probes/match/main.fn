# How many bytes from two places agree, up to 258, as deflate's match search
# compares them, positions naturals; asked at every position of `n` bytes of
# text against the place 64 bytes back.
package {}

import std.host {Host}

byte_at : (List(U8), Nat) -> U8
byte_at(input, at) -> input.get(at).ok_or(0)

matching : (List(U8), Nat, Nat, Nat, Nat) -> Nat
matching(input, a, b, count, most) if count < most & byte_at(input, a + count) == byte_at(input, b + count) ->
  matching(input, a, b, count + 1, most)
matching(_, _, _, count, _) -> count

walk : (List(U8), Nat, Nat) -> Nat
walk(input, at, total) -> (
  if at + 258 >= input.len() return total
  walk(input, at + 1, total + matching(input, at - 64, at, 0, 258))
)

main! : Host -> []
main!(host) -> (
  n = Nat.from_str(host.args.get(1).ok_or("1000")).ok_or(1000)
  input = List.range(n).map(|i| U8.of_nat(i % 64 + i / 256 % 2))
  printed = host.println!("${walk(input, 64, 0)}")
  host.exit!(0)
)
