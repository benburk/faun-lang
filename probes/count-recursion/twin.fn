# The multiples of 3 or 5 below `n`, added up: a recursion carrying the
# count and the sum. The family's twin.
package {}

import std.host {Host}

total : (Nat, Nat, Nat) -> Nat
total(i, n, sum) -> (
  if i >= n return sum
  total(i + 1, n, if i % 3 == 0 | i % 5 == 0 then sum + i else sum)
)

main! : Host -> []
main!(host) -> (
  n = Nat.from_str(host.args.get(1).ok_or("1000")).ok_or(1000)
  printed = host.println!("${total(0, n, 0)}")
  host.exit!(0)
)
