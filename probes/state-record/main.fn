# The `n`th Fibonacci number modulo 1000003: its two last values handed on
# as a record.
package {}

import std.host {Host}

fib : (Nat, {a: Nat, b: Nat}) -> Nat
fib(0, {a, *}) -> a
fib(k, {a, b}) -> fib(k - 1, {a: b, b: (a + b) % 1000003})

main! : Host -> []
main!(host) -> (
  n = Nat.from_str(host.args.get(1).ok_or("1000")).ok_or(1000)
  printed = host.println!("${fib(n, {a: 0, b: 1})}")
  host.exit!(0)
)
