# The dot product of two lists of `n` numbers: a recursion taking the
# first of each apart. The family's twin.
package {}

import std.host {Host}

dot : (List(Nat), List(Nat)) -> Nat
dot(xs, ys) -> summed(xs, ys, 0)

summed : (List(Nat), List(Nat), Nat) -> Nat
summed([x, *xs], [y, *ys], sum) -> summed(xs, ys, sum + x * y)
summed(_, _, sum) -> sum

main! : Host -> []
main!(host) -> (
  n = Nat.from_str(host.args.get(1).ok_or("1000")).ok_or(1000)
  xs = List.range(n).map(|i| i * 7919 % 251)
  ys = List.range(n).map(|i| i * 31 % 97)
  printed = host.println!("${dot(xs, ys)}")
  host.exit!(0)
)
