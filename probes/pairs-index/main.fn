# The dot product of two lists of `n` numbers: a fold over the indices,
# reading both lists at each.
package {}

import std.host {Host}

dot : (List(Nat), List(Nat)) -> Nat
dot(xs, ys) -> List.range(xs.len()).fold(0, |sum, i| sum + xs.get(i).ok_or(0) * ys.get(i).ok_or(0))

main! : Host -> []
main!(host) -> (
  n = Nat.from_str(host.args.get(1).ok_or("1000")).ok_or(1000)
  xs = List.range(n).map(|i| i * 7919 % 251)
  ys = List.range(n).map(|i| i * 31 % 97)
  printed = host.println!("${dot(xs, ys)}")
  host.exit!(0)
)
