# The little-endian 32-bit words of `4 * n` bytes, added up: counting words
# while `w < len / 4`, each at `w * 4`.
package {}

import std.host {Host}

byte : (List(U8), Nat) -> Nat
byte(input, at) -> input.get(at).ok_or(0).to_nat()

word : (List(U8), Nat) -> Nat
word(input, at) -> byte(input, at) + byte(input, at + 1) * 256 + byte(input, at + 2) * 65536 + byte(input, at + 3) * 16777216

walk : (List(U8), Nat, Nat) -> Nat
walk(input, w, sum) if w < input.len() / 4 -> walk(input, w + 1, sum + word(input, w * 4))
walk(_, _, sum) -> sum

main! : Host -> []
main!(host) -> (
  n = Nat.from_str(host.args.get(1).ok_or("1000")).ok_or(1000)
  input = List.range(4 * n).map(|i| U8.of_nat(i * 7919 % 251))
  printed = host.println!("${walk(input, 0, 0)}")
  host.exit!(0)
)
