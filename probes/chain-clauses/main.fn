# `n` readings, each two steps that may fail, added up with 1 for a failed one:
# a clause for each step's outcome.
package {}

import std.host {Host}

Fault = [Unreadable, TooLarge]

# The last digit of `i`, unreadable at every multiple of 11.
digit : Nat -> Result(Nat, Fault)
digit(i) -> if i % 11 == 0 then Err(Unreadable) else Ok(i % 10)

# A digit scaled, too large where it is 7.
scaled : Nat -> Result(Nat, Fault)
scaled(7) -> Err(TooLarge)
scaled(d) -> Ok(d * 3 + 1)

reading : Nat -> Result(Nat, Fault)
reading(i) -> added(digit(i))

# A digit's reading: it scaled, and added to that, where both are read.
added : Result(Nat, Fault) -> Result(Nat, Fault)
added(Ok(d)) -> plus(d, scaled(d))
added(Err(fault)) -> Err(fault)

plus : (Nat, Result(Nat, Fault)) -> Result(Nat, Fault)
plus(d, Ok(s)) -> Ok(d + s)
plus(_, Err(fault)) -> Err(fault)

main! : Host -> []
main!(host) -> (
  n = Nat.from_str(host.args.get(1).ok_or("1000")).ok_or(1000)
  total = List.range(n).fold(0, |sum, i| sum + reading(i).ok_or(1))
  printed = host.println!("${total}")
  host.exit!(0)
)
