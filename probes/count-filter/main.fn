# The multiples of 3 or 5 below `n`, added up: the range filtered, then
# summed.
package {}

import std.host {Host}

total : Nat -> Nat
total(n) -> List.range(n).filter(|i| i % 3 == 0 | i % 5 == 0).sum()

main! : Host -> []
main!(host) -> (
  n = Nat.from_str(host.args.get(1).ok_or("1000")).ok_or(1000)
  printed = host.println!("${total(n)}")
  host.exit!(0)
)
