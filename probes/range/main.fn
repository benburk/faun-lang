# Four bytes a pixel for each of `n` columns of `n` rows, written through
# `List.range(n).fold`, as png.fn reads a row's pixels.
package {}

import std.host {Host}

pixels : (Nat, Nat) -> List(U8)
pixels(width, height) -> List.range(height).fold([], |out, y| List.range(width).fold(out, |out, x| (
  level = U8.of_nat(x + y)
  out.append(level).append(level).append(level).append(255)
)))

main! : Host -> []
main!(host) -> (
  n = Nat.from_str(host.args.get(1).ok_or("100")).ok_or(100)
  out = pixels(n, n)
  printed = host.println!("${out.len()} ${out.fold(0, |sum, byte| sum + byte.to_nat())}")
  host.exit!(0)
)
