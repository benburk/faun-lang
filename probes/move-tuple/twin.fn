# A walker on a 1000 by 1000 torus, `n` steps: at step `i` it turns by
# `(i * i + i / 7) % 3` quarters, then goes on a square east, north, west
# or south:
# each step builds the record anew, naming every field. The family's twin.
package {}

import std.host {Host}

Walker = {x: Nat, y: Nat, heading: Nat, steps: Nat}

step : (Walker, Nat) -> Walker
step(w, i) -> (
  heading = (w.heading + (i * i + i / 7) % 3) % 4
  if heading == 0 then {x: (w.x + 1) % 1000, y: w.y, heading: heading, steps: w.steps + 1}
  else if heading == 1 then {x: w.x, y: (w.y + 1) % 1000, heading: heading, steps: w.steps + 1}
  else if heading == 2 then {x: (w.x + 999) % 1000, y: w.y, heading: heading, steps: w.steps + 1}
  else {x: w.x, y: (w.y + 999) % 1000, heading: heading, steps: w.steps + 1}
)

main! : Host -> []
main!(host) -> (
  n = Nat.from_str(host.args.get(1).ok_or("1000")).ok_or(1000)
  w = List.range(n).fold({x: 0, y: 0, heading: 0, steps: 0}, step)
  printed = host.println!("${w.x} ${w.y} ${w.heading} ${w.steps}")
  host.exit!(0)
)
