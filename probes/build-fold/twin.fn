# A list of `i * i % 1000` for each `i` below `n`, its length and sum
# printed: a recursion appending to what it built. The family's twin.
package {}

import std.host {Host}

built : (Nat, Nat, List(Nat)) -> List(Nat)
built(i, n, out) -> (
  if i >= n return out
  built(i + 1, n, out.append(i * i % 1000))
)

main! : Host -> []
main!(host) -> (
  n = Nat.from_str(host.args.get(1).ok_or("1000")).ok_or(1000)
  out = built(0, n, [])
  printed = host.println!("${out.len()} ${out.sum()}")
  host.exit!(0)
)
