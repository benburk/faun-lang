# The multiples of 3 or 5 below `n`, added up: the recursion with its count
# and sum `U64`, a counter known to fit a word.
package {}

import std.host {Host}

total : (U64, U64, U64) -> U64
total(i, n, sum) -> (
  if i >= n return sum
  total(i + 1, n, if i % 3 == 0 | i % 5 == 0 then sum + i else sum)
)

main! : Host -> []
main!(host) -> (
  n = Nat.from_str(host.args.get(1).ok_or("1000")).ok_or(1000)
  printed = host.println!("${total(U64.of_nat(0), U64.of_nat(n), U64.of_nat(0))}")
  host.exit!(0)
)
