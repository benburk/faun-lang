+++ b/src/sim65/memory.c
@@ -48,6 +48,10 @@
 /* THE memory */
 static unsigned char Mem[0x10000];
 
+/* Each address the program has written since MemCountWrites */
+static unsigned char Written[0x10000];
+static unsigned char Counting;
+
 
 
 /*****************************************************************************/
@@ -60,6 +64,7 @@
 /* Write a byte to a memory location */
 {
     Mem[Addr] = Val;
+    Written[Addr & 0xFFFF] = Counting;
 }
 
 
@@ -101,6 +106,26 @@
 }
 
 
+
+void MemCountWrites (void)
+/* Count the bytes written from here on: what is loaded before is the image */
+{
+    Counting = 1;
+}
+
+
+
+unsigned MemWritten (void)
+/* Return how many different addresses were written since MemCountWrites */
+{
+    unsigned Addr, Count = 0;
+    for (Addr = 0; Addr < sizeof (Written); ++Addr) {
+        Count += Written[Addr];
+    }
+    return Count;
+}
+
+
 
 void MemInit (void)
 /* Initialize the memory subsystem */
